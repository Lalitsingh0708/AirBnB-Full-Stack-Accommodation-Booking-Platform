<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Email | StayNest</title>
    <meta name="description" content="Verify your StayNest account with the one-time code sent to your email." />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,500&display=swap" rel="stylesheet" />

    <style>
        :root {
            --cream-bg: #FAF8F5;
            --emerald-dark: #081B13;
            --emerald-mid: #103425;
            --emerald-grad-start: #164e39;
            --emerald-grad-mid: #226b4e;
            --emerald-grad-end: #17523c;
            --gold-accent: #D4AF6A;
            --gold-light: #EBD6A7;
            --text-dark: #0A140F;
            --text-body: #1E2B24;
            --text-muted: #526058;
            --border-light: #DDD6C8;
            --radius-card: 24px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--cream-bg);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            -webkit-font-smoothing: antialiased;
        }

        /* ─── Top Brand Navbar ─── */
        .otp-top-bar {
            position: absolute;
            top: 28px;
            left: 36px;
        }

        .brand-link {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--emerald-dark);
        }

        .brand-name {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: var(--emerald-dark);
        }

        .brand-name-accent {
            color: var(--gold-accent);
        }

        /* ─── Luxury Verification Card ─── */
        .otp-card {
            width: 100%;
            max-width: 480px;
            background: #FFFFFF;
            border-radius: var(--radius-card);
            border: 1.5px solid var(--border-light);
            padding: 44px 38px;
            box-shadow: 0 16px 40px rgba(16, 52, 37, 0.08), 0 2px 6px rgba(0, 0, 0, 0.02);
            text-align: center;
            position: relative;
            animation: cardAppear 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(14px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .otp-icon-wrap {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg, #F4F8F5 0%, #EBF4EE 100%);
            border: 2px solid var(--gold-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px auto;
            color: var(--emerald-mid);
            box-shadow: 0 6px 18px rgba(212, 175, 106, 0.22);
        }

        .otp-title {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
            font-weight: 700;
            color: var(--emerald-dark);
            margin-bottom: 10px;
            letter-spacing: -0.4px;
        }

        .otp-desc {
            font-size: 14.5px;
            color: var(--text-muted);
            line-height: 1.55;
            margin-bottom: 28px;
        }

        .user-email-badge {
            display: inline-block;
            font-weight: 700;
            color: var(--emerald-mid);
            background: #F4F8F5;
            border: 1px solid #D6E6DB;
            padding: 3px 10px;
            border-radius: 6px;
            word-break: break-all;
        }

        /* ─── 6-Digit Inputs Grid ─── */
        .digit-inputs-row {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 26px;
        }

        .otp-digit-box {
            width: 54px;
            height: 62px;
            border: 2px solid var(--border-light);
            border-radius: 12px;
            background: #FCFBF9;
            font-size: 24px;
            font-weight: 800;
            color: var(--emerald-dark);
            text-align: center;
            outline: none;
            font-family: 'Inter', monospace;
            transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .otp-digit-box:focus {
            background: #FFFFFF;
            border-color: var(--gold-accent);
            box-shadow: 0 0 0 4px rgba(212, 175, 106, 0.2), 0 4px 12px rgba(16, 52, 37, 0.08);
            transform: translateY(-2px);
        }

        .otp-digit-box.filled {
            border-color: var(--emerald-mid);
            background: #F8FAF9;
        }

        /* ─── Luxury CTA Button ─── */
        .btn-verify-submit {
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, var(--emerald-grad-start) 0%, var(--emerald-grad-mid) 50%, var(--emerald-grad-end) 100%);
            color: #FFFFFF;
            border: 1.8px solid var(--gold-accent);
            border-radius: 9999px;
            font-size: 15.5px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            letter-spacing: 0.3px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 18px rgba(18, 65, 47, 0.28), 0 0 14px rgba(212, 175, 106, 0.32), inset 0 1px 1px rgba(255, 238, 195, 0.45);
            transition: all 0.24s cubic-bezier(0.2, 0.8, 0.2, 1);
            margin-bottom: 22px;
        }

        .btn-verify-submit:hover {
            background: linear-gradient(135deg, #1b5b43 0%, #2a7c5b 50%, #1c5e45 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 26px rgba(18, 65, 47, 0.38), 0 0 22px rgba(212, 175, 106, 0.48);
            border-color: var(--gold-light);
        }

        .btn-verify-submit:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none;
        }

        /* ─── Resend & Footer Links ─── */
        .resend-section {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 18px;
        }

        .btn-resend {
            background: none;
            border: none;
            font-size: 14px;
            font-weight: 700;
            color: var(--emerald-mid);
            cursor: pointer;
            text-decoration: underline;
            text-underline-offset: 3px;
            font-family: inherit;
            padding: 0 4px;
            transition: color 0.15s;
        }

        .btn-resend:hover:not(:disabled) {
            color: var(--gold-accent);
        }

        .btn-resend:disabled {
            color: #9CA3AF;
            text-decoration: none;
            cursor: not-allowed;
        }

        .timer-badge {
            font-weight: 700;
            color: var(--emerald-dark);
        }

        .back-nav-link {
            font-size: 13.5px;
            color: var(--text-muted);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: color 0.15s;
        }

        .back-nav-link:hover {
            color: var(--emerald-dark);
            text-decoration: underline;
        }

        /* ─── Alert Toast / Message Banner ─── */
        .auth-alert {
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 500;
            margin-bottom: 20px;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-error {
            background: #FFF1F2;
            border: 1px solid #FECDD3;
            color: #9F1239;
        }

        .alert-success {
            background: #F0FDF4;
            border: 1px solid #BBF7D0;
            color: #166534;
        }

        @media (max-width: 480px) {
            .otp-card {
                padding: 32px 20px;
            }
            .otp-digit-box {
                width: 44px;
                height: 54px;
                font-size: 20px;
                gap: 6px;
            }
            .otp-top-bar {
                position: static;
                margin-bottom: 24px;
            }
        }
    </style>
</head>
<body>

    <!-- Top Branding -->
    <header class="otp-top-bar">
        <a href="/" class="brand-link" aria-label="StayNest Home">
            <svg class="brand-logo-icon" width="30" height="30" viewBox="0 0 34 34" fill="none">
                <rect width="34" height="34" rx="10" fill="#122B20"/>
                <path d="M17 7L8 14.5V25C8 25.5523 8.44772 26 9 26H14V19H20V26H25C25.5523 26 26 25.5523 26 25V14.5L17 7Z" fill="#FAF7F0"/>
                <circle cx="17" cy="14" r="2.2" fill="#D4AF6A"/>
            </svg>
            <span class="brand-name">Stay<span class="brand-name-accent">Nest</span></span>
        </a>
    </header>

    <!-- Verification Card -->
    <main class="otp-card">
        
        <div class="otp-icon-wrap">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
        </div>

        <h1 class="otp-title">Check your email</h1>
        <p class="otp-desc">
            We sent a 6-digit confirmation code to<br />
            <span class="user-email-badge"><%= email %></span>
        </p>

        <!-- Dynamic Alert Message -->
        <div id="alert-banner" class="auth-alert <%= errorMessage ? 'alert-error' : (successMessage ? 'alert-success' : '') %>" style="<%= (errorMessage || successMessage) ? '' : 'display: none;' %>">
            <span id="alert-text"><%= errorMessage || successMessage || '' %></span>
        </div>

        <!-- OTP Form -->
        <form id="otp-form" action="/auth/verify-email" method="POST">
            <input type="hidden" name="email" id="email-hidden" value="<%= email %>" />
            <input type="hidden" name="otp" id="otp-full-code" value="" />

            <div class="digit-inputs-row" id="digit-boxes-container">
                <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit-box" data-idx="0" autofocus />
                <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit-box" data-idx="1" />
                <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit-box" data-idx="2" />
                <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit-box" data-idx="3" />
                <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit-box" data-idx="4" />
                <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit-box" data-idx="5" />
            </div>

            <button type="submit" class="btn-verify-submit" id="btn-submit-verify">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Verify &amp; Continue</span>
            </button>
        </form>

        <!-- Resend OTP Section -->
        <div class="resend-section">
            <span>Didn't receive the email?</span>
            <button type="button" class="btn-resend" id="btn-resend-otp" onclick="handleResendOtp()" disabled>
                Resend code
            </button>
            <span id="timer-label">(in <span class="timer-badge" id="countdown-val">60s</span>)</span>
        </div>

        <a href="/auth/register" class="back-nav-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Wrong email address? Return to Sign up</span>
        </a>

    </main>

    <script>
        const boxes = document.querySelectorAll('.otp-digit-box');
        const form = document.getElementById('otp-form');
        const fullCodeInput = document.getElementById('otp-full-code');
        const submitBtn = document.getElementById('btn-submit-verify');
        const resendBtn = document.getElementById('btn-resend-otp');
        const timerLabel = document.getElementById('timer-label');
        const countdownEl = document.getElementById('countdown-val');
        const alertBanner = document.getElementById('alert-banner');
        const alertText = document.getElementById('alert-text');
        const userEmail = document.getElementById('email-hidden').value;

        // Auto-focus first input box
        if (boxes.length > 0) boxes[0].focus();

        function showAlert(message, isError = true) {
            alertBanner.className = 'auth-alert ' + (isError ? 'alert-error' : 'alert-success');
            alertText.textContent = message;
            alertBanner.style.display = 'flex';
        }

        // Input Navigation Physics
        boxes.forEach((box, index) => {
            box.addEventListener('input', (e) => {
                const val = box.value.replace(/[^0-9]/g, '');
                box.value = val;

                if (val) {
                    box.classList.add('filled');
                    if (index < boxes.length - 1) {
                        boxes[index + 1].focus();
                    }
                } else {
                    box.classList.remove('filled');
                }

                syncFullCode();
            });

            box.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !box.value && index > 0) {
                    boxes[index - 1].focus();
                }
            });

            // Handle Paste
            box.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim().replace(/[^0-9]/g, '');
                if (pasteData.length > 0) {
                    pasteData.split('').slice(0, boxes.length).forEach((char, i) => {
                        boxes[i].value = char;
                        boxes[i].classList.add('filled');
                    });
                    const nextIndex = Math.min(pasteData.length, boxes.length - 1);
                    boxes[nextIndex].focus();
                    syncFullCode();

                    // If full 6 digits were pasted, submit automatically!
                    if (pasteData.length >= 6) {
                        form.submit();
                    }
                }
            });
        });

        function syncFullCode() {
            let code = '';
            boxes.forEach(b => code += b.value);
            fullCodeInput.value = code;
        }

        form.addEventListener('submit', (e) => {
            syncFullCode();
            if (fullCodeInput.value.length < 6) {
                e.preventDefault();
                showAlert("Please enter all 6 digits of your verification code.", true);
                return;
            }
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>Verifying code...</span>';
        });

        // ── 60-Second Countdown Timer for Resend ──
        let timeLeft = 60;
        let timerInterval = null;

        function startTimer() {
            timeLeft = 60;
            resendBtn.disabled = true;
            timerLabel.style.display = 'inline';
            countdownEl.textContent = `${timeLeft}s`;

            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timeLeft--;
                countdownEl.textContent = `${timeLeft}s`;
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    resendBtn.disabled = false;
                    timerLabel.style.display = 'none';
                }
            }, 1000);
        }

        startTimer();

        // ── Resend OTP AJAX Handler ──
        async function handleResendOtp() {
            if (resendBtn.disabled) return;
            resendBtn.disabled = true;
            resendBtn.textContent = 'Sending...';

            try {
                const response = await fetch('/auth/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: userEmail })
                });

                const data = await response.json();
                if (data.success) {
                    showAlert("A new 6-digit code has been sent to your email!", false);
                    resendBtn.textContent = 'Resend code';
                    startTimer();
                    // Clear current boxes
                    boxes.forEach(b => { b.value = ''; b.classList.remove('filled'); });
                    boxes[0].focus();
                } else {
                    showAlert(data.message || "Could not resend OTP. Please try again.", true);
                    resendBtn.disabled = false;
                    resendBtn.textContent = 'Resend code';
                }
            } catch (err) {
                showAlert("Network error. Please try again.", true);
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend code';
            }
        }
    </script>
</body>
</html>

