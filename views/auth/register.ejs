<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account | StayNest</title>
    <meta name="description" content="Create a StayNest account to book stays or list your property." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/output.css" />
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .auth-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }
        .auth-card {
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
        }
        .auth-logo {
            display: block;
            font-size: 22px;
            font-weight: 700;
            color: #E8234A;
            text-decoration: none;
            letter-spacing: -0.5px;
            margin-bottom: 28px;
        }
        .auth-title {
            font-size: 24px;
            font-weight: 700;
            color: #111;
            margin: 0 0 6px 0;
            letter-spacing: -0.4px;
        }
        .auth-sub {
            font-size: 14px;
            color: #666;
            margin: 0 0 28px 0;
        }
        .form-group {
            margin-bottom: 18px;
        }
        label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #333;
            margin-bottom: 6px;
        }
        input[type="email"],
        input[type="password"],
        input[type="text"] {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #d4d4d4;
            border-radius: 8px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            color: #111;
            background: #fff;
            outline: none;
            transition: border-color 0.15s;
        }
        input:focus {
            border-color: #E8234A;
            box-shadow: 0 0 0 3px rgba(232, 35, 74, 0.08);
        }
        .error-box {
            background: #fff2f4;
            border: 1px solid #ffc5cc;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            color: #c0152e;
            margin-bottom: 20px;
        }
        .role-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .role-option {
            position: relative;
        }
        .role-option input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }
        .role-label {
            display: block;
            padding: 12px;
            border: 1px solid #d4d4d4;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            transition: border-color 0.15s, background 0.15s;
        }
        .role-label .role-title {
            font-size: 14px;
            font-weight: 600;
            color: #111;
            display: block;
        }
        .role-label .role-desc {
            font-size: 11px;
            color: #777;
            display: block;
            margin-top: 2px;
        }
        .role-option input[type="radio"]:checked + .role-label {
            border-color: #E8234A;
            background: #fff5f7;
        }
        .btn-primary {
            width: 100%;
            padding: 11px;
            background: #E8234A;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: background 0.15s;
            margin-top: 4px;
        }
        .btn-primary:hover { background: #c9193e; }
        .auth-footer {
            text-align: center;
            margin-top: 22px;
            font-size: 14px;
            color: #555;
        }
        .auth-footer a {
            color: #E8234A;
            font-weight: 500;
            text-decoration: none;
        }
        .auth-footer a:hover { text-decoration: underline; }
        .divider {
            border: none;
            border-top: 1px solid #ebebeb;
            margin: 24px 0;
        }
        .host-note {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 12px;
            color: #78350f;
            margin-top: 10px;
            display: none;
        }
        .host-note.visible { display: block; }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card">
            <a href="/" class="auth-logo">StayNest</a>

            <h1 class="auth-title">Create your account</h1>
            <p class="auth-sub">Book stays or list your property</p>

            <% if (error) { %>
                <div class="error-box"><%= error %></div>
            <% } %>

            <form action="/auth/register" method="POST" id="register-form">
                <div class="form-group">
                    <label for="name">Full name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= formData.name || '' %>"
                        placeholder="Rahul Sharma"
                        required
                        autocomplete="name"
                    />
                </div>
                <div class="form-group">
                    <label for="email">Email address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= formData.email || '' %>"
                        placeholder="you@example.com"
                        required
                        autocomplete="email"
                    />
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Min. 6 characters"
                        required
                        autocomplete="new-password"
                    />
                </div>

                <div class="form-group">
                    <label>I want to</label>
                    <div class="role-group">
                        <div class="role-option">
                            <input
                                type="radio"
                                id="role-guest"
                                name="role"
                                value="guest"
                                <%= (!formData.role || formData.role === 'guest') ? 'checked' : '' %>
                            />
                            <label for="role-guest" class="role-label">
                                <span class="role-title">Book stays</span>
                                <span class="role-desc">Guest account</span>
                            </label>
                        </div>
                        <div class="role-option">
                            <input
                                type="radio"
                                id="role-host"
                                name="role"
                                value="host"
                                <%= formData.role === 'host' ? 'checked' : '' %>
                            />
                            <label for="role-host" class="role-label">
                                <span class="role-title">List property</span>
                                <span class="role-desc">Host account</span>
                            </label>
                        </div>
                    </div>
                    <div class="host-note" id="host-note">
                        Host accounts require admin approval before your listings go live.
                    </div>
                </div>

                <button type="submit" class="btn-primary">Create account</button>
            </form>

            <hr class="divider" />

            <p class="auth-footer">
                Already have an account? <a href="/auth/login">Sign in</a>
            </p>
        </div>
    </div>

    <script>
        const hostRadio = document.getElementById('role-host');
        const guestRadio = document.getElementById('role-guest');
        const hostNote = document.getElementById('host-note');

        function toggleNote() {
            hostNote.classList.toggle('visible', hostRadio.checked);
        }

        hostRadio.addEventListener('change', toggleNote);
        guestRadio.addEventListener('change', toggleNote);

        // Set initial state
        toggleNote();
    </script>
</body>
</html>
