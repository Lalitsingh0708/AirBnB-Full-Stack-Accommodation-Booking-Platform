<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | StayNest</title>
    <meta name="description" content="Sign in to your StayNest account to book stays or manage your listings." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/output.css" />
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #FAF8F5;
            background-image: 
                radial-gradient(ellipse 90% 40% at 50% -10%, rgba(212, 175, 106, 0.07), transparent 70%),
                radial-gradient(circle at 95% 85%, rgba(20, 53, 40, 0.035), transparent 45%),
                radial-gradient(rgba(180, 160, 135, 0.16) 0.75px, transparent 0.75px);
            background-size: 100% 100%, 100% 100%, 22px 22px;
            background-attachment: fixed;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .auth-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }
        .auth-card {
            background: #ffffff;
            border: 1px solid #E8E2D5;
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 12px 36px rgba(20, 53, 40, 0.06);
        }
        .auth-logo {
            display: block;
            font-size: 22px;
            font-weight: 700;
            color: #E8234A;
            text-decoration: none;
            letter-spacing: -0.5px;
            margin-bottom: 28px;
        }
        .auth-title {
            font-size: 24px;
            font-weight: 700;
            color: #111;
            margin: 0 0 6px 0;
            letter-spacing: -0.4px;
        }
        .auth-sub {
            font-size: 14px;
            color: #666;
            margin: 0 0 28px 0;
        }
        .form-group {
            margin-bottom: 18px;
        }
        label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #333;
            margin-bottom: 6px;
        }
        input[type="email"],
        input[type="password"],
        input[type="text"] {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #d4d4d4;
            border-radius: 8px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            color: #111;
            background: #fff;
            outline: none;
            transition: border-color 0.15s;
        }
        input:focus {
            border-color: #E8234A;
            box-shadow: 0 0 0 3px rgba(232, 35, 74, 0.08);
        }
        .error-box {
            background: #fff2f4;
            border: 1px solid #ffc5cc;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            color: #c0152e;
            margin-bottom: 20px;
        }
        .btn-primary {
            width: 100%;
            padding: 11px;
            background: #E8234A;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: background 0.15s;
            margin-top: 4px;
        }
        .btn-primary:hover { background: #c9193e; }
        .auth-footer {
            text-align: center;
            margin-top: 22px;
            font-size: 14px;
            color: #555;
        }
        .auth-footer a {
            color: #E8234A;
            font-weight: 500;
            text-decoration: none;
        }
        .auth-footer a:hover { text-decoration: underline; }
        .divider {
            border: none;
            border-top: 1px solid #ebebeb;
            margin: 24px 0;
        }
        .btn-google-continue {
            display: flex;
            align-items: center;
            width: 100%;
            height: 48px;
            background: linear-gradient(135deg, #4d8bf5 0%, #357ae8 100%);
            border-radius: 9999px;
            padding: 4px 5px;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(66, 133, 244, 0.32);
            transition: all 0.22s ease;
            cursor: pointer;
            margin-bottom: 18px;
        }
        .btn-google-continue:hover {
            transform: translateY(-1.5px);
            box-shadow: 0 6px 20px rgba(66, 133, 244, 0.42);
        }
        .google-icon-circle {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
        }
        .google-btn-text {
            flex: 1;
            text-align: center;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            padding-right: 38px;
        }
        .auth-divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 16px 0 20px 0;
        }
        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #ebebeb;
        }
        .auth-divider-text {
            padding: 0 14px;
            font-size: 13.5px;
            color: #718096;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card">
            <a href="/" class="auth-logo">StayNest</a>

            <h1 class="auth-title">Welcome back</h1>
            <p class="auth-sub">Sign in to your account</p>

            <% if (error) { %>
                <div class="error-box"><%= error %></div>
            <% } %>

            <!-- Direct Login with Google -->
            <a href="/auth/google<%= (typeof returnUrl !== 'undefined' && returnUrl) ? '?returnUrl=' + encodeURIComponent(returnUrl) : '' %>" class="btn-google-continue">
                <span class="google-icon-circle">
                    <svg viewBox="0 0 24 24" width="22" height="22">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                        <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                    </svg>
                </span>
                <span class="google-btn-text">Continue with Google</span>
            </a>

            <div class="auth-divider">
                <span class="auth-divider-text">Enter Email</span>
            </div>

            <form action="/auth/login" method="POST" id="login-form">
                <div class="form-group">
                    <label for="email">Email address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= formData.email || '' %>"
                        placeholder="you@example.com"
                        required
                        autocomplete="email"
                    />
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Min. 6 characters"
                        required
                        autocomplete="current-password"
                    />
                </div>

                <button type="submit" class="btn-primary">Sign in</button>
            </form>

            <hr class="divider" />

            <p class="auth-footer">
                Don't have an account? <a href="/auth/register">Create one</a>
            </p>
        </div>
    </div>
</body>
</html>
