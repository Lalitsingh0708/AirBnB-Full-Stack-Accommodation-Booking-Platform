            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: 1.5px solid #B0B0B0;
            background: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
            color: transparent;
            flex-shrink: 0;
        }

        .safety-option-item:hover .safety-checkbox-box {
            border-color: #222222;
        }

        .safety-option-item.checked .safety-checkbox-box {
            background: #222222;
            border-color: #222222;
            color: #FFFFFF;
        }

        .safety-divider {
            border: none;
            border-top: 1px solid #EBEBEB;
            margin: 28px 0 28px 0;
        }

        .safety-important-section {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .safety-important-title {
            font-size: 18px;
            font-weight: 600;
            color: #222222;
            margin-bottom: 2px;
        }

        .safety-important-text {
            font-size: 14px;
            color: #717171;
            line-height: 1.5;
            margin: 0;
        }

        .safety-policy-link {
            background: none;
            border: none;
            font-size: inherit;
            color: #222222;
            text-decoration: underline;
            cursor: pointer;
            padding: 0;
            font-weight: 500;
        }

        .safety-policy-link:hover {
            color: #000000;
        }

        /* ── Step 19: Provide a few final details (Matching Screenshot Exactly) ── */
        .final-details-container {
            max-width: 650px;
            margin: 0 auto;
            width: 100%;
            padding: 30px 20px 60px 20px;
            text-align: left;
        }

        .final-details-title {
            font-size: 32px;
            font-weight: 700;
            color: #222222;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
            line-height: 1.25;
        }

        .final-details-sub {
            font-size: 15px;
            color: #717171;
            line-height: 1.45;
            margin-bottom: 32px;
        }

        .residential-section-title {
            font-size: 18px;
            font-weight: 600;
            color: #222222;
            margin-bottom: 4px;
        }

        .residential-section-sub {
            font-size: 14px;
            color: #717171;
            margin-bottom: 22px;
        }

        .residential-country-box {
            position: relative;
            border: 1px solid #B0B0B0;
            border-radius: 8px;
            padding: 8px 16px 10px 16px;
            background: #FFFFFF;
            cursor: pointer;
            transition: border-color 0.2s ease;
        }

        .residential-country-box:focus-within {
            border-color: #222222;
            box-shadow: 0 0 0 1px #222222;
        }

        .residential-country-label {
            display: block;
            font-size: 11.5px;
            color: #717171;
            margin-bottom: 2px;
        }

        .residential-country-select {
            width: 100%;
            border: none;
            background: transparent;
            font-size: 16px;
            font-weight: 400;
            color: #222222;
            outline: none;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
            font-family: inherit;
        }

        .residential-chevron-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            color: #222222;
        }

        .residential-stacked-inputs {
            border: 1px solid #B0B0B0;
            border-radius: 8px;
            overflow: hidden;
            margin-top: 14px;
            background: #FFFFFF;
            transition: border-color 0.2s ease;
        }

        .residential-stacked-inputs:focus-within {
            border-color: #222222;
            box-shadow: 0 0 0 1px #222222;
        }

        .residential-input-row {
            width: 100%;
            border-bottom: 1px solid #EBEBEB;
            position: relative;
        }

        .residential-input-row:last-child {
            border-bottom: none;
        }

        .residential-text-input {
            width: 100%;
            border: none;
            background: transparent;
            padding: 16px;
            font-size: 15px;
            color: #222222;
            outline: none;
            font-family: inherit;
        }

        .residential-text-input::placeholder {
            color: #717171;
            font-size: 15px;
        }

        /* ── Step 6: Title & Story Legacy ── */
        .story-step-wrap {
            max-width: 660px;
            margin: 0 auto;
            width: 100%;
        }

        .standard-field-wrap label {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .standard-input {
            width: 100%;
            height: 48px;
            border: 1.5px solid var(--border-light);
            border-radius: 14px;
            padding: 0 16px;
            font-family: inherit;
            font-size: 14.5px;
            color: var(--text-dark);
            background: #FFFFFF;
            outline: none;
            transition: all 0.2s ease;
        }

        .standard-input:focus {
            border-color: var(--gold-accent);
            box-shadow: 0 0 0 3px rgba(212, 175, 106, 0.2);
        }

        .story-textarea {
            width: 100%;
            min-height: 140px;
            border: 2px solid var(--border-light);
            border-radius: 18px;
            padding: 16px;
            font-family: inherit;
            font-size: 15px;
            color: var(--text-dark);
            background: #FFFFFF;
            outline: none;
            resize: vertical;
            transition: all 0.25s ease;
        }

        .story-textarea:focus {
            border-color: var(--gold-accent);
            box-shadow: 0 0 0 3.5px rgba(212, 175, 106, 0.2);
        }

        /* ── Step 7: Pricing & Review ── */
        .price-center-box {
            text-align: center;
            max-width: 580px;
            margin: 0 auto 36px auto;
        }

        .price-giant-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin: 24px 0;
        }

        .currency-symbol {
            font-family: 'Playfair Display', serif;
            font-size: 52px;
            font-weight: 700;
            color: var(--emerald-dark);
        }

        .price-giant-input {
            width: 240px;
            height: 84px;
            font-family: 'Playfair Display', serif;
            font-size: 58px;
            font-weight: 700;
            color: var(--emerald-dark);
            border: none;
            border-bottom: 3px solid var(--gold-accent);
            background: transparent;
            text-align: center;
            outline: none;
        }

        .price-breakdown-card {
            background: #FFFFFF;
            border: 1px solid var(--border-light);
            border-radius: 20px;
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            color: var(--text-muted);
            box-shadow: 0 4px 16px rgba(18, 43, 32, 0.04);
        }

        .price-breakdown-card strong {
            color: var(--emerald-dark);
        }

        /* Review Summary Box */
        .review-summary-card {
            background: #FFFFFF;
            border: 1.5px solid var(--border-light);
            border-radius: 24px;
            padding: 24px;
            max-width: 580px;
            margin: 0 auto;
            box-shadow: 0 12px 30px rgba(18, 43, 32, 0.06);
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .review-thumb {
            width: 110px;
            height: 110px;
            border-radius: 16px;
            object-fit: cover;
            background: #E8E2D5;
            flex-shrink: 0;
        }

        .review-info-title {
            font-size: 17px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 4px;
        }

        .review-info-location {
            font-size: 13.5px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .review-info-price {
            font-size: 16px;
            font-weight: 800;
            color: var(--emerald-dark);
        }

        /* ── Bottom Floating Bar (Airbnb Authentic Styling) ── */
        .wizard-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #FFFFFF;
            border-top: 1px solid #DDDDDD;
            padding: 16px 40px;
            z-index: 900;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .progress-track {
            width: 100%;
            display: flex;
            gap: 8px;
            height: 4px;
            background: transparent;
        }

        .progress-track-segment {
            flex: 1;
            height: 4px;
            background: #EBEBEB;
            border-radius: 2px;
            overflow: hidden;
            position: relative;
        }

        .progress-segment-fill {
            height: 100%;
            background: #222222;
            width: 0%;
            transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .progress-fill {
            height: 100%;
            background: #222222;
            width: 14%;
            transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .footer-nav-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1240px;
            width: 100%;
            margin: 0 auto;
        }

        .btn-wizard-back {
            background: transparent;
            border: none;
            font-family: inherit;
            font-size: 16px;
            font-weight: 600;
            color: #222222;
            text-decoration: underline;
            cursor: pointer;
            padding: 8px 4px;
            transition: opacity 0.2s ease;
        }

        .btn-wizard-back:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            text-decoration: none;
        }

        .btn-wizard-next {
            background: #222222;
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            padding: 14px 32px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .btn-wizard-next:hover:not(:disabled) {
            background: #000000;
        }

        .btn-wizard-next:disabled,
        .btn-wizard-next.disabled-state {
            background: #F7F7F7 !important;
            color: #BFBFBF !important;
            cursor: not-allowed !important;
            border: none !important;
            box-shadow: none !important;
            transform: none !important;
        }

        @media (max-width: 860px) {
            .split-layout {
                grid-template-columns: 1fr;
                gap: 32px;
            }
            .split-hero-card {
                height: 280px;
            }
            .step-headline {
                font-size: 38px;
            }
            .wizard-header, .wizard-footer {
                padding: 14px 20px;
            }
        }
    </style>
</head>
<body>

    <!-- ── Top Header ── -->
    <header class="wizard-header">
        <a href="/" class="brand-logo-link">
            <svg width="30" height="30" viewBox="0 0 34 34" fill="none">
                <rect width="34" height="34" rx="10" fill="#122B20"/>
                <path d="M17 7L8 14.5V25C8 25.5523 8.44772 26 9 26H14V19H20V26H25C25.5523 26 26 25.5523 26 25V14.5L17 7Z" fill="#FAF7F0"/>
                <circle cx="17" cy="14" r="2.2" fill="#D4AF6A"/>
            </svg>
            <span class="brand-text">Stay<span>Nest</span></span>
        </a>

        <a href="/host" class="btn-exit-save">Exit &amp; Return to Dashboard</a>
    </header>

    <!-- ── Hidden Submission Form ── -->
    <form id="airbnb-listing-form" action="/host/add-home" method="POST">
        <input type="hidden" name="propertyType" id="f-propertyType" value="House" />
        <input type="hidden" name="placeType" id="f-placeType" value="An entire place" />
        <input type="hidden" name="latitude" id="f-latitude" value="28.6139" />
