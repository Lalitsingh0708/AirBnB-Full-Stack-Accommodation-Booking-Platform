        // ── 5. Stepper Counters ──
        function updateCounter(field, delta) {
            const min = field === 'maxGuests' ? 1 : (field === 'bathrooms' ? 1 : 0);
            wizardState[field] = Math.max(min, wizardState[field] + delta);
            document.getElementById('val-' + field).textContent = wizardState[field];
        }

        // ── 6. Amenity Toggles ──
        function toggleAmenity(key, el) {
            const idx = wizardState.amenities.indexOf(key);
            if (idx > -1) {
                wizardState.amenities.splice(idx, 1);
                el.classList.remove('selected');
            } else {
                wizardState.amenities.push(key);
                el.classList.add('selected');
            }
        }

        // ── 7. Photos ──
        function onPhotoUrlChange(url) {
            if (url && url.startsWith('http')) {
                wizardState.housePhoto = url;
                document.getElementById('live-photo-preview').src = url;
                document.getElementById('review-thumb-img').src = url;
            }
        }

        function applyPresetPhoto(url) {
            document.getElementById('input-photo').value = url;
            onPhotoUrlChange(url);
        }

        // ── 8. Price Estimate ──
        function updatePriceEstimate(val) {
            const price = Number(val) || 0;
            wizardState.homePrice = price;
            document.getElementById('disp-base-price').textContent = '₹' + price.toLocaleString('en-IN');
            document.getElementById('disp-payout-price').textContent = '₹' + Math.round(price * 0.97).toLocaleString('en-IN');
            document.getElementById('review-price-disp').innerHTML = '₹' + price.toLocaleString('en-IN') + ' <span style="font-size: 12px; font-weight: 400; color: #6B7770;">/ night</span>';
        }

        // ── 9. Step 5 Leaflet Privacy Map & Precision Toggle ──
        let privacyLeafletMap = null;
        let privacyExactMarker = null;
        let privacyApproxCircle = null;

        function initOrUpdatePrivacyMap() {
            const lat = wizardState.latitude || 28.6139;
            const lon = wizardState.longitude || 77.2090;

            // Update top floating address pill text
            const pillText = document.getElementById('privacy-address-pill-text');
            if (pillText) {
                pillText.textContent = wizardState.homeAddress || `${wizardState.city ? wizardState.city + ', ' : ''}${wizardState.state || 'India'}`;
            }

            setTimeout(() => {
                const mapEl = document.getElementById('privacy-leaflet-map');
                if (!mapEl) return;

                if (!privacyLeafletMap) {
                    privacyLeafletMap = L.map('privacy-leaflet-map', {
                        zoomControl: false,
                        attributionControl: false,
                        dragging: true,
                        scrollWheelZoom: false,
                        doubleClickZoom: true
                    }).setView([lat, lon], 15);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(privacyLeafletMap);

                    // Custom house pin icon matching Step 4 badge
                    const pinIcon = L.divIcon({
                        className: 'custom-privacy-marker',
                        html: `
                            <div class="map-center-badge" style="transform: translateY(-50%); box-shadow: 0 4px 14px rgba(0,0,0,0.35); pointer-events: none;">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </div>
                        `,
                        iconSize: [44, 44],
                        iconAnchor: [22, 22]
                    });

                    privacyExactMarker = L.marker([lat, lon], { icon: pinIcon });

                    // Soft neighborhood approximate circular zone (~500m radius)
                    privacyApproxCircle = L.circle([lat, lon], {
                        radius: 500,
                        color: '#143528',
                        fillColor: '#1D4333',
                        fillOpacity: 0.16,
                        weight: 2,
                        dashArray: '6, 6'
                    });
                } else {
                    privacyLeafletMap.setView([lat, lon], 15);
                    if (privacyExactMarker) privacyExactMarker.setLatLng([lat, lon]);
                    if (privacyApproxCircle) privacyApproxCircle.setLatLng([lat, lon]);
                    privacyLeafletMap.invalidateSize();
                }

                syncPrivacyMapLayers();
            }, 120);
        }

        function syncPrivacyMapLayers() {
            if (!privacyLeafletMap) return;
            const toggleBtn = document.getElementById('privacy-toggle-btn');
            const hiddenInput = document.getElementById('f-showPreciseLocation');

            if (wizardState.showPreciseLocation) {
                if (toggleBtn) toggleBtn.classList.add('active');
                if (hiddenInput) hiddenInput.value = 'true';
                if (privacyApproxCircle && privacyLeafletMap.hasLayer(privacyApproxCircle)) {
                    privacyLeafletMap.removeLayer(privacyApproxCircle);
                }
                if (privacyExactMarker && !privacyLeafletMap.hasLayer(privacyExactMarker)) {
                    privacyExactMarker.addTo(privacyLeafletMap);
                }
            } else {
                if (toggleBtn) toggleBtn.classList.remove('active');
                if (hiddenInput) hiddenInput.value = 'false';
                if (privacyExactMarker && privacyLeafletMap.hasLayer(privacyExactMarker)) {
                    privacyLeafletMap.removeLayer(privacyExactMarker);
                }
                if (privacyApproxCircle && !privacyLeafletMap.hasLayer(privacyApproxCircle)) {
                    privacyApproxCircle.addTo(privacyLeafletMap);
                }
            }
        }

        function togglePreciseLocation() {
            wizardState.showPreciseLocation = !wizardState.showPreciseLocation;
            syncPrivacyMapLayers();
        }

        function openPrivacyInfoModal() {
            const overlay = document.getElementById('privacy-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closePrivacyInfoModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('privacy-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        // ── 10. Step Navigation Logic ──
        function navigateStep(direction) {
            // Validation before going forward
            if (direction === 1) {
                if (currentStep === 1) {
                    // Step 1 is Address selection
                    if (!wizardState.homeAddress) {
                        openAddressModal();
                        return;
                    }
                } else if (currentStep === 10) {
                    // Step 10 is Photo input (previously step 9)
                    const photo = document.getElementById('input-photo').value.trim();
                    if (!photo) {
                        alert('Please provide a photo URL or choose a preset.');
                        document.getElementById('input-photo').focus();
                        return;
                    }
                    wizardState.housePhoto = photo;
                } else if (currentStep === 11) {
                    // Step 11 is Title input (previously step 10)
                    const title = document.getElementById('input-title').value.trim();
                    if (!title) {
                        alert('Please provide a title for your sanctuary.');
                        document.getElementById('input-title').focus();
                        return;
                    }
                    wizardState.homeName = title;
                    wizardState.description = document.getElementById('input-desc').value.trim();
                } else if (currentStep === 12) {
                    // Step 12 is Final submission!
                    submitListingForm();
                    return;
                }
            }

            // Move step
            document.getElementById('step-' + currentStep).classList.remove('active');
            currentStep += direction;
            currentStep = Math.max(1, Math.min(totalSteps, currentStep));
            document.getElementById('step-' + currentStep).classList.add('active');
            
            if (currentStep === 2) {
                triggerHouseRebuildAnimation();
            } else if (currentStep === 5) {
                initOrUpdateMap();
            } else if (currentStep === 6) {
                initOrUpdatePrivacyMap();
            } else if (currentStep === 8) {
                triggerHouseFurnishAnimation();
            }

            // Scroll to top of stage
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Update footer
            updateFooterBar();
        }

        // ── Step 2 Furnished House Animation Controllers ──
        function triggerHouseFurnishAnimation() {
            const stage = document.getElementById('house-stage-step2');
            const pillText = document.getElementById('furnish-phase-text');
            if (!stage) return;

            stage.classList.remove('constructing');
            void stage.offsetWidth; // Force reflow
            stage.classList.add('constructing');

            if (pillText) {
                pillText.textContent = 'Styling & Furnishing Interior...';
                setTimeout(() => {
                    if (pillText) pillText.textContent = 'Interior Styling & Amenities • Stage Complete';
                }, 3300);
            }
        }

        function handleHouseArenaMouseMoveStep2(e) {
            const arena = document.getElementById('house-arena-step2');
            const stage = document.getElementById('house-stage-step2');
            if (!arena || !stage) return;

            const rect = arena.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateX = ((centerY - y) / centerY) * 12;
            const rotateY = ((x - centerX) / centerX) * 16;

            stage.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        }

        function resetHouseArenaTiltStep2() {
            const stage = document.getElementById('house-stage-step2');
            if (!stage) return;
            stage.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }

        function updateFooterBar() {
            // Progress bar
            const pct = Math.round((currentStep / totalSteps) * 100);
            document.getElementById('progress-bar-fill').style.width = pct + '%';

            // Back button
            const backBtn = document.getElementById('btn-back');
            backBtn.disabled = (currentStep === 1);

            // Next button text & styling
            const nextBtn = document.getElementById('btn-next');
            if (currentStep === totalSteps) {
                nextBtn.innerHTML = `
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Publish Accommodation</span>
                `;
                nextBtn.style.background = '#1D4333';
                nextBtn.style.padding = '14px 40px';

                // Populate Step 10 review card
                document.getElementById('review-title-disp').textContent = wizardState.homeName || 'Untitled Sanctuary';
                document.getElementById('review-loc-disp').textContent = (wizardState.city ? wizardState.city + ', ' : '') + (wizardState.state || 'India');
                document.getElementById('review-thumb-img').src = wizardState.housePhoto;
            } else {
                nextBtn.innerHTML = `
                    <span>Next</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                `;
                nextBtn.style.background = '#143528';
                nextBtn.style.padding = '14px 34px';
            }
        }

        // ── 11. Form Submission ──
        function submitListingForm() {
            document.getElementById('f-propertyType').value = wizardState.propertyType;
            const fPlace = document.getElementById('f-placeType'); if (fPlace) fPlace.value = wizardState.placeType;
            const fLat = document.getElementById('f-latitude'); if (fLat) fLat.value = wizardState.latitude;
            const fLng = document.getElementById('f-longitude'); if (fLng) fLng.value = wizardState.longitude;
            const fPrecise = document.getElementById('f-showPreciseLocation'); if (fPrecise) fPrecise.value = wizardState.showPreciseLocation;
            document.getElementById('f-homeAddress').value = wizardState.homeAddress;
            document.getElementById('f-city').value = wizardState.city;
            document.getElementById('f-state').value = wizardState.state;
            document.getElementById('f-maxGuests').value = wizardState.maxGuests;
            document.getElementById('f-bedrooms').value = wizardState.bedrooms;
            document.getElementById('f-beds').value = wizardState.beds;
            document.getElementById('f-bathrooms').value = wizardState.bathrooms;
            document.getElementById('f-amenities').value = wizardState.amenities.join(',');
            document.getElementById('f-housePhoto').value = wizardState.housePhoto;
            document.getElementById('f-homeName').value = wizardState.homeName;
            document.getElementById('f-description').value = wizardState.description;
            document.getElementById('f-homePrice').value = wizardState.homePrice;

            // Submit form
            document.getElementById('airbnb-listing-form').submit();
        }
    </script>
</body>
</html>