            // Update modal input
            document.getElementById('modal-address-input').value = address;

            // Update hidden form inputs
            document.getElementById('f-homeAddress').value = address;
            document.getElementById('f-city').value = city;
            document.getElementById('f-state').value = state;

            // Default suggested title if empty
            if (!wizardState.homeName) {
                const titleField = document.getElementById('input-title');
                if (titleField && !titleField.value) {
                    titleField.value = `The Grand Villa in ${city || 'Sanctuary'}`;
                    wizardState.homeName = titleField.value;
                }
