        // ── Step 3.2 Dynamic Pricing & Weekend Markup Controllers ──
        function openBasePriceModal() {
            const price = wizardState.homePrice || 2321;
            const modalInput = document.getElementById('modal-base-price-input');
            if (modalInput) {
                modalInput.value = price.toLocaleString('en-IN');
            }
            adjustPriceInputWidth();
            updateModalBreakdown(price);
            const overlay = document.getElementById('base-price-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closeBasePriceModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('base-price-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        function adjustPriceInputWidth() {
            const inp = document.getElementById('modal-base-price-input');
            if (!inp) return;
            const len = Math.max(1, (inp.value || '').length);
            inp.style.width = Math.max(70, len * 32) + 'px';
        }

        function updateModalBreakdown(price) {
            const num = Math.max(0, Number(price) || 0);
            // 15.51% host service fee matching the ₹360 fee on ₹2,321 screenshot
            const serviceFee = Math.round(num * 0.1551);
            const earn = Math.max(0, num - serviceFee);

            const guestEl = document.getElementById('bd-guest-price');
            const feeEl = document.getElementById('bd-service-fee');
            const earnEl = document.getElementById('bd-host-earn');

            if (guestEl) guestEl.textContent = '₹' + num.toLocaleString('en-IN');
            if (feeEl) feeEl.textContent = '-₹' + serviceFee.toLocaleString('en-IN');
            if (earnEl) earnEl.textContent = '₹' + earn.toLocaleString('en-IN');
        }

        function onModalPriceInput(val) {
            const num = parseInt(val.replace(/[^\d]/g, ''), 10) || 0;
            wizardState.homePrice = num;
            adjustPriceInputWidth();
            updateModalBreakdown(num);

            // Update main page card display
            const cardPrice = document.getElementById('disp-card-base-price');
            if (cardPrice) cardPrice.textContent = num.toLocaleString('en-IN');

            // Update weekend price calculation
            const pct = wizardState.weekendAdjustment !== undefined ? wizardState.weekendAdjustment : 6;
            wizardState.weekendPrice = Math.round(num * (1 + pct / 100));
            const calcDisp = document.getElementById('disp-weekend-calc');
            if (calcDisp) {
                calcDisp.textContent = `₹${wizardState.weekendPrice.toLocaleString('en-IN')} for Fri and Sat`;
            }

            // Sync hidden inputs & review estimate
            const fPrice = document.getElementById('f-homePrice'); if (fPrice) fPrice.value = num;
            const fWPrice = document.getElementById('f-weekendPrice'); if (fWPrice) fWPrice.value = wizardState.weekendPrice;
            updatePriceEstimate(num);
            const dispW = document.getElementById('disp-final-weekend-price');
            if (dispW) dispW.textContent = '₹' + wizardState.weekendPrice.toLocaleString('en-IN') + ' / night';
            updateFooterBar();
        }

        function formatModalPriceOnBlur() {
            const inp = document.getElementById('modal-base-price-input');
            if (!inp) return;
            const num = parseInt(inp.value.replace(/[^\d]/g, ''), 10) || 0;
            inp.value = num.toLocaleString('en-IN');
            adjustPriceInputWidth();
        }

        let isBreakdownCollapsed = false;
        function togglePriceBreakdown() {
            isBreakdownCollapsed = !isBreakdownCollapsed;
            const box = document.getElementById('price-breakdown-box');
            const txt = document.getElementById('txt-toggle-breakdown');
            const icon = document.getElementById('icon-toggle-breakdown');

            if (isBreakdownCollapsed) {
                if (box) box.style.display = 'none';
                if (txt) txt.textContent = 'Show more';
                if (icon) icon.innerHTML = '<polyline points="6 9 12 15 18 9"></polyline>';
            } else {
                if (box) box.style.display = 'flex';
                if (txt) txt.textContent = 'Show less';
                if (icon) icon.innerHTML = '<polyline points="18 15 12 9 6 15"></polyline>';
            }
        }

