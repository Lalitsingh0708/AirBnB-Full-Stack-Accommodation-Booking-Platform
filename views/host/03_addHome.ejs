        <input type="hidden" name="city" id="f-city" value="" />
        <input type="hidden" name="state" id="f-state" value="" />
        <input type="hidden" name="maxGuests" id="f-maxGuests" value="4" />
        <input type="hidden" name="bedrooms" id="f-bedrooms" value="2" />
        <input type="hidden" name="beds" id="f-beds" value="2" />
        <input type="hidden" name="bathrooms" id="f-bathrooms" value="2" />
        <input type="hidden" name="amenities" id="f-amenities" value="wifi,ac,parking" />
        <input type="hidden" name="housePhoto" id="f-housePhoto" value="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1200&auto=format&fit=crop&q=80" />
        <input type="hidden" name="homeName" id="f-homeName" value="" />
        <input type="hidden" name="description" id="f-description" value="" />
        <input type="hidden" name="homePrice" id="f-homePrice" value="12500" />
        <input type="hidden" name="highlights" id="f-highlights" value="" />
