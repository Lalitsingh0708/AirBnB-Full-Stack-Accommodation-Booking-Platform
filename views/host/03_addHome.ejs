        <!-- Leaflet Map JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- ── Wizard JavaScript Controller ── -->
    <script>
        let currentStep = 1;
        const totalSteps = 19;

        // State holder
        const wizardState = {
            homeAddress: '',
            city: '',
            state: '',
            propertyType: 'House',
            placeType: 'An entire place',
            latitude: 28.6139,
            longitude: 77.2090,
            showPreciseLocation: true,
            maxGuests: 4,
            bedrooms: 2,
            beds: 2,
            bathrooms: 2,
            amenities: ['wifi', 'ac', 'parking', 'hotWater', 'essentials', 'kitchen'],
            photos: [],
            housePhoto: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1200&auto=format&fit=crop&q=80',
            homeName: '',
            highlights: [],
            description: '',
            bookingSettings: 'approve_first_5',
            homePrice: 2321,
            weekendAdjustment: 6,
            weekendPrice: 2460,
            discounts: {
                newListingPromotion: true,
                lastMinuteDiscount: 7,
                weeklyDiscount: 10,
                monthlyDiscount: 20
            },
            safetyDetails: {
                securityCameras: false,
                noiseMonitors: false,
                weapons: false
            },
            residentialAddress: {
                country: 'India',
                flat: '',
                street: '',
                landmark: '',
                district: '',
                city: '',
                state: '',
                pinCode: ''
            }
        };

        // ── Dynamic & Unbiased Location Detection Engine ──
        window.__detectedCountryCode = null;

        function getDetectedUserCountryCode() {
            if (window.__detectedCountryCode) return window.__detectedCountryCode.toLowerCase();
            try {
                // 1. Timezone detection (fast and accurate for country)
                const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
                if (tz.includes('Kolkata') || tz.includes('Calcutta') || tz.includes('India') || tz.includes('Asia/Kolkata')) {
                    window.__detectedCountryCode = 'in';
                    return 'in';
                }
                if (tz.includes('Dubai') || tz.includes('Asia/Dubai')) return 'ae';
                if (tz.includes('London') || tz.includes('Europe/London')) return 'gb';
                if (tz.includes('Singapore')) return 'sg';
                if (tz.includes('Tokyo')) return 'jp';
                if (tz.includes('Sydney') || tz.includes('Melbourne')) return 'au';
                if (tz.includes('Toronto') || tz.includes('Vancouver')) return 'ca';
                if (tz.includes('Berlin') || tz.includes('Paris')) return 'de';

                // 2. Language/Locale code
                const lang = navigator.language || (navigator.languages && navigator.languages[0]) || '';
                if (lang.includes('-')) {
                    const cc = lang.split('-')[1].toLowerCase();
                    if (cc && cc.length === 2) {
                        window.__detectedCountryCode = cc;
                        return cc;
                    }
                }
            } catch (e) {
                console.warn('Country detection error:', e);
            }
            // Default to India for StayNest if undetermined
            return 'in';
        }

        // Unbiased & Dynamic Location Search
        // Prioritizes user's current country/viewbox first, then falls back seamlessly to global search
        async function searchPlacesDynamically(query, limit = 5) {
            const cc = getDetectedUserCountryCode();
            
            // Build viewbox around current marker or map center if available (approx +/- 4.5 deg radius)
            let viewboxParam = '';
            const centerLat = wizardState.latitude || (typeof leafletMap !== 'undefined' && leafletMap ? leafletMap.getCenter().lat : null);
            const centerLng = wizardState.longitude || (typeof leafletMap !== 'undefined' && leafletMap ? leafletMap.getCenter().lng : null);
            if (centerLat && centerLng) {
                const left = (centerLng - 4.5).toFixed(4);
                const right = (centerLng + 4.5).toFixed(4);
                const top = (centerLat + 4.5).toFixed(4);
                const bottom = (centerLat - 4.5).toFixed(4);
                viewboxParam = `&viewbox=${left},${top},${right},${bottom}`;
            }

            // Tier 1: Search within detected country (prioritizing local/regional places)
            try {
                const localUrl = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=${cc}${viewboxParam}&addressdetails=1&limit=${limit}`;
                const res = await fetch(localUrl);
                if (res.ok) {
                    const localResults = await res.json();
                    if (localResults && localResults.length > 0) {
                        return localResults;
                    }
                }
            } catch (e) {
                console.warn('Local priority search failed:', e);
            }

            // Tier 2: Unbiased Global Search (if query is international or not found in local country)
            try {
                const globalUrl = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&addressdetails=1&limit=${limit}`;
                const res = await fetch(globalUrl);
                if (res.ok) {
                    const globalResults = await res.json();
                    return globalResults || [];
                }
            } catch (e) {
                console.warn('Global fallback search failed:', e);
            }

            return [];
        }

        // ── 1. Step 1 Rotating Slideshow ("photo change hote rhe") ──
        let currentSlideIdx = 0;
        const slides = document.querySelectorAll('.slide-img');
        const dots = document.querySelectorAll('.slideshow-dots .dot');

        function rotateSlideShow() {
            if (!slides || slides.length === 0) return;
            slides[currentSlideIdx].classList.remove('active');
            if (dots[currentSlideIdx]) dots[currentSlideIdx].classList.remove('active');

            currentSlideIdx = (currentSlideIdx + 1) % slides.length;

            slides[currentSlideIdx].classList.add('active');
            if (dots[currentSlideIdx]) dots[currentSlideIdx].classList.add('active');
        }

        // Auto rotate photos every 3.8 seconds with smooth cross-fade
        let slideTimer = setInterval(rotateSlideShow, 3800);

        // ── 2. Address Modal Logic ──
        function openAddressModal() {
            const overlay = document.getElementById('address-modal-overlay');
            overlay.classList.add('open');
            setTimeout(() => {
                document.getElementById('modal-address-input').focus();
            }, 100);
        }

        function closeAddressModal(event) {
            if (event && event.target !== event.currentTarget) return;
            document.getElementById('address-modal-overlay').classList.remove('open');
        }

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                ['base-price-modal-overlay', 'address-modal-overlay', 'privacy-modal-overlay', 'booking-modal-overlay', 'pricing-advice-modal-overlay', 'similar-listings-modal-overlay', 'weekend-adjust-modal-overlay', 'discounts-modal-overlay', 'safety-info-modal-overlay', 'local-laws-modal-overlay', 'policy-modal-overlay'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el && el.classList.contains('open')) {
                        el.classList.remove('open');
                    }
                });
            }
        });

        // ── 3. High-Accuracy Geolocation & Reverse Geocoding ──
        async function detectCurrentLocation() {
            const btnTitle = document.getElementById('loc-btn-title');
            const btnSub = document.getElementById('loc-btn-sub');

            btnTitle.innerHTML = `<span class="loc-spinner"></span> Detecting exact location...`;
            if (btnSub) btnSub.textContent = 'Accessing high-accuracy GPS coordinates...';

            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser.');
                btnTitle.textContent = 'Use my current location';
                if (btnSub) btnSub.textContent = 'Detect location automatically using device GPS';
                return;
            }

            // IP location fallback helper
            const fallbackToIP = async (reason) => {
                console.log('Using network/IP location fallback:', reason);
                try {
                    const ipRes = await fetch('https://ipwho.is/');
                    if (!ipRes.ok) throw new Error('IP service error');
                    const data = await ipRes.json();
                    if (data.success === false) throw new Error('IP lookup failed');

                    const city = data.city || 'Agra';
                    const state = data.region || 'Uttar Pradesh';
                    const fullAddress = `${city}, ${state}, India`;

                    applySelectedAddress(fullAddress, city, state);
                } catch (e) {
                    console.warn('IP fallback failed:', e);
                    applySelectedAddress('Fatehabad Road, Agra, Uttar Pradesh', 'Agra', 'Uttar Pradesh');
                } finally {
                    btnTitle.textContent = 'Use my current location';
                    if (btnSub) btnSub.textContent = 'Detect location automatically using device GPS';
                }
            };

            const geoOptions = {
                enableHighAccuracy: true, // Request true GPS / high precision Wi-Fi triangulation
                timeout: 18000,          // 18s window for user to allow and hardware to lock
                maximumAge: 0            // Never use old cached location
            };

            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    const { latitude, longitude, accuracy } = position.coords;
                    console.log(`[StayNest GPS] Lat: ${latitude}, Lon: ${longitude}, Accuracy: ${accuracy}m`);

                    btnTitle.innerHTML = `<span class="loc-spinner"></span> Pinpointing exact address...`;
                    if (btnSub) btnSub.textContent = `GPS locked (±${Math.round(accuracy || 15)}m). Resolving street details...`;

                    try {
                        // OpenStreetMap Nominatim zoom=18 for exact street/building level precision
                        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}&zoom=18&addressdetails=1`);
                        if (!res.ok) throw new Error('Nominatim reverse error');
                        const data = await res.json();
                        const addr = data.address || {};
                        if (addr.country_code) {
                            window.__detectedCountryCode = addr.country_code.toLowerCase();
                        }

                        const houseNo = addr.house_number || addr.building || '';
                        const road = addr.road || addr.street || addr.residential || addr.neighbourhood || addr.suburb || '';
                        const city = addr.city || addr.town || addr.village || addr.municipality || addr.state_district || addr.county || 'Detected City';
                        const state = addr.state || addr.region || '';
                        const postcode = addr.postcode || '';

                        // Build clean exact address parts
                        const parts = [];
                        if (houseNo && road) {
                            parts.push(`${houseNo}, ${road}`);
                        } else if (road) {
                            parts.push(road);
                        }
                        if (addr.suburb && addr.suburb !== road) {
                            parts.push(addr.suburb);
                        }
                        if (city) parts.push(city);
                        if (state) parts.push(state);
                        if (postcode) parts.push(postcode);

                        let fullAddress = parts.join(', ');
                        if (!fullAddress || fullAddress.length < 5) {
                            fullAddress = data.display_name.split(',').slice(0, 4).join(', ');
                        }

                        applySelectedAddress(fullAddress, city, state);
                    } catch (err) {
                        console.warn('Nominatim reverse error, trying secondary reverse geocode:', err);
                        try {
                            const bdcRes = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${latitude}&longitude=${longitude}&localityLanguage=en`);
                            const bdcData = await bdcRes.json();
                            const city = bdcData.city || bdcData.locality || bdcData.principalSubdivision || 'Agra';
                            const state = bdcData.principalSubdivision || 'Uttar Pradesh';
                            const locality = bdcData.locality || '';
                            const full = [locality, city, state].filter(Boolean).join(', ') || `${city}, ${state}`;
                            applySelectedAddress(full, city, state);
                        } catch (e2) {
                            await fallbackToIP('Reverse geocode failed');
                        }
                    } finally {
                        btnTitle.textContent = 'Use my current location';
                        if (btnSub) btnSub.textContent = 'Detect location automatically using device GPS';
                    }
                },
                async (error) => {
                    console.warn('Geolocation error:', error.code, error.message);
                    btnTitle.textContent = 'Use my current location';
                    
                    if (error.code === 1) { // PERMISSION_DENIED
                        if (btnSub) btnSub.textContent = 'Permission denied in browser';
                        alert('Location permission blocked hai. Please browser ke URL address bar (top left lock icon) par click karke "Location: Allow" karein, ya neeche di gayi popular destinations me se select karein.');
                    } else if (error.code === 2) { // POSITION_UNAVAILABLE
                        if (btnSub) btnSub.textContent = 'GPS signal unavailable. Detecting via network...';
                        await fallbackToIP('Position unavailable');
                    } else if (error.code === 3) { // TIMEOUT
                        if (btnSub) btnSub.textContent = 'GPS timeout. Detecting via network...';
                        await fallbackToIP('GPS timeout');
                    } else {
                        await fallbackToIP('General error');
                    }
                },
                geoOptions
            );
        }

        // Apply chosen address
        function applyPresetAddress(address, city, state) {
            applySelectedAddress(address, city, state);
        }

        function applySelectedAddress(address, city, state) {
            wizardState.homeAddress = address;
            wizardState.city = city || '';
            wizardState.state = state || '';

            // Update Step 1 Pill
            const pillText = document.getElementById('pill-placeholder-text');
            pillText.textContent = address;
            pillText.classList.add('has-val');

            const badge = document.getElementById('pill-city-badge');
            badge.style.display = 'inline-flex';
            document.getElementById('pill-city-text').textContent = (city || 'Location') + (state ? ', ' + state : '');

            // Update modal input
            document.getElementById('modal-address-input').value = address;

            // Update hidden form inputs
            document.getElementById('f-homeAddress').value = address;
            document.getElementById('f-city').value = city;
            document.getElementById('f-state').value = state;

            // Default suggested title if empty
            if (!wizardState.homeName) {
                const titleField = document.getElementById('input-title');
                if (titleField && !titleField.value) {
                    titleField.value = `The Grand Villa in ${city || 'Sanctuary'}`;
                    wizardState.homeName = titleField.value;
                }
            }

            closeAddressModal();
        }

        // ── 4. Live Search Filter & Dynamic Nominatim Autocomplete ──
        let searchDebounceTimer = null;

        function handleAddressSearch(val) {
            const query = val.toLowerCase().trim();
            const items = document.querySelectorAll('.preset-destination-item');
            const headerLabel = document.getElementById('suggestions-header-label');
            const dynamicList = document.getElementById('dynamic-search-results');

            if (!query) {
                headerLabel.textContent = 'Popular Indian Destinations';
                items.forEach(item => item.style.display = 'flex');
                if (dynamicList) dynamicList.innerHTML = '';
                return;
            }

            headerLabel.textContent = `Matching Locations for "${val}"`;

            // Filter static destinations
            let localCount = 0;
            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                if (text.includes(query)) {
                    item.style.display = 'flex';
                    localCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Live OpenStreetMap Nominatim search with dynamic location awareness
            clearTimeout(searchDebounceTimer);
            if (query.length >= 2) {
                searchDebounceTimer = setTimeout(async () => {
                    try {
                        const results = await searchPlacesDynamically(query, 5);
                        
                        if (dynamicList) {
                            dynamicList.innerHTML = '';
                            results.forEach(place => {
                                const addr = place.address || {};
                                if (addr.country_code) {
                                    window.__detectedCountryCode = addr.country_code.toLowerCase();
                                }
                                const city = addr.city || addr.town || addr.village || addr.state_district || addr.county || '';
                                const state = addr.state || '';
                                const full = place.display_name.split(',').slice(0, 4).join(', ');

                                const div = document.createElement('div');
                                div.className = 'suggestion-item';
                                div.onclick = () => applyPresetAddress(full, city, state);
                                div.innerHTML = `
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    <span><strong>${city || place.name}</strong> &ndash; ${full}</span>
                                `;
                                dynamicList.appendChild(div);
                            });
                        }
                    } catch (e) {
                        console.warn('Live search error:', e);
                    }
                }, 280);
            }
        }

        // Also allow Enter key on modal input
        document.getElementById('modal-address-input').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const val = this.value.trim();
                if (val) {
                    const parts = val.split(',');
                    const city = parts.length > 1 ? parts[1].trim() : parts[0].trim();
                    const state = parts.length > 2 ? parts[2].trim() : '';
                    applySelectedAddress(val, city, state);
                }
            }
        });

        
        // ── 3. Step 4 Live Map Logic (Search Any Location & Auto-detect Device Location) ──
        let leafletMap = null;
        let mapSearchDebounce = null;
        let hasAutoDetectedLocation = false;

        function initOrUpdateMap() {
            const lat = wizardState.latitude || 28.6139;
            const lng = wizardState.longitude || 77.2090;

            const searchInput = document.getElementById('live-map-search-input');
            if (searchInput && !searchInput.value) {
                searchInput.value = wizardState.homeAddress || ((wizardState.city ? wizardState.city + ', ' : '') + (wizardState.state || 'India')).trim();
            }

            if (!leafletMap) {
                const mapEl = document.getElementById('live-pin-map');
                if (!mapEl) return;

                leafletMap = L.map('live-pin-map', {
                    center: [lat, lng],
                    zoom: 16,
                    zoomControl: true,
                    attributionControl: false
                });

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(leafletMap);

                // Update coordinates as user drags map
                leafletMap.on('move', function () {
                    const center = leafletMap.getCenter();
                    wizardState.latitude = center.lat;
                    wizardState.longitude = center.lng;
                    const fLat = document.getElementById('f-latitude');
                    const fLng = document.getElementById('f-longitude');
                    if (fLat) fLat.value = center.lat.toFixed(6);
                    if (fLng) fLng.value = center.lng.toFixed(6);
                });

                // On drag finish: reverse-geocode exact street and update input
                leafletMap.on('moveend', function () {
                    const center = leafletMap.getCenter();
                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${center.lat}&lon=${center.lng}&addressdetails=1`)
                        .then(r => r.json())
                        .then(data => {
                            if (data && data.address && data.address.country_code) {
                                window.__detectedCountryCode = data.address.country_code.toLowerCase();
                            }
                            if (data && data.display_name) {
                                const input = document.getElementById('live-map-search-input');
                                if (input) input.value = data.display_name;
                                wizardState.homeAddress = data.display_name;
                                const city = data.address.city || data.address.town || data.address.village || data.address.suburb || data.address.county || '';
                                const state = data.address.state || '';
                                if (city) wizardState.city = city;
                                if (state) wizardState.state = state;
                                
                                const fHome = document.getElementById('f-homeAddress'); if (fHome) fHome.value = data.display_name;
                                const fCity = document.getElementById('f-city'); if (fCity) fCity.value = wizardState.city;
                                const fState = document.getElementById('f-state'); if (fState) fState.value = wizardState.state;
                            }
                        })
                        .catch(() => {});
                });

                // Allow pressing Enter in map search input
                const sInput = document.getElementById('live-map-search-input');
                if (sInput) {
                    sInput.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            executeMapSearch();
                        }
                    });
                }
            }

            setTimeout(() => {
                if (leafletMap) {
                    leafletMap.invalidateSize();
                    
                    // If no address specified yet, auto-detect device location by default!
                    if (!hasAutoDetectedLocation && (!wizardState.homeAddress || wizardState.homeAddress.toLowerCase().includes('india'))) {
                        detectCurrentDeviceLocation(false);
                    } else {
                        geocodeAndPan();
                    }
                }
            }, 250);
        }

        // Live typing search autocomplete with dynamic location awareness
        function handleMapSearchInput(val) {
            clearTimeout(mapSearchDebounce);
            const dropdown = document.getElementById('map-suggestions-dropdown');
            const query = val.trim();

            if (!query || query.length < 2) {
                if (dropdown) { dropdown.style.display = 'none'; dropdown.innerHTML = ''; }
                return;
            }

            mapSearchDebounce = setTimeout(async () => {
                try {
                    const results = await searchPlacesDynamically(query, 6);
                    if (!dropdown) return;

                    if (!results || results.length === 0) {
                        dropdown.style.display = 'none';
                        return;
                    }

                    dropdown.innerHTML = '';
                    results.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'map-suggestion-item';
                        
                        const displayName = item.display_name;
                        const parts = displayName.split(',').map(s => s.trim());
                        const primary = parts[0] || displayName;
                        const secondary = parts.slice(1, 4).join(', ');

                        div.innerHTML = `
                            <svg class="map-suggestion-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                            </svg>
                            <div style="display:flex; flex-direction:column; gap:2px; overflow:hidden;">
                                <strong style="color:var(--text-primary); font-size:13.5px; font-weight:600; white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">${primary}</strong>
                                ${secondary ? `<span style="font-size:11.5px; color:var(--text-muted); white-space:nowrap; text-overflow:ellipsis; overflow:hidden;">${secondary}</span>` : ''}
                            </div>
                        `;
                        div.onclick = () => {
                            applyMapSearchSelection(item);
                        };
                        dropdown.appendChild(div);
                    });
                    dropdown.style.display = 'block';
                } catch (e) {
                    console.warn('Map autocomplete error:', e);
                }
            }, 260);
        }

        // Execute search on Enter or button click
        async function executeMapSearch() {
            const input = document.getElementById('live-map-search-input');
            const dropdown = document.getElementById('map-suggestions-dropdown');
            if (dropdown) dropdown.style.display = 'none';
            if (!input || !input.value.trim()) return;

            const query = input.value.trim();
            try {
                const results = await searchPlacesDynamically(query, 1);
                if (results && results.length > 0) {
                    applyMapSearchSelection(results[0]);
                } else {
                    alert('Location not found. Please try searching with city and state (e.g. "Lovely Professional University, Phagwara" or "Munnar, Kerala").');
                }
            } catch (err) {
                console.error('Search failed:', err);
            }
        }

        function applyMapSearchSelection(item) {
            const dropdown = document.getElementById('map-suggestions-dropdown');
            if (dropdown) dropdown.style.display = 'none';

            const lat = parseFloat(item.lat);
            const lon = parseFloat(item.lon);
            wizardState.latitude = lat;
            wizardState.longitude = lon;
            wizardState.homeAddress = item.display_name;

            const addr = item.address || {};
            if (addr.country_code) {
                window.__detectedCountryCode = addr.country_code.toLowerCase();
            }
            wizardState.city = addr.city || addr.town || addr.village || addr.suburb || addr.state_district || '';
            wizardState.state = addr.state || '';

            const input = document.getElementById('live-map-search-input');
            if (input) input.value = item.display_name;

            const fHome = document.getElementById('f-homeAddress'); if (fHome) fHome.value = item.display_name;
            const fCity = document.getElementById('f-city'); if (fCity) fCity.value = wizardState.city;
            const fState = document.getElementById('f-state'); if (fState) fState.value = wizardState.state;
            const fLat = document.getElementById('f-latitude'); if (fLat) fLat.value = lat.toFixed(6);
            const fLng = document.getElementById('f-longitude'); if (fLng) fLng.value = lon.toFixed(6);

            if (leafletMap) {
                leafletMap.flyTo([lat, lon], 16, { duration: 1.5 });
            }
        }

        // Automatic and Manual GPS Detection for Current Device
        function detectCurrentDeviceLocation(showFeedback = false) {
            const locateBtn = document.getElementById('btn-locate-me');
            if (locateBtn) locateBtn.classList.add('locating');

            if (!navigator.geolocation) {
                if (locateBtn) locateBtn.classList.remove('locating');
                if (showFeedback) alert('Geolocation is not supported by your browser.');
                return;
            }

            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    hasAutoDetectedLocation = true;
                    if (locateBtn) locateBtn.classList.remove('locating');
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    wizardState.latitude = lat;
                    wizardState.longitude = lon;

                    if (leafletMap) {
                        leafletMap.flyTo([lat, lon], 16, { duration: 1.5 });
                    }

                    // Reverse geocode to get street level details
                    try {
                        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&addressdetails=1`);
                        const data = await res.json();
                        if (data && data.display_name) {
                            const addr = data.address || {};
                            if (addr.country_code) {
                                window.__detectedCountryCode = addr.country_code.toLowerCase();
                            }
                            const input = document.getElementById('live-map-search-input');
                            if (input) input.value = data.display_name;
                            wizardState.homeAddress = data.display_name;
                            wizardState.city = addr.city || addr.town || addr.village || addr.suburb || '';
                            wizardState.state = addr.state || '';

                            const fHome = document.getElementById('f-homeAddress'); if (fHome) fHome.value = data.display_name;
                            const fCity = document.getElementById('f-city'); if (fCity) fCity.value = wizardState.city;
                            const fState = document.getElementById('f-state'); if (fState) fState.value = wizardState.state;
                            const fLat = document.getElementById('f-latitude'); if (fLat) fLat.value = lat.toFixed(6);
                            const fLng = document.getElementById('f-longitude'); if (fLng) fLng.value = lon.toFixed(6);
                        }
                    } catch (e) {
                        console.warn('Reverse geocode error:', e);
                    }
                },
                (err) => {
                    if (locateBtn) locateBtn.classList.remove('locating');
                    console.warn('Geolocation position error:', err);
                    if (showFeedback) {
                        alert('Could not detect exact GPS position. Please check your browser location permission or use the search bar above to type your location.');
                    }
                },
                { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
            );
        }

