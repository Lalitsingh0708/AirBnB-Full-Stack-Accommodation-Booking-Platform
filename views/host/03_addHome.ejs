        </div>

        <!-- ══ STEP 3: CATEGORY SELECTION ══ -->
        <div class="step-container" id="step-3">
            <div style="text-align: center; max-width: 680px; margin: 0 auto 36px auto;">
                <span class="step-tag">Step 1.1 &bull; Architectural Structure</span>
                <h2 class="step-headline" style="font-size: 42px;">Which of these best describes your <em>place?</em></h2>
                <p class="step-sub" style="margin: 0 auto;">Select an architectural category that captures the spirit and style of your accommodation.</p>
            </div>

                        <div class="category-grid">
                <!-- 1. House -->
                <div class="category-card selected" onclick="selectCategory('House', this)">
                    <div class="category-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
                    </div>
                    <div class="category-title">House</div>
                    <p class="category-desc">A standalone residential home, often with private yard and living spaces.</p>
                </div>

                <!-- 2. Flat/apartment -->
                <div class="category-card" onclick="selectCategory('Flat/apartment', this)">
                    <div class="category-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
