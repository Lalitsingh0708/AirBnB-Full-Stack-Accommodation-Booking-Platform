        function openWeekendAdjustModal() {
            const overlay = document.getElementById('weekend-adjust-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closeWeekendAdjustModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('weekend-adjust-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        function openDiscountsInfoModal() {
            const overlay = document.getElementById('discounts-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closeDiscountsInfoModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('discounts-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        function toggleDiscount(type) {
            if (!wizardState.discounts) {
                wizardState.discounts = {
                    newListingPromotion: true,
                    lastMinuteDiscount: 7,
                    weeklyDiscount: 10,
                    monthlyDiscount: 20
                };
            }

            if (type === 'newListingPromotion') {
                wizardState.discounts.newListingPromotion = !wizardState.discounts.newListingPromotion;
                const card = document.getElementById('card-discount-newlisting');
                if (card) card.classList.toggle('selected', wizardState.discounts.newListingPromotion);
            } else if (type === 'lastMinuteDiscount') {
                const isActive = (wizardState.discounts.lastMinuteDiscount && wizardState.discounts.lastMinuteDiscount > 0);
                wizardState.discounts.lastMinuteDiscount = isActive ? 0 : 7;
                const card = document.getElementById('card-discount-lastminute');
                if (card) card.classList.toggle('selected', !isActive);
            } else if (type === 'weeklyDiscount') {
                const isActive = (wizardState.discounts.weeklyDiscount && wizardState.discounts.weeklyDiscount > 0);
                wizardState.discounts.weeklyDiscount = isActive ? 0 : 10;
                const card = document.getElementById('card-discount-weekly');
                if (card) card.classList.toggle('selected', !isActive);
            } else if (type === 'monthlyDiscount') {
                const isActive = (wizardState.discounts.monthlyDiscount && wizardState.discounts.monthlyDiscount > 0);
                wizardState.discounts.monthlyDiscount = isActive ? 0 : 20;
                const card = document.getElementById('card-discount-monthly');
                if (card) card.classList.toggle('selected', !isActive);
            }

            syncDiscountInputs();
        }

        function syncDiscountInputs() {
            if (!wizardState.discounts) return;
            const fDiscounts = document.getElementById('f-discounts');
            if (fDiscounts) fDiscounts.value = JSON.stringify(wizardState.discounts);
            const fDiscNew = document.getElementById('f-discountNewListing');
            if (fDiscNew) fDiscNew.value = wizardState.discounts.newListingPromotion ? 'true' : 'false';
            const fDiscLast = document.getElementById('f-discountLastMinute');
            if (fDiscLast) fDiscLast.value = wizardState.discounts.lastMinuteDiscount || 0;
            const fDiscWeekly = document.getElementById('f-discountWeekly');
            if (fDiscWeekly) fDiscWeekly.value = wizardState.discounts.weeklyDiscount || 0;
            const fDiscMonthly = document.getElementById('f-discountMonthly');
            if (fDiscMonthly) fDiscMonthly.value = wizardState.discounts.monthlyDiscount || 0;
        }

        function openSafetyInfoModal() {
            const overlay = document.getElementById('safety-info-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closeSafetyInfoModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('safety-info-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        function openLocalLawsModal() {
            const overlay = document.getElementById('local-laws-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closeLocalLawsModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('local-laws-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        function openPolicyModal() {
            const overlay = document.getElementById('policy-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closePolicyModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('policy-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        function toggleSafetyItem(key) {
            if (!wizardState.safetyDetails) {
                wizardState.safetyDetails = {
                    securityCameras: false,
                    noiseMonitors: false,
                    weapons: false
                };
            }
            wizardState.safetyDetails[key] = !wizardState.safetyDetails[key];
            const opt = document.getElementById('opt-safety-' + key);
            if (opt) opt.classList.toggle('checked', !!wizardState.safetyDetails[key]);
            syncSafetyInputs();
        }

        function syncSafetyInputs() {
            if (!wizardState.safetyDetails) return;
            const fSafety = document.getElementById('f-safetyDetails');
            if (fSafety) fSafety.value = JSON.stringify(wizardState.safetyDetails);
            const fCam = document.getElementById('f-securityCameras');
            if (fCam) fCam.value = wizardState.safetyDetails.securityCameras ? 'true' : 'false';
            const fNoise = document.getElementById('f-noiseMonitors');
            if (fNoise) fNoise.value = wizardState.safetyDetails.noiseMonitors ? 'true' : 'false';
            const fWeap = document.getElementById('f-weapons');
            if (fWeap) fWeap.value = wizardState.safetyDetails.weapons ? 'true' : 'false';
        }

        function onResidentialFieldChange() {
            const countryEl = document.getElementById('res-input-country');
            const flatEl = document.getElementById('res-input-flat');
            const streetEl = document.getElementById('res-input-street');
            const landmarkEl = document.getElementById('res-input-landmark');
            const districtEl = document.getElementById('res-input-district');
            const cityEl = document.getElementById('res-input-city');
            const stateEl = document.getElementById('res-input-state');
            const pinEl = document.getElementById('res-input-pincode');

            if (!wizardState.residentialAddress) {
                wizardState.residentialAddress = {};
            }

            wizardState.residentialAddress.country = countryEl ? countryEl.value : 'India';
            wizardState.residentialAddress.flat = flatEl ? flatEl.value.trim() : '';
            wizardState.residentialAddress.street = streetEl ? streetEl.value.trim() : '';
            wizardState.residentialAddress.landmark = landmarkEl ? landmarkEl.value.trim() : '';
            wizardState.residentialAddress.district = districtEl ? districtEl.value.trim() : '';
            wizardState.residentialAddress.city = cityEl ? cityEl.value.trim() : '';
            wizardState.residentialAddress.state = stateEl ? stateEl.value.trim() : '';
            wizardState.residentialAddress.pinCode = pinEl ? pinEl.value.trim() : '';

            syncResidentialInputs();
        }

        function syncResidentialInputs() {
            if (!wizardState.residentialAddress) return;
            const res = wizardState.residentialAddress;
            const fRes = document.getElementById('f-residentialAddress');
            if (fRes) fRes.value = JSON.stringify(res);
            const fC = document.getElementById('f-residentialCountry'); if (fC) fC.value = res.country || 'India';
            const fF = document.getElementById('f-residentialFlat'); if (fF) fF.value = res.flat || '';
            const fS = document.getElementById('f-residentialStreet'); if (fS) fS.value = res.street || '';
            const fL = document.getElementById('f-residentialLandmark'); if (fL) fL.value = res.landmark || '';
            const fD = document.getElementById('f-residentialDistrict'); if (fD) fD.value = res.district || '';
            const fCi = document.getElementById('f-residentialCity'); if (fCi) fCi.value = res.city || '';
            const fSt = document.getElementById('f-residentialState'); if (fSt) fSt.value = res.state || '';
            const fP = document.getElementById('f-residentialPinCode'); if (fP) fP.value = res.pinCode || '';
        }

        function updateFooterBar() {
            // 3-Segment Airbnb Progress Calculation
            let seg1 = 0, seg2 = 0, seg3 = 0;
            if (currentStep <= 7) {
                seg1 = Math.round((currentStep / 7) * 100);
                seg2 = 0;
                seg3 = 0;
            } else if (currentStep <= 13) {
                seg1 = 100;
                seg2 = Math.round(((currentStep - 7) / 6) * 100);
                seg3 = 0;
            } else if (currentStep === 14) {
                // Step 3 Intro (Finish up and publish) matching screenshot
                seg1 = 100;
                seg2 = 100;
                seg3 = 0;
            } else if (currentStep === 15) {
                // Step 15: Booking Settings matching screenshot
                seg1 = 100;
                seg2 = 100;
                seg3 = 35;
            } else if (currentStep === 16) {
                // Step 16: Now, set your prices matching screenshot
                seg1 = 100;
                seg2 = 100;
                seg3 = 68;
            } else if (currentStep === 17) {
                // Step 17: Add discounts matching screenshot
                seg1 = 100;
                seg2 = 100;
                seg3 = 85;
            } else if (currentStep === 18) {
                // Step 18: Share safety details matching screenshot
                seg1 = 100;
                seg2 = 100;
                seg3 = 93;
            } else {
                // Final Step 19: Provide a few final details (Matching screenshot: 100% full!)
                seg1 = 100;
                seg2 = 100;
                seg3 = 100;
            }

            const s1 = document.getElementById('seg-fill-1'); if (s1) s1.style.width = seg1 + '%';
            const s2 = document.getElementById('seg-fill-2'); if (s2) s2.style.width = seg2 + '%';
            const s3 = document.getElementById('seg-fill-3'); if (s3) s3.style.width = seg3 + '%';
            const pbf = document.getElementById('progress-bar-fill'); if (pbf) pbf.style.width = Math.round((currentStep / totalSteps) * 100) + '%';

            // Back button
            const backBtn = document.getElementById('btn-back');
            if (backBtn) backBtn.disabled = (currentStep === 1);

            // Next button text & styling
            const nextBtn = document.getElementById('btn-next');
            if (!nextBtn) return;

            if (currentStep === totalSteps) {
                nextBtn.disabled = false;
                nextBtn.classList.remove('disabled-state');
                nextBtn.innerHTML = `<span>Create listing</span>`;
                nextBtn.style.padding = '14px 36px';
            } else {
                nextBtn.innerHTML = `<span>Next</span>`;
                nextBtn.style.padding = '14px 34px';

                if (currentStep === 10) {
                    const count = (wizardState.photos && wizardState.photos.length) || 0;
                    if (count < 5) {
                        nextBtn.disabled = true;
                        nextBtn.classList.add('disabled-state');
                    } else {
                        nextBtn.disabled = false;
                        nextBtn.classList.remove('disabled-state');
                    }
                } else if (currentStep === 11) {
                    const name = (wizardState.homeName && wizardState.homeName.trim()) || '';
                    if (!name) {
                        nextBtn.disabled = true;
                        nextBtn.classList.add('disabled-state');
                    } else {
                        nextBtn.disabled = false;
                        nextBtn.classList.remove('disabled-state');
                    }
                } else if (currentStep === 13) {
                    const desc = (wizardState.description && wizardState.description.trim()) || '';
                    if (!desc) {
                        nextBtn.disabled = true;
                        nextBtn.classList.add('disabled-state');
                    } else {
                        nextBtn.disabled = false;
                        nextBtn.classList.remove('disabled-state');
                    }
                } else if (currentStep === 16) {
                    const price = wizardState.homePrice || 0;
                    if (price <= 0) {
                        nextBtn.disabled = true;
                        nextBtn.classList.add('disabled-state');
                    } else {
                        nextBtn.disabled = false;
                        nextBtn.classList.remove('disabled-state');
                    }
                } else {
                    nextBtn.disabled = false;
                    nextBtn.classList.remove('disabled-state');
                }
            }
        }

        // ── 11. Form Submission ──
        function submitListingForm() {
            syncDiscountInputs();
            syncSafetyInputs();
            syncResidentialInputs();
            document.getElementById('f-propertyType').value = wizardState.propertyType;
            const fPlace = document.getElementById('f-placeType'); if (fPlace) fPlace.value = wizardState.placeType;
            const fLat = document.getElementById('f-latitude'); if (fLat) fLat.value = wizardState.latitude;
            const fLng = document.getElementById('f-longitude'); if (fLng) fLng.value = wizardState.longitude;
            const fPrecise = document.getElementById('f-showPreciseLocation'); if (fPrecise) fPrecise.value = wizardState.showPreciseLocation;
            document.getElementById('f-homeAddress').value = wizardState.homeAddress;
            document.getElementById('f-city').value = wizardState.city;
            document.getElementById('f-state').value = wizardState.state;
            document.getElementById('f-maxGuests').value = wizardState.maxGuests;
            document.getElementById('f-bedrooms').value = wizardState.bedrooms;
            document.getElementById('f-beds').value = wizardState.beds;
            document.getElementById('f-bathrooms').value = wizardState.bathrooms;
            document.getElementById('f-amenities').value = wizardState.amenities.join(',');
            document.getElementById('f-housePhoto').value = wizardState.housePhoto;
            document.getElementById('f-homeName').value = wizardState.homeName;
            document.getElementById('f-description').value = wizardState.description;
            document.getElementById('f-homePrice').value = wizardState.homePrice;
            const fHigh = document.getElementById('f-highlights'); if (fHigh) fHigh.value = (wizardState.highlights || []).join(',');
            const fPhotos = document.getElementById('f-photos'); if (fPhotos) fPhotos.value = JSON.stringify(wizardState.photos || []);
            const fBook = document.getElementById('f-bookingSettings'); if (fBook) fBook.value = wizardState.bookingSettings || 'approve_first_5';
            const fWPrice = document.getElementById('f-weekendPrice'); if (fWPrice) fWPrice.value = wizardState.weekendPrice || 2460;
            const fWAdj = document.getElementById('f-weekendAdjustment'); if (fWAdj) fWAdj.value = wizardState.weekendAdjustment !== undefined ? wizardState.weekendAdjustment : 6;

            // Submit form
            document.getElementById('airbnb-listing-form').submit();
        }

        // ── 12. Page Initializer ──
        window.addEventListener('DOMContentLoaded', () => {
            updateFooterBar();
            updatePhotosStepTitle();
            updateTitleStepHeading();
            updateDescribeStep();
            initCreateDescStep();
            setupDropzoneEvents();
        });
    </script>
