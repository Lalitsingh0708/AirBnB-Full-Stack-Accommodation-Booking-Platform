        <input type="hidden" name="bookingSettings" id="f-bookingSettings" value="approve_first_5" />
        <input type="hidden" name="weekendPrice" id="f-weekendPrice" value="2460" />
        <input type="hidden" name="weekendAdjustment" id="f-weekendAdjustment" value="6" />
        <input type="hidden" name="discounts" id="f-discounts" value='{"newListingPromotion":true,"lastMinuteDiscount":7,"weeklyDiscount":10,"monthlyDiscount":20}' />
        <input type="hidden" name="discountNewListing" id="f-discountNewListing" value="true" />
