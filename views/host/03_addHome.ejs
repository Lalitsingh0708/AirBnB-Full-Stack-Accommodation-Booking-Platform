                const isSelected = wizardState.highlights && wizardState.highlights.includes(item.key);
                html += `
                    <div class="airbnb-highlight-pill ${isSelected ? 'selected' : ''}" data-key="${item.key}" onclick="toggleHighlight('${item.key}', this)">
                        <span class="highlight-icon-svg">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                ${item.icon}
                            </svg>
                        </span>
                        <span>${item.label}</span>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        function toggleHighlight(key, el) {
            if (!wizardState.highlights) wizardState.highlights = [];
            const idx = wizardState.highlights.indexOf(key);
            if (idx > -1) {
                wizardState.highlights.splice(idx, 1);
                el.classList.remove('selected');
            } else {
                if (wizardState.highlights.length >= 2) {
                    const oldest = wizardState.highlights.shift();
                    const oldEl = document.querySelector(`.airbnb-highlight-pill[data-key="${oldest}"]`);
                    if (oldEl) oldEl.classList.remove('selected');
                }
                wizardState.highlights.push(key);
                el.classList.add('selected');
            }
            generateDynamicDescription();
        }

        function generateDynamicDescription() {
            const prop = wizardState.propertyType ? wizardState.propertyType.toLowerCase() : 'place';
            const highlights = wizardState.highlights || [];
            
            let starter = '';
            if (highlights.length === 2) {
                starter = `You'll always remember your time at this ${highlights[0].toLowerCase()} and ${highlights[1].toLowerCase()} ${prop} to stay.`;
            } else if (highlights.length === 1) {
                starter = `You'll always remember your time at this ${highlights[0].toLowerCase()} ${prop} to stay.`;
            } else {
                starter = `You'll always remember your time at this unique place to stay.`;
            }

            wizardState.description = starter;
            const descEl = document.getElementById('input-desc');
            if (descEl) {
                descEl.value = starter;
            }
            const counter = document.getElementById('desc-char-counter');
            if (counter) {
                counter.textContent = `${starter.length}/500`;
            }
            const fDesc = document.getElementById('f-description');
            if (fDesc) fDesc.value = starter;
        }

        function initCreateDescStep() {
            const descEl = document.getElementById('input-desc');
            const counter = document.getElementById('desc-char-counter');
            if (!wizardState.description || !wizardState.description.trim()) {
                generateDynamicDescription();
            } else {
                if (descEl) descEl.value = wizardState.description;
                if (counter) counter.textContent = `${wizardState.description.length}/500`;
            }
        }

        function onDescriptionInputChange(val) {
            wizardState.description = val;
            const counter = document.getElementById('desc-char-counter');
            if (counter) counter.textContent = `${(val || '').length}/500`;
            const fDesc = document.getElementById('f-description');
            if (fDesc) fDesc.value = val;
            updateFooterBar();
        }

        function onDescriptionTextChange(val) {
            onDescriptionInputChange(val);
        }

        function updateDescribeStep() {
            const prop = wizardState.propertyType ? wizardState.propertyType.toLowerCase() : 'place';
            const heading = document.getElementById('airbnb-describe-heading');
            if (heading) heading.textContent = `Next, let's describe your ${prop}`;

            const titleText = document.getElementById('description-preview-title-text');
            if (titleText) titleText.textContent = `Crafted description for your ${prop}`;

            renderDynamicCategoryHighlights();
            if (!wizardState.description) {
                generateDynamicDescription();
            }
        }

        function syncCategoryToAllSteps() {
            updatePhotosStepTitle();
            updateTitleStepHeading();
            updateDescribeStep();
        }

        // ── 8. Price Estimate ──
        function updatePriceEstimate(val) {
            const price = Number(val) || 0;
            wizardState.homePrice = price;
            const dispBase = document.getElementById('disp-base-price');
            if (dispBase) dispBase.textContent = '₹' + price.toLocaleString('en-IN');
            const dispPayout = document.getElementById('disp-payout-price');
            if (dispPayout) dispPayout.textContent = '₹' + Math.round(price * 0.97).toLocaleString('en-IN');
            const revPrice = document.getElementById('review-price-disp');
            if (revPrice) revPrice.innerHTML = '₹' + price.toLocaleString('en-IN') + ' <span style="font-size: 12px; font-weight: 400; color: #6B7770;">/ night</span>';
            const cardPrice = document.getElementById('disp-card-base-price');
            if (cardPrice) cardPrice.textContent = price.toLocaleString('en-IN');
        }

        // ── 9. Step 5 Leaflet Privacy Map & Precision Toggle ──
        let privacyLeafletMap = null;
        let privacyExactMarker = null;
        let privacyApproxCircle = null;

        function initOrUpdatePrivacyMap() {
            const lat = wizardState.latitude || 28.6139;
            const lon = wizardState.longitude || 77.2090;

            // Update top floating address pill text
            const pillText = document.getElementById('privacy-address-pill-text');
            if (pillText) {
                pillText.textContent = wizardState.homeAddress || `${wizardState.city ? wizardState.city + ', ' : ''}${wizardState.state || 'India'}`;
            }

            setTimeout(() => {
                const mapEl = document.getElementById('privacy-leaflet-map');
                if (!mapEl) return;

                if (!privacyLeafletMap) {
                    privacyLeafletMap = L.map('privacy-leaflet-map', {
                        zoomControl: false,
                        attributionControl: false,
                        dragging: true,
                        scrollWheelZoom: false,
                        doubleClickZoom: true
                    }).setView([lat, lon], 15);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(privacyLeafletMap);

                    // Custom house pin icon matching Step 4 badge
                    const pinIcon = L.divIcon({
                        className: 'custom-privacy-marker',
                        html: `
                            <div class="map-center-badge" style="transform: translateY(-50%); box-shadow: 0 4px 14px rgba(0,0,0,0.35); pointer-events: none;">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                            </div>
                        `,
                        iconSize: [44, 44],
                        iconAnchor: [22, 22]
                    });

                    privacyExactMarker = L.marker([lat, lon], { icon: pinIcon });

                    // Soft neighborhood approximate circular zone (~500m radius)
                    privacyApproxCircle = L.circle([lat, lon], {
                        radius: 500,
                        color: '#143528',
                        fillColor: '#1D4333',
                        fillOpacity: 0.16,
                        weight: 2,
                        dashArray: '6, 6'
                    });
                } else {
                    privacyLeafletMap.setView([lat, lon], 15);
                    if (privacyExactMarker) privacyExactMarker.setLatLng([lat, lon]);
                    if (privacyApproxCircle) privacyApproxCircle.setLatLng([lat, lon]);
                    privacyLeafletMap.invalidateSize();
                }

                syncPrivacyMapLayers();
            }, 120);
        }

        function syncPrivacyMapLayers() {
            if (!privacyLeafletMap) return;
            const toggleBtn = document.getElementById('privacy-toggle-btn');
            const hiddenInput = document.getElementById('f-showPreciseLocation');

            if (wizardState.showPreciseLocation) {
                if (toggleBtn) toggleBtn.classList.add('active');
                if (hiddenInput) hiddenInput.value = 'true';
                if (privacyApproxCircle && privacyLeafletMap.hasLayer(privacyApproxCircle)) {
                    privacyLeafletMap.removeLayer(privacyApproxCircle);
                }
                if (privacyExactMarker && !privacyLeafletMap.hasLayer(privacyExactMarker)) {
                    privacyExactMarker.addTo(privacyLeafletMap);
                }
            } else {
                if (toggleBtn) toggleBtn.classList.remove('active');
                if (hiddenInput) hiddenInput.value = 'false';
                if (privacyExactMarker && privacyLeafletMap.hasLayer(privacyExactMarker)) {
                    privacyLeafletMap.removeLayer(privacyExactMarker);
                }
                if (privacyApproxCircle && !privacyLeafletMap.hasLayer(privacyApproxCircle)) {
                    privacyApproxCircle.addTo(privacyLeafletMap);
                }
            }
        }

        function togglePreciseLocation() {
            wizardState.showPreciseLocation = !wizardState.showPreciseLocation;
            syncPrivacyMapLayers();
        }

        function openPrivacyInfoModal() {
            const overlay = document.getElementById('privacy-modal-overlay');
            if (overlay) overlay.classList.add('open');
        }

        function closePrivacyInfoModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const overlay = document.getElementById('privacy-modal-overlay');
            if (overlay) overlay.classList.remove('open');
        }

        // ── 10. Step Navigation Logic ──
        function navigateStep(direction) {
            // Validation before going forward
            if (direction === 1) {
                if (currentStep === 1) {
                    // Step 1 is Address selection
                    if (!wizardState.homeAddress) {
                        openAddressModal();
                        return;
                    }
                } else if (currentStep === 10) {
                    // Step 10 is Photo input (Step 2.2)
                    const count = (wizardState.photos && wizardState.photos.length) || 0;
                    if (count < 5) {
                        alert("You’ll need 5 photos to get started. You can upload photos or pick one of our instant curated collections.");
                        return;
                    }
                    wizardState.housePhoto = wizardState.photos[0];
                    const inp = document.getElementById('input-photo');
                    if (inp) inp.value = wizardState.housePhoto;
                } else if (currentStep === 11) {
                    // Step 11 is Title input
                    const title = document.getElementById('input-title').value.trim();
                    if (!title) {
                        alert('Please provide a title for your sanctuary.');
                        document.getElementById('input-title').focus();
                        return;
                    }
                    wizardState.homeName = title;
                } else if (currentStep === 12) {
                    // Step 12 is Describe & Highlights
                    initCreateDescStep();
                } else if (currentStep === 13) {
                    // Step 13 is Create your description
                    const descEl = document.getElementById('input-desc');
                    const descVal = descEl ? descEl.value.trim() : '';
                    if (!descVal) {
                        alert('Please share a short description of what makes your place special.');
                        if (descEl) descEl.focus();
                        return;
                    }
                    wizardState.description = descVal;
                    const fDesc = document.getElementById('f-description');
                    if (fDesc) fDesc.value = descVal;
                } else if (currentStep === 14) {
                    // Step 14 is Step 3 Intro: Finish up and publish
                } else if (currentStep === 15) {
                    // Step 15 is Pick your booking settings
                    const fBook = document.getElementById('f-bookingSettings');
                    if (fBook) fBook.value = wizardState.bookingSettings || 'approve_first_5';
                } else if (currentStep === 16) {
                    // Step 16 is "Now, set your prices"
                    let val = Number(wizardState.homePrice) || 0;
                    const modalInput = document.getElementById('modal-base-price-input');
                    if (modalInput && modalInput.value) {
                        const parsed = parseInt(modalInput.value.replace(/[^\d]/g, ''), 10);
                        if (parsed > 0) val = parsed;
                    }
                    if (!val || val <= 0) {
                        val = 2321;
                    }
                    wizardState.homePrice = val;
                    const pct = wizardState.weekendAdjustment !== undefined ? wizardState.weekendAdjustment : 6;
                    wizardState.weekendPrice = Math.round(val * (1 + pct / 100));
                    updatePriceEstimate(val);
                    const dispW = document.getElementById('disp-final-weekend-price');
                    if (dispW) dispW.textContent = '₹' + wizardState.weekendPrice.toLocaleString('en-IN') + ' / night';
                    const fPrice = document.getElementById('f-homePrice'); if (fPrice) fPrice.value = val;
                    const fWPrice = document.getElementById('f-weekendPrice'); if (fWPrice) fWPrice.value = wizardState.weekendPrice;
                    const fWAdj = document.getElementById('f-weekendAdjustment'); if (fWAdj) fWAdj.value = pct;
                } else if (currentStep === 17) {
                    // Step 17 is Add discounts
                    syncDiscountInputs();
                } else if (currentStep === 18) {
                    // Step 18 is Share safety details
                    syncSafetyInputs();
                } else if (currentStep === 19) {
                    // Step 19 is Provide a few final details -> Submit listing!
                    onResidentialFieldChange();
                    syncResidentialInputs();
                    submitListingForm();
                    return;
                }
            }

            // Move step
            document.getElementById('step-' + currentStep).classList.remove('active');
            currentStep += direction;
            currentStep = Math.max(1, Math.min(totalSteps, currentStep));
            document.getElementById('step-' + currentStep).classList.add('active');
            
            if (currentStep === 2) {
                triggerHouseRebuildAnimation();
            } else if (currentStep === 5) {
                initOrUpdateMap();
            } else if (currentStep === 6) {
                initOrUpdatePrivacyMap();
            } else if (currentStep === 8) {
                triggerHouseFurnishAnimation();
            } else if (currentStep === 10) {
                updatePhotosStepTitle();
                setupDropzoneEvents();
            } else if (currentStep === 11) {
                updateTitleStepHeading();
                setTimeout(() => {
                    const t = document.getElementById('input-title');
                    if (t) t.focus();
                }, 100);
            } else if (currentStep === 12) {
                updateDescribeStep();
            } else if (currentStep === 13) {
                initCreateDescStep();
                setTimeout(() => {
                    const d = document.getElementById('input-desc');
                    if (d) {
                        d.focus();
                        d.setSelectionRange(d.value.length, d.value.length);
                    }
                }, 100);
            } else if (currentStep === 16) {
                const cardDisp = document.getElementById('disp-card-base-price');
                if (cardDisp) {
                    cardDisp.textContent = Number(wizardState.homePrice || 2321).toLocaleString('en-IN');
                }
                const calcDisp = document.getElementById('disp-weekend-calc');
                if (calcDisp) {
                    calcDisp.textContent = `₹${(wizardState.weekendPrice || 2460).toLocaleString('en-IN')} for Fri and Sat`;
                }
            } else if (currentStep === 17) {
                syncDiscountInputs();
            } else if (currentStep === 18) {
                syncSafetyInputs();
                const saf = wizardState.safetyDetails || {};
                const cCam = document.getElementById('opt-safety-securityCameras');
                if (cCam) cCam.classList.toggle('checked', !!saf.securityCameras);
                const cNoise = document.getElementById('opt-safety-noiseMonitors');
                if (cNoise) cNoise.classList.toggle('checked', !!saf.noiseMonitors);
                const cWeap = document.getElementById('opt-safety-weapons');
                if (cWeap) cWeap.classList.toggle('checked', !!saf.weapons);
            } else if (currentStep === 19) {
                // Populate Step 19 residential address inputs with defaults if empty
                if (wizardState.residentialAddress) {
                    if (!wizardState.residentialAddress.city && wizardState.city) {
                        wizardState.residentialAddress.city = wizardState.city;
                    }
                    if (!wizardState.residentialAddress.state && wizardState.state) {
                        wizardState.residentialAddress.state = wizardState.state;
                    }
                    const cityEl = document.getElementById('res-input-city');
                    if (cityEl && !cityEl.value) cityEl.value = wizardState.residentialAddress.city;
                    const stateEl = document.getElementById('res-input-state');
                    if (stateEl && !stateEl.value) stateEl.value = wizardState.residentialAddress.state;
                    const countryEl = document.getElementById('res-input-country');
                    if (countryEl) countryEl.value = wizardState.residentialAddress.country || 'India';
                }
                syncResidentialInputs();
            }

            // Scroll to top of stage
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Update footer
            updateFooterBar();
        }

        // ── Step 2 Furnished House Animation Controllers ──
        function triggerHouseFurnishAnimation() {
            const stage = document.getElementById('house-stage-step2');
            const pillText = document.getElementById('furnish-phase-text');
            if (!stage) return;

            stage.classList.remove('constructing');
            void stage.offsetWidth; // Force reflow
            stage.classList.add('constructing');

            if (pillText) {
                pillText.textContent = 'Styling & Furnishing Interior...';
                setTimeout(() => {
                    if (pillText) pillText.textContent = 'Interior Styling & Amenities • Stage Complete';
                }, 3300);
            }
        }

        function handleHouseArenaMouseMoveStep2(e) {
            const arena = document.getElementById('house-arena-step2');
            const stage = document.getElementById('house-stage-step2');
            if (!arena || !stage) return;

            const rect = arena.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateX = ((centerY - y) / centerY) * 12;
            const rotateY = ((x - centerX) / centerX) * 16;

            stage.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        }

        function resetHouseArenaTiltStep2() {
            const stage = document.getElementById('house-stage-step2');
            if (!stage) return;
            stage.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }

        // ── Step 3 Completed House Arena Controllers ──
        function handleHouseArenaMouseMoveStep3(e) {
            const arena = document.getElementById('house-arena-step3');
            const stage = document.getElementById('house-stage-step3');
            if (!arena || !stage) return;

            const rect = arena.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateX = ((centerY - y) / centerY) * 10;
            const rotateY = ((x - centerX) / centerX) * 12;

            stage.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        }

        function resetHouseArenaTiltStep3() {
            const stage = document.getElementById('house-stage-step3');
            if (!stage) return;
            stage.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }

