<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Home</title>
    <link rel="stylesheet" href="/output.css">
    
</head>
<!-- black ko baad mai grey-50 krna h  -->
<body class="bg-black font-sans antialiased text-gray-900 min-h-screen flex flex-col">

    <%- include("../partials/01_header.ejs") %>
    <main class="flex-1 flex flex-col justify-center items-center px-4 py-12">
        <div class="bg-rose-300 p-8 md:p-10 rounded-2xl shadow-md border border-rose-500 max-w-md w-full space-y-6">
            <div class="text-center">
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-black">
                    Add Your Home
                </h1>
                <p class="text-gray-900 text-sm mt-2">
                    Earn income by sharing your property with travelers.
                </p>
            </div>

            <form action="/host/add-home" method="POST" class="space-y-4">
                <div class="space-y-1">
                    <label for="homeName" class="text-xs font-semibold uppercase tracking-wider text-gray-900 block">
                        Property Name
                    </label>
                    <input 
                        type="text" 
                        id="homeName"
                        name="homeName" 
                        placeholder="e.g., Cozy Beachfront Apartment" 
                        required
                        class="w-full px-4 py-3 rounded-xl border border-rose-500 focus:outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition duration-200 text-sm placeholder-gray-900 bg-gray-50/50"
                    >
                </div>
                <div class="space-y-1">
                    <label for="homeAddress" class="text-xs font-semibold uppercase tracking-wider text-gray-900 block">
                        Property Address 
                    </label>
                    <input 
                        type="text" 
                        id="homeAddress"
                        name="homeAddress" 
                        placeholder="e.g., 123 Main St, Anytown, USA" 
                        required
                        class="w-full px-4 py-3 rounded-xl border border-rose-500 focus:outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition duration-200 text-sm placeholder-gray-900 bg-gray-50/50"
                    >
                </div>
                <div class="space-y-1">
                    <label for="homePrice" class="text-xs font-semibold uppercase tracking-wider text-gray-900 block">
                        Property Price Per Night
                    </label>
                    <input 
                        type="text" 
                        id="homePrice"
                        name="homePrice" 
                        placeholder="$100" 
                        required
                        class="w-full px-4 py-3 rounded-xl border border-rose-500 focus:outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition duration-200 text-sm placeholder-gray-900 bg-gray-50/50"
                    >
                </div>
                <div class="space-y-1">
                    <label for="homePhoto" class="text-xs font-semibold uppercase tracking-wider text-gray-900 block">
                        Property Pictures
                    </label>
                    <input 
                        type="text" 
                        id="homePhoto"
                        name="homePhoto" 
                        placeholder="https://property-image-url.com" 
                        required
                        class="w-full px-4 py-3 rounded-xl border border-rose-500 focus:outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 transition duration-200 text-sm placeholder-gray-900 bg-gray-50/50"
                    >
                </div>

                <button 
                    type="submit"
                    class="w-full text-center px-6 py-3 bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-xl transition duration-200 shadow-md shadow-rose-500/10 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2"
                >
                    Add Home
                </button>
            </form>
        </div>
    </main>
</body>
</html>