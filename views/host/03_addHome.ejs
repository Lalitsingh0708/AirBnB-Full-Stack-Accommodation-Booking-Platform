                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══ STEP 2: TELL US ABOUT YOUR PLACE (INTRO & ASSEMBLING HOUSE ANIMATION) ══ -->
        <div class="step-container" id="step-2">
            <div class="intro-hero-split">
                <!-- Left: Headline & Context matching Airbnb screenshot -->
                <div class="intro-left-content">
                    <span class="intro-step-pill">Step 1</span>
                    <h1 class="intro-headline-airbnb">Tell us about your <em>place</em></h1>
                    <p class="intro-desc-airbnb">
                        In this step, we’ll ask you which type of property you have and if guests will book the entire place or just a room. Then let us know the location and how many guests can stay.
                    </p>

                    <div class="intro-checklist">
                        <div class="intro-check-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Architectural Category &amp; Space Privacy</span>
                        </div>
                        <div class="intro-check-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Exact GPS Pin &amp; Neighborhood Radius Map</span>
                        </div>
                        <div class="intro-check-item">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <span>Guest Capacity &amp; Sleeping Arrangements</span>
                        </div>
                    </div>
                </div>

                <!-- Right: 3D Assembling House Arena ("banta hua ghr ka animation") -->
                <div class="house-construction-arena" id="house-arena" onmousemove="handleHouseArenaMouseMove(event)" onmouseleave="resetHouseArenaTilt()">
