        <input type="hidden" name="safetyDetails" id="f-safetyDetails" value='{"securityCameras":false,"noiseMonitors":false,"weapons":false}' />
        <input type="hidden" name="securityCameras" id="f-securityCameras" value="false" />
        <input type="hidden" name="noiseMonitors" id="f-noiseMonitors" value="false" />
        <input type="hidden" name="weapons" id="f-weapons" value="false" />
        <input type="hidden" name="residentialAddress" id="f-residentialAddress" value='{"country":"India","flat":"","street":"","landmark":"","district":"","city":"","state":"","pinCode":""}' />
        <input type="hidden" name="residentialCountry" id="f-residentialCountry" value="India" />
        <input type="hidden" name="residentialFlat" id="f-residentialFlat" value="" />
        <input type="hidden" name="residentialStreet" id="f-residentialStreet" value="" />
        <input type="hidden" name="residentialLandmark" id="f-residentialLandmark" value="" />
        <input type="hidden" name="residentialDistrict" id="f-residentialDistrict" value="" />
        <input type="hidden" name="residentialCity" id="f-residentialCity" value="" />
        <input type="hidden" name="residentialState" id="f-residentialState" value="" />
        <input type="hidden" name="residentialPinCode" id="f-residentialPinCode" value="" />
    </form>

    <!-- ── Main Multi-step Wizard Container ── -->
    <main class="wizard-stage">
        <!-- ══ STEP 1: SET UP YOUR STAYNEST LISTING (MATCHING EXACT USER SCREENSHOT - NO STEP TAG) ══ -->
        <div class="step-container active" id="step-1">
            <div class="split-layout">
                <!-- Left: Typography & Pill Input matching screenshot 1 -->
                <div>
                    <h1 class="step-headline">Set up your<br />StayNest listing</h1>
                    <p class="step-sub">It's easy to create a great listing &ndash; let's start with your address.</p>

                    <div class="address-box">
                        <!-- Pill Trigger Button opens modal matching screenshot 2 -->
                        <div class="pill-search-trigger" id="pill-trigger-btn" onclick="openAddressModal()">
                            <svg class="pill-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <span class="pill-placeholder" id="pill-placeholder-text">Enter your address</span>
