<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>airbnb Home</title>
    <link rel="stylesheet" href="/output.css" />
    <style>
        body {
            background-color: black;
            color: green;
        }
    </style>
</head>

<body class="bg-grey-50 font-sans antialiased">

    <!-- Header Section -->
    <%- include("../partials/01_header.ejs") %>

        <!-- Main Content Section -->
        <main class="container mx-auto bg-rose-400 shadow-lg rounded-lg p-8 mt-10 w-full">
            <h2 class="text-5xl text-gray-800 font-bold text-center mb-6">
                Here Are Our Registered Homes host review
            </h2>

        </main>

        <section class="p-6">
            <ul class="flex flex-row flex-wrap gap-6 m-6 list-none p-0 justify-start"
                style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 24px;">
                <% registeredHome.forEach((homes)=> { %>

                    <!-- Fixed width container with flexible vertical padding to prevent clipping -->
                    <li class="bg-gray-100 p-4 rounded-xl shadow-md border border-rose-500 hover:shadow-lg transition duration-200 flex flex-col justify-between"
                        style="width: 270px; box-sizing: border-box;">
                        <div>
                            <!-- Image Box: Proportional height that doesn't overwhelm the text layout -->
                            <div class="w-full h-36 mb-3 overflow-hidden rounded-lg bg-gray-200">
                                <img src="<%= homes.housePhoto %>" alt="<%= homes.houseName %>"
                                    class="w-full h-full object-cover transform hover:scale-105 transition duration-300"
                                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1570129477492-45c003edd2be?w=500';" />
                            </div>

                            <!-- Details Zone with adequate spacing -->
                            <div class="space-y-1">
                                <h3 class="font-bold text-gray-800 tracking-wide text-base truncate">
                                    <%= homes.houseName %>
                                </h3>
                                <div class="flex items-center text-gray-500 text-xs truncate space-x-1">
                                    <span class="text-rose-500">📍</span>
                                    <span class="truncate">Registered Property at <%= homes.houseAddress %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Bottom Section: Generous top margin and balanced padding so nothing sits on the edge -->
                        <div class="mt-4 pt-3 border-t border-gray-200 flex justify-between items-center">
                            <!-- Left Side: Price Details -->
                            <div class="flex items-baseline space-x-1">
                                <span class="text-sm font-semibold text-green-700">Price: </span>
                                <span class="text-sm font-semibold text-rose-500"> &nbsp; ₹<%= homes.housePrice %></span>
                                <span class="text-sm font-normal text-gray-500">/night</span>
                            </div>

                            <!-- Right Side: Styled Book Now Button -->
                            <a href="/host/01_editHomes.ejs/<%= homes.id %>"
                                class="bg-rose-500 hover:bg-rose-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm hover:shadow transition duration-200 active:scale-95">
                                Edit
                            </a>
                            <button 
                                class="bg-rose-500 hover:bg-rose-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm hover:shadow transition duration-200 active:scale-95">
                                Delete
                            </button>
                        </div>
                    </li>

                    <% }) %>
            </ul>
        </section>

</body>

</html>