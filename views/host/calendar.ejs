<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calendar &bull; StayNest Host</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg-color: #FFFFFF;
            --text-main: #222222;
            --text-sub: #717171;
            --border-color: #EBEBEB;
            --emerald-mid: #143528;
            --gold-accent: #D4AF6A;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .calendar-stage {
            max-width: 1200px;
            margin: 0 auto;
            padding: 28px 24px 80px 24px;
            width: 100%;
        }

        .calendar-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        .calendar-title-wrap h1 {
            font-size: 26px;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.02em;
        }

        .calendar-title-wrap p {
            font-size: 14px;
            color: var(--text-sub);
            margin-top: 4px;
        }

        .calendar-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .month-selector {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #F7F7F7;
            padding: 6px 14px;
            border-radius: 9999px;
            font-weight: 600;
            font-size: 15px;
        }

        .btn-month-nav {
            background: none;
            border: none;
            cursor: pointer;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s ease;
        }

        .btn-month-nav:hover {
            background: #EBEBEB;
        }

        /* Calendar Grid */
        .calendar-container {
            border: 1px solid var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            background: #FFFFFF;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
        }

        .calendar-days-header {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            background: #FAF7F0;
            border-bottom: 1px solid var(--border-color);
            text-align: center;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-sub);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 12px 0;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            min-height: 480px;
        }

        .calendar-cell {
            border-right: 1px solid #F0F0F0;
            border-bottom: 1px solid #F0F0F0;
            padding: 12px;
            min-height: 100px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: background 0.15s ease;
            position: relative;
        }

        .calendar-cell:nth-child(7n) {
            border-right: none;
        }

        .calendar-cell:hover:not(.empty-cell) {
            background: #FAF9F6;
            cursor: pointer;
        }

        .calendar-cell.empty-cell {
            background: #FCFCFC;
        }

        .cell-date-num {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-main);
        }

        .cell-price-tag {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-main);
            background: #F7F7F7;
            padding: 3px 6px;
            border-radius: 6px;
            align-self: flex-start;
        }

        .cell-price-tag.weekend-tag {
            background: #FFF8E7;
            color: #8C6D1F;
            border: 1px solid #F5E5BE;
        }

        .cell-badge-available {
            font-size: 10.5px;
            font-weight: 600;
            color: #2E7D32;
        }

        .calendar-legend {
            display: flex;
            gap: 20px;
            margin-top: 20px;
            font-size: 13px;
            color: var(--text-sub);
            align-items: center;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-indicator {
            width: 12px;
            height: 12px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <%- include("../partials/01_header.ejs") %>

    <main class="calendar-stage">
        <div class="calendar-top-bar">
            <div class="calendar-title-wrap">
                <h1>Pricing &amp; Availability Calendar</h1>
                <p>View nightly prices and weekend adjustments across your calendar dates.</p>
            </div>

            <div class="calendar-controls">
                <div class="month-selector">
                    <button type="button" class="btn-month-nav" onclick="changeMonth(-1)" aria-label="Previous month">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <span id="current-month-display">October 2026</span>
                    <button type="button" class="btn-month-nav" onclick="changeMonth(1)" aria-label="Next month">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="calendar-container">
            <div class="calendar-days-header">
                <div>Sun</div>
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div>Fri</div>
                <div>Sat</div>
            </div>

            <div class="calendar-grid" id="calendar-grid-cells">
                <!-- Rendered dynamically by script -->
            </div>
        </div>

        <div class="calendar-legend">
            <div class="legend-item">
                <div class="legend-indicator" style="background: #F7F7F7; border: 1px solid #DDD;"></div>
                <span>Weekday Base Price (₹2,321)</span>
            </div>
            <div class="legend-item">
                <div class="legend-indicator" style="background: #FFF8E7; border: 1px solid #F5E5BE;"></div>
                <span>Weekend Markup +6% (₹2,460 on Fri &amp; Sat)</span>
            </div>
            <div class="legend-item">
                <div class="legend-indicator" style="background: #E8F5E9; border: 1px solid #A5D6A7;"></div>
                <span>Instant Book Active</span>
            </div>
        </div>
    </main>

    <script>
        let currentYear = 2026;
        let currentMonth = 9; // 0-indexed: 9 = October

        const monthNames = [
            'January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'
        ];

        function renderCalendar() {
            const disp = document.getElementById('current-month-display');
            if (disp) disp.textContent = `${monthNames[currentMonth]} ${currentYear}`;

            const grid = document.getElementById('calendar-grid-cells');
            if (!grid) return;
            grid.innerHTML = '';

            const firstDay = new Date(currentYear, currentMonth, 1).getDay();
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();

            // Empty cells before start of month
            for (let i = 0; i < firstDay; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'calendar-cell empty-cell';
                grid.appendChild(emptyCell);
            }

            // Days of the month
            for (let d = 1; d <= daysInMonth; d++) {
                const dayOfWeek = new Date(currentYear, currentMonth, d).getDay();
                const isWeekend = (dayOfWeek === 5 || dayOfWeek === 6); // Friday or Saturday
                const price = isWeekend ? '₹2,460' : '₹2,321';

                const cell = document.createElement('div');
                cell.className = 'calendar-cell';
                cell.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="cell-date-num">${d}</span>
                        <span class="cell-badge-available">Available</span>
                    </div>
                    <div class="cell-price-tag ${isWeekend ? 'weekend-tag' : ''}">
                        ${price}
                    </div>
                `;
                grid.appendChild(cell);
            }
        }

        function changeMonth(delta) {
            currentMonth += delta;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear -= 1;
            } else if (currentMonth > 11) {
                currentMonth = 0;
                currentYear += 1;
            }
            renderCalendar();
        }

        window.addEventListener('DOMContentLoaded', renderCalendar);
    </script>
</body>
</html>
