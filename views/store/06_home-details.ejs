                <div class="guests-mention-header-wrap">
                    <h3 class="guests-mention-title">Guests mention</h3>
                    
                    <!-- Horizontal Mentions Tags Carousel matching screenshot -->
                    <div class="guests-mention-pills-row" id="mention-pills-row">
                        <button type="button" class="mention-pill active" onclick="filterReviewsByTag('all', this)">
                            <span>✨ All</span>
                            <span class="mention-pill-count"><%= (typeof reviews !== 'undefined' ? reviews.length : 6) %></span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('River', this)">
                            <span class="mention-pill-icon">🛶</span>
                            <span>River</span>
                            <span class="mention-pill-count">7</span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('Hospitality', this)">
                            <span class="mention-pill-icon">🎁</span>
                            <span>Hospitality</span>
                            <span class="mention-pill-count">17</span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('Comfort', this)">
                            <span class="mention-pill-icon">🛋️</span>
                            <span>Comfort</span>
                            <span class="mention-pill-count">7</span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('Cleanliness', this)">
                            <span class="mention-pill-icon">🧼</span>
                            <span>Cleanliness</span>
                            <span class="mention-pill-count">5</span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('Location', this)">
                            <span class="mention-pill-icon">📍</span>
                            <span>Location</span>
                            <span class="mention-pill-count">5</span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('Breakfast', this)">
                            <span class="mention-pill-icon">🍳</span>
                            <span>Breakfast</span>
                            <span class="mention-pill-count">3</span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('View', this)">
                            <span class="mention-pill-icon">🖼️</span>
                            <span>View</span>
                            <span class="mention-pill-count">2</span>
                        </button>
                        <button type="button" class="mention-pill" onclick="filterReviewsByTag('Walkability', this)">
                            <span class="mention-pill-icon">👟</span>
                            <span>Walkability</span>
                            <span class="mention-pill-count">3</span>
                        </button>
                        <button type="button" class="mention-scroll-next-btn" onclick="scrollMentionsCarousel(1)" aria-label="Next tags">
                            &gt;
                        </button>
                    </div>
                </div>

                <!-- ── 2-Column Reviews Feed Grid (Exact Match to Screenshot) ── -->
                <div class="reviews-feed-grid" id="reviews-feed-grid">
                    <% 
                        const reviewList = (typeof reviews !== 'undefined' && reviews.length > 0) ? reviews : [];
                        const tintClasses = ['avatar-tint-green', 'avatar-tint-blue', 'avatar-tint-amber', 'avatar-tint-purple'];
                    %>
                    <% reviewList.forEach((rev, idx) => { %>
                        <div class="review-card-item" data-tag="<%= rev.tag || 'Hospitality' %>">
                            <!-- Reviewer Info Row -->
                            <div class="reviewer-info-row">
                                <div class="reviewer-avatar-wrap <%= tintClasses[idx % tintClasses.length] %>">
                                    <% if (rev.guestAvatar && rev.guestAvatar.trim()) { %>
                                        <img src="<%= rev.guestAvatar %>" alt="<%= rev.guestName %>" />
                                    <% } else { %>
                                        <span><%= (rev.guestName || 'G').charAt(0).toUpperCase() %></span>
                                    <% } %>
                                </div>
                                <div class="reviewer-text-col">
                                    <div class="reviewer-name-row">
                                        <span class="reviewer-name"><%= rev.guestName %></span>
                                        <% if (rev.isVerifiedStay !== false) { %>
                                            <span class="reviewer-verified-pill" title="Verified guest on StayNest">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <span>Verified Stay</span>
                                            </span>
                                        <% } %>
                                    </div>
                                    <span class="reviewer-tenure"><%= rev.guestTenure || 'Guest on StayNest' %></span>
                                </div>
                            </div>

                            <!-- Rating Stars & Timestamp -->
                            <div class="review-rating-time-row">
                                <span class="review-stars-visual">
                                    <% for(let s=0; s < (Number(rev.rating) || 5); s++) { %>★<% } %>
                                </span>
                                <span class="review-time-sep">&bull;</span>
                                <span class="review-time-text">
                                    <% 
                                        const rDate = rev.createdAt ? new Date(rev.createdAt) : new Date();
                                        const diffWeeks = Math.max(1, Math.round((Date.now() - rDate.getTime()) / (7 * 24 * 60 * 60 * 1000)));
                                        const timeStr = diffWeeks <= 4 ? `${diffWeeks} week${diffWeeks > 1 ? 's' : ''} ago` : rDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
                                    %>
                                    <%= timeStr %>
                                </span>
                            </div>

                            <!-- Review Comment Body -->
                            <p class="review-comment-body" id="review-text-<%= idx %>">
                                <%= rev.comment %>
                            </p>
                            <% if (rev.comment && rev.comment.length > 180) { %>
                                <button type="button" class="review-show-more-btn" onclick="toggleReviewExpand(this, '<%= idx %>')">Show more</button>
                            <% } %>
                        </div>
                    <% }); %>
                </div>

                <!-- ═══════════════════════════════════════════════════════════
                     GUEST REVIEW SUBMISSION CARD (Authentication & Verification Enforced)
                ═══════════════════════════════════════════════════════════ -->
                <% if (typeof user !== 'undefined' && user) { %>
                    <!-- Logged-in User: Verified Review Submission Form -->
                    <div class="add-review-container">
                        <% if (typeof reviewSuccess !== 'undefined' && reviewSuccess) { %>
                            <div class="review-success-toast">
                                <span>🎉</span>
                                <span>Thank you, <%= user.name %>! Your verified review has been published and added below.</span>
                            </div>
                        <% } %>

                        <h4 class="add-review-title">Share your experience at this property</h4>
                        <p class="add-review-subtitle">Your review is published with your verified StayNest identity to help future travelers.</p>

                        <!-- Logged-in User Identity Bar -->
                        <div class="review-logged-in-user-bar">
                            <div class="logged-user-avatar">
                                <% if (user.profilePhoto) { %>
                                    <img src="<%= user.profilePhoto %>" alt="<%= user.name %>" />
                                <% } else { %>
                                    <span><%= user.name.charAt(0).toUpperCase() %></span>
                                <% } %>
                            </div>
                            <div class="logged-user-meta">
                                <span class="logged-user-name">Reviewing as <strong><%= user.name %></strong> (<%= user.email %>)</span>
                                <% if (typeof userHasBooked !== 'undefined' && userHasBooked) { %>
                                    <span class="badge-user-verified-booking">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        Verified Guest &bull; Booking Confirmed
                                    </span>
                                <% } else { %>
                                    <span class="badge-user-member">StayNest Member &bull; Authenticated Account</span>
                                <% } %>
                            </div>
                        </div>

                        <form action="/homes/<%= home.id %>/review" method="POST" id="guest-review-form">
                            <!-- 1. Star Rating Selector -->
                            <div class="rating-stars-picker">
                                <span style="font-size: 14px; font-weight: 600; color: #222; margin-right: 8px;">Rating:</span>
                                <input type="hidden" name="rating" id="review-rating-val" value="5" />
                                <div id="star-picker-icons" style="display: flex; gap: 4px;">
                                    <button type="button" class="star-pick-btn" onclick="setReviewRating(1)">★</button>
                                    <button type="button" class="star-pick-btn" onclick="setReviewRating(2)">★</button>
                                    <button type="button" class="star-pick-btn" onclick="setReviewRating(3)">★</button>
                                    <button type="button" class="star-pick-btn" onclick="setReviewRating(4)">★</button>
                                    <button type="button" class="star-pick-btn" onclick="setReviewRating(5)">★</button>
                                </div>
                                <span id="rating-text-feedback" style="font-size: 13.5px; font-weight: 600; color: #143528; margin-left: 10px;">5.0 &bull; Exceptional</span>
                            </div>

                            <!-- 2. Mention Topic / Tag Selector matching screenshot -->
                            <div class="review-tag-select-row">
                                <span style="font-size: 13.5px; font-weight: 600; color: #222; margin-right: 4px;">Highlight:</span>
                                
                                <input type="radio" id="tag-hosp" name="tag" value="Hospitality" class="review-tag-radio" checked />
                                <label for="tag-hosp" class="review-tag-label">🎁 Hospitality</label>

                                <input type="radio" id="tag-comfort" name="tag" value="Comfort" class="review-tag-radio" />
                                <label for="tag-comfort" class="review-tag-label">🛋️ Comfort</label>

                                <input type="radio" id="tag-clean" name="tag" value="Cleanliness" class="review-tag-radio" />
                                <label for="tag-clean" class="review-tag-label">🧼 Cleanliness</label>

                                <input type="radio" id="tag-loc" name="tag" value="Location" class="review-tag-radio" />
                                <label for="tag-loc" class="review-tag-label">📍 Location</label>

                                <input type="radio" id="tag-view" name="tag" value="View" class="review-tag-radio" />
                                <label for="tag-view" class="review-tag-label">🖼️ View</label>

                                <input type="radio" id="tag-bfast" name="tag" value="Breakfast" class="review-tag-radio" />
                                <label for="tag-bfast" class="review-tag-label">🍳 Breakfast</label>

                                <input type="radio" id="tag-river" name="tag" value="River" class="review-tag-radio" />
                                <label for="tag-river" class="review-tag-label">🛶 River</label>
                            </div>

                            <!-- 3. Review Comment Area -->
                            <textarea 
                                name="comment" 
                                class="review-textarea" 
                                placeholder="Write your honest review about the comfort, views, cleanliness, and hospitality..." 
                                required></textarea>

                            <!-- Submit Button -->
                            <button type="submit" class="btn-submit-review">
                                Submit Verified Review
                            </button>
                        </form>
                    </div>
                <% } else { %>
                    <!-- Not Logged In: Strict Authentication Prompt (Airbnb Standard) -->
                    <div class="review-auth-card">
                        <div class="review-auth-icon-wrap">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#143528" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                <path d="M9 12l2 2 4-4"></path>
                            </svg>
                        </div>
                        <div class="review-auth-content">
                            <h4 class="review-auth-heading">Verified Reviews Only</h4>
                            <p class="review-auth-sub">To maintain the highest level of authenticity and trust, only registered StayNest guests can post reviews. Log in to share your stay experience.</p>
                        </div>
                        <a href="/auth/login?returnUrl=<%= encodeURIComponent('/homes/' + home.id + '#reviews') %>" class="btn-review-login-action">
                            Log in to Write a Review
                        </a>
                    </div>
                <% } %>

                <div class="section-divider"></div>

                <div class="section-divider"></div>

                <!-- Interactive Map Section ("Where you'll be") -->
                <div class="map-section-wrap" id="location">
                    <h3 class="map-section-title">Where you'll be</h3>
                    <p class="map-location-sub"><%= home.houseAddress %></p>

                    <!-- Leaflet OpenStreetMap Container -->
                    <div id="leaflet-property-map"></div>

                    <div class="map-neighborhood-details">
                        <p><strong>Neighborhood:</strong> Situated in a serene, secure residential district in <%= propertyCity %>. Close to curated fine-dining establishments, organic cafés, and cultural landmarks. Public transit and metro are within 10 minutes reach.</p>
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN: Sticky Reservation Box (Screenshots 1, 2, 3) -->
            <aside class="sticky-booking-column">
                <div class="reservation-card">
                    
                    <!-- Fee Tag (Screenshot 1) -->
                    <div class="fee-included-tag">
                        <span style="color: #E00B41;">🏷️</span>
                        <span>Prices include all fees</span>
                    </div>

                    <!-- Price Row with Strikethrough (Screenshot 1) -->
                    <div class="price-header-row">
                        <span class="price-strikethrough">₹<%= formattedStrikethrough %></span>
                        <span class="price-current">₹<%= formattedPrice %></span>
                        <span class="price-unit">for 1 night</span>
                    </div>

                    <!-- Date & Guests Combined Selector Box -->
                    <div class="booking-picker-box">
                        <div class="picker-dates-row">
                            <div class="picker-cell">
                                <label class="picker-cell-label" for="res-checkin">CHECK-IN</label>
                                <input type="date" id="res-checkin" class="picker-date-input" value="2026-10-06" onchange="calculateBookingTotal()" />
                            </div>
                            <div class="picker-cell">
                                <label class="picker-cell-label" for="res-checkout">CHECKOUT</label>
                                <input type="date" id="res-checkout" class="picker-date-input" value="2026-10-07" onchange="calculateBookingTotal()" />
                            </div>
                        </div>

                        <div class="picker-guests-row">
                            <label class="picker-cell-label" for="res-guests">GUESTS</label>
                            <select id="res-guests" class="picker-guest-select">
                                <% const maxCap = home.maxGuests || 4; %>
                                <% for (let g = 1; g <= maxCap; g++) { %>
                                    <option value="<%= g %>"><%= g %> <%= g === 1 ? 'guest' : 'guests' %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <!-- Vibrant Reserve Action Button (Screenshot 1) -->
                    <button type="button" class="btn-reserve-vibrant" onclick="goToCheckout()">
                        Reserve
                    </button>

                    <p class="wont-charge-note">You won't be charged yet</p>

                    <!-- Price Breakdown Calculator -->
                    <div class="price-breakdown-list">
                        <div class="breakdown-row">
                            <span id="breakdown-nights-label">₹<%= formattedPrice %> x 1 night</span>
                            <span id="breakdown-subtotal">₹<%= formattedPrice %></span>
                        </div>
                        <div class="breakdown-row">
                            <span>StayNest service fee</span>
                            <span>₹450</span>
                        </div>
                        <div class="breakdown-row total-row">
                            <span>Total before taxes</span>
                            <span id="breakdown-total">₹<%= (basePrice + 450).toLocaleString('en-IN') %></span>
                        </div>
                    </div>

                    <!-- Direct Chat with Host Widget -->
                    <div class="widget-chat-box">
                        <p class="widget-chat-prompt">Have questions before booking?</p>
                        <button type="button" class="btn-widget-chat" onclick="openChatDrawer()">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span>Chat with <%= hostDisplayName %></span>
                        </button>
                    </div>

                    <!-- Report Listing -->
                    <div class="report-listing-link" onclick="alert('Thank you. Our Trust & Safety team has received your report for review.')">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                            <line x1="4" y1="22" x2="4" y2="15"></line>
                        </svg>
                        <span>Report this listing</span>
                    </div>

                </div>
            </aside>

        </div>
    </main>

    <!-- ── Fullscreen Photo Modal ("Show all photos") ── -->
    <div class="photo-modal-overlay" id="photo-gallery-modal">
        <div class="photo-modal-header">
            <button type="button" class="btn-close-modal" onclick="closePhotoModal()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span>Close gallery</span>
            </button>
            <span style="font-weight: 600;"><%= home.houseName %> &bull; Photo Tour</span>
            <div></div>
        </div>

        <div class="modal-photo-list">
            <% displayPhotos.forEach((photoUrl, pIndex) => { %>
                <div class="modal-photo-item" id="modal-photo-<%= pIndex %>">
                    <img src="<%= photoUrl %>" alt="Photo <%= pIndex + 1 %> of <%= home.houseName %>" />
                    <p class="modal-photo-caption">Photo <%= pIndex + 1 %> of <%= displayPhotos.length %> &bull; Sanctuary Space</p>
                </div>
            <% }); %>
        </div>
    </div>

    <!-- ── Live Guest-to-Host Chat Drawer ── -->
    <div class="chat-drawer-overlay" id="chat-drawer" onclick="handleDrawerOverlayClick(event)">
        <div class="chat-drawer-content" onclick="event.stopPropagation()">
            <!-- Drawer Header -->
            <div class="chat-drawer-header">
                <div class="chat-header-info">
                    <div class="chat-header-avatar">
                        <%= hostDisplayName.substring(0, 2).toUpperCase() %>
                    </div>
                    <div>
                        <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 2px;"><%= hostDisplayName %></h4>
                        <p style="font-size: 12px; opacity: 0.8;">Host &bull; Typically replies within an hour</p>
                    </div>
                </div>
                <button type="button" class="btn-close-modal" onclick="closeChatDrawer()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Messages Stream -->
            <div class="chat-messages-container" id="chat-stream">
                <div class="chat-bubble host">
                    <p>Namaste! I'm <%= hostDisplayName %>, host of <%= home.houseName %>. Feel free to ask about check-in timings, parking, or local recommendations.</p>
                    <div class="chat-bubble-time">Just now</div>
                </div>

                <% if (typeof conversation !== 'undefined' && conversation && conversation.messages && conversation.messages.length > 0) { %>
                    <% conversation.messages.forEach(msg => { %>
                        <div class="chat-bubble <%= msg.senderRole === 'guest' ? 'guest' : 'host' %>">
                            <p><%= msg.text %></p>
                            <div class="chat-bubble-time">
                                <%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- Quick Questions Starter Pills -->
            <div class="chat-quick-starters">
                <button type="button" class="quick-tag-btn" onclick="sendQuickMessage('Hi! Is early check-in possible?')">Early check-in?</button>
                <button type="button" class="quick-tag-btn" onclick="sendQuickMessage('Is fast Wi-Fi available for video meetings?')">Fast Wi-Fi?</button>
                <button type="button" class="quick-tag-btn" onclick="sendQuickMessage('Is parking suitable for a large SUV?')">Car parking?</button>
            </div>

            <!-- Composer Box -->
            <form class="chat-composer-box" id="guest-chat-form" onsubmit="handleSendGuestMessage(event)">
                <input 
                    type="text" 
                    id="guest-chat-input" 
                    class="chat-input-field" 
                    placeholder="Type your message to <%= hostDisplayName %>..." 
                    autocomplete="off"
                    required
                />
                <button type="submit" class="btn-send-chat" id="btn-send-msg" title="Send message">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </form>
        </div>
    </div>

    <!-- Leaflet JS for Map Integration -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        // ── City Geolocation Coordinates Fallback ──
        const CITY_COORDS = {
            'hyderabad': [17.3850, 78.4867],
            'agra': [27.1767, 78.0081],
            'manali': [32.2432, 77.1892],
            'delhi': [28.6139, 77.2090],
            'mumbai': [19.0760, 72.8777],
            'bangalore': [12.9716, 77.5946],
            'bengaluru': [12.9716, 77.5946],
            'goa': [15.2993, 74.1240],
            'jaipur': [26.9124, 75.7873],
            'kolkata': [22.5726, 88.3639],
            'chennai': [13.0827, 80.2707],
            'pune': [18.5204, 73.8567],
            'kochi': [9.9312, 76.2673],
            'kerala': [9.9312, 76.2673]
        };

        const propertyCityName = "<%= (propertyCity || '').toLowerCase() %>";
        let mapLat = Number("<%= home.latitude || '' %>");
        let mapLng = Number("<%= home.longitude || '' %>");

        // If coordinates default to 0 or null, lookup city
        if (!mapLat || !mapLng || (mapLat === 28.6139 && propertyCityName.includes('hyderabad'))) {
            for (const [key, coords] of Object.entries(CITY_COORDS)) {
                if (propertyCityName.includes(key)) {
                    mapLat = coords[0];
                    mapLng = coords[1];
                    break;
                }
            }
        }
        if (!mapLat || !mapLng) {
            mapLat = 17.3850;
            mapLng = 78.4867; // Hyderabad default matching screenshot 1
        }

        // ── Leaflet Map Initialization ──
        document.addEventListener('DOMContentLoaded', () => {
            const mapContainer = document.getElementById('leaflet-property-map');
            if (mapContainer && typeof L !== 'undefined') {
                const map = L.map('leaflet-property-map', {
                    center: [mapLat, mapLng],
                    zoom: 14,
                    zoomControl: true,
                    scrollWheelZoom: false,
                    attributionControl: false
                });

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19
                }).addTo(map);

                // Custom Luxury StayNest Pin Icon
                const stayNestIcon = L.divIcon({
                    className: 'staynest-custom-pin',
                    html: `
                        <div style="
                            width: 48px;
                            height: 48px;
                            background: #143528;
                            border: 3px solid #D4AF6A;
                            border-radius: 50%;
                            box-shadow: 0 4px 14px rgba(0,0,0,0.35);
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: #FAF7F0;
                        ">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                        </div>
                    `,
                    iconSize: [48, 48],
                    iconAnchor: [24, 24]
                });

                const marker = L.marker([mapLat, mapLng], { icon: stayNestIcon }).addTo(map);
                marker.bindPopup(`
                    <div style="font-family: inherit; font-size: 13.5px; padding: 4px;">
                        <strong><%= home.houseName %></strong><br/>
                        <span><%= home.houseAddress %></span>
                    </div>
                `).openPopup();
            }

            // Share button copy link toast
            const btnShare = document.getElementById('btn-share-trigger');
            if (btnShare) {
                btnShare.addEventListener('click', () => {
                    navigator.clipboard.writeText(window.location.href).then(() => {
                        alert('Link copied to clipboard! You can now share this stay.');
                    }).catch(() => {
                        alert('Listing URL: ' + window.location.href);
                    });
                });
            }
        });

        // ── Full Photo Lightbox Modal Handlers ──
        function openPhotoModal(index) {
            const modal = document.getElementById('photo-gallery-modal');
            if (modal) {
                modal.classList.add('open');
                document.body.style.overflow = 'hidden';
                if (index !== undefined) {
                    const targetEl = document.getElementById('modal-photo-' + index);
                    if (targetEl) {
                        targetEl.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            }
        }

        function closePhotoModal() {
            const modal = document.getElementById('photo-gallery-modal');
            if (modal) {
                modal.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        // Close on Esc key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closePhotoModal();
                closeChatDrawer();
            }
        });

        // ── Live Guest-to-Host Chat Drawer Handlers ──
        function openChatDrawer() {
            const drawer = document.getElementById('chat-drawer');
            if (drawer) {
                drawer.classList.add('open');
                document.body.style.overflow = 'hidden';
                const input = document.getElementById('guest-chat-input');
                if (input) setTimeout(() => input.focus(), 300);
            }
        }

        function closeChatDrawer() {
            const drawer = document.getElementById('chat-drawer');
            if (drawer) {
                drawer.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        function handleDrawerOverlayClick(e) {
            if (e.target.id === 'chat-drawer') {
                closeChatDrawer();
            }
        }

        function sendQuickMessage(text) {
            const input = document.getElementById('guest-chat-input');
            if (input) {
                input.value = text;
                document.getElementById('guest-chat-form').requestSubmit();
            }
        }

        async function handleSendGuestMessage(e) {
            e.preventDefault();
            const input = document.getElementById('guest-chat-input');
            const messageText = input ? input.value.trim() : '';
            if (!messageText) return;

            // Optimistic UI Append
            const stream = document.getElementById('chat-stream');
            const bubble = document.createElement('div');
            bubble.className = 'chat-bubble guest';
            bubble.innerHTML = `
                <p>${escapeHtml(messageText)}</p>
                <div class="chat-bubble-time">Just now</div>
            `;
            stream.appendChild(bubble);
            stream.scrollTop = stream.scrollHeight;
            input.value = '';

            try {
                const response = await fetch('/homes/<%= home.id %>/message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messageText: messageText })
                });

                const data = await response.json();
                if (!data.success) {
                    if (response.status === 401) {
                        alert('Please log in as a guest to send messages to the host.');
                        window.location.href = '/auth/login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    } else {
                        alert(data.message || 'Could not send message.');
                    }
                }
            } catch (err) {
                console.error('Chat send error:', err);
            }
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        // ── Reservation Calculator & Calendar Sync ──
        function calculateBookingTotal() {
            const checkinVal = document.getElementById('res-checkin').value;
            const checkoutVal = document.getElementById('res-checkout').value;
            if (!checkinVal || !checkoutVal) return;

            const checkinDate = new Date(checkinVal);
            const checkoutDate = new Date(checkoutVal);
            const diffTime = checkoutDate - checkinDate;
            const nights = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));

            const basePerNight = <%= basePrice %>;
            const subtotal = basePerNight * nights;
            const serviceFee = 450;
            const total = subtotal + serviceFee;

            document.getElementById('breakdown-nights-label').textContent = `₹${basePerNight.toLocaleString('en-IN')} x ${nights} ${nights === 1 ? 'night' : 'nights'}`;
            document.getElementById('breakdown-subtotal').textContent = `₹${subtotal.toLocaleString('en-IN')}`;
            document.getElementById('breakdown-total').textContent = `₹${total.toLocaleString('en-IN')}`;
            
            // Sync calendar display subtitle
            const opt = { day: 'numeric', month: 'short', year: 'numeric' };
            document.getElementById('calendar-date-display').textContent = 
                `${checkinDate.toLocaleDateString('en-GB', opt)} – ${checkoutDate.toLocaleDateString('en-GB', opt)}`;
        }

        function clearSelectedDates() {
            document.getElementById('res-checkin').value = '';
            document.getElementById('res-checkout').value = '';
            document.querySelectorAll('.calendar-day-cell.selected-day').forEach(el => el.classList.remove('selected-day'));
            document.getElementById('calendar-date-display').textContent = 'Select check-in & checkout dates';
        }

        function goToCheckout() {
            const checkin = document.getElementById('res-checkin').value || '2026-10-06';
            const checkout = document.getElementById('res-checkout').value || '2026-10-07';
            const guests = document.getElementById('res-guests').value || '1';
            window.location.href = `/book/<%= home.id %>?checkIn=${encodeURIComponent(checkin)}&checkOut=${encodeURIComponent(checkout)}&guests=${encodeURIComponent(guests)}`;
        }

        // ── Reviews Interactive Functionality (Screenshot match) ──
        let selectedReviewRating = 5;
        function setReviewRating(star) {
            selectedReviewRating = star;
            const input = document.getElementById('review-rating-val');
            if (input) input.value = star;

            const buttons = document.querySelectorAll('#star-picker-icons .star-pick-btn');
            buttons.forEach((btn, idx) => {
                btn.style.color = (idx < star) ? '#D4AF6A' : '#CCCCCC';
            });

            const labels = {
                1: '1.0 &bull; Poor',
                2: '2.0 &bull; Fair',
                3: '3.0 &bull; Average',
                4: '4.0 &bull; Very Good',
                5: '5.0 &bull; Exceptional'
            };
            const feedback = document.getElementById('rating-text-feedback');
            if (feedback) feedback.innerHTML = labels[star] || `${star}.0`;
        }

        function filterReviewsByTag(tag, btn) {
            document.querySelectorAll('#mention-pills-row .mention-pill').forEach(p => p.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const cards = document.querySelectorAll('#reviews-feed-grid .review-card-item');
            cards.forEach(card => {
                const cardTag = card.getAttribute('data-tag');
                if (tag === 'all' || !tag || cardTag.toLowerCase() === tag.toLowerCase()) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function scrollMentionsCarousel(dir) {
            const row = document.getElementById('mention-pills-row');
            if (row) {
                row.scrollBy({ left: dir * 180, behavior: 'smooth' });
            }
        }

        function toggleReviewExpand(btn, idx) {
            const p = document.getElementById('review-text-' + idx);
            if (!p) return;
            if (btn.textContent === 'Show more') {
                p.style.webkitLineClamp = 'unset';
                btn.textContent = 'Show less';
            } else {
                p.style.webkitLineClamp = '3';
                btn.textContent = 'Show more';
            }
        }
    </script>
</body>
</html>