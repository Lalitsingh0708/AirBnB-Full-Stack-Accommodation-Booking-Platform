<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StayNest &bull; Handpicked Vacation Stays & Villas</title>
    <meta name="description" content="Discover handpicked vacation rentals, boutique villas, and unique stays across top destinations on StayNest." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,400;1,500;1,600&display=swap" rel="stylesheet" />
    
    <style>
        :root {
            --bg-beige: #FAF7F0;
            --surface-card: #FFFFFF;
            --emerald-dark: #0f261b;
            --emerald-mid: #143528;
            --gold-accent: #D4AF6A;
            --gold-light: #EBD6A7;
            --text-dark: #121A16;
            --text-muted: #6B7770;
            --border-light: #E8E2D5;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-beige);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ─── HERO BANNER (DEEP EMERALD GRADIENT) ─────── */
        .hero-banner-wrap {
            max-width: 1320px;
            margin: 24px auto 0 auto;
            padding: 0 20px;
            width: 100%;
        }

        .hero-banner {
            background: radial-gradient(ellipse 110% 100% at 75% 20%, #1D4333 0%, #132E22 55%, #0B1C14 100%);
            border-radius: 28px;
            padding: 48px 44px;
            color: #FFFFFF;
            box-shadow: 0 20px 50px -15px rgba(11, 28, 20, 0.45);
            position: relative;
            overflow: hidden;
        }

        .hero-eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--gold-accent);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .hero-headline {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 42px;
            font-weight: 500;
            line-height: 1.18;
            margin-bottom: 12px;
            letter-spacing: -0.5px;
        }

        .hero-headline em {
            font-style: italic;
            color: var(--gold-accent);
            font-weight: 400;
        }

        .hero-sub {
            font-size: 15px;
            color: rgba(255, 255, 255, 0.72);
            max-width: 580px;
            line-height: 1.6;
            margin-bottom: 28px;
            font-weight: 300;
        }

        /* ─── SEARCH & FILTER BAR ─────────────────────── */
        .search-filter-box {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 16px;
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            max-width: 520px;
        }

        .search-icon {
            color: var(--gold-accent);
            flex-shrink: 0;
            display: flex;
        }

        .search-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: #FFFFFF;
            font-family: inherit;
            font-size: 14.5px;
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.55);
        }

        /* ─── CATEGORIES SCROLLER ─────────────────────── */
        .category-bar-wrap {
            max-width: 1320px;
            margin: 28px auto 0 auto;
            padding: 0 20px;
            width: 100%;
        }

        .category-pills {
            display: flex;
            align-items: center;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 6px;
            scrollbar-width: none;
        }

        .category-pills::-webkit-scrollbar {
            display: none;
        }

        .cat-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 9999px;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            color: var(--text-muted);
            background: #FFFFFF;
            border: 1px solid var(--border-light);
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .cat-pill:hover,
        .cat-pill.active {
            background: var(--emerald-mid);
            color: #FFFFFF;
            border-color: var(--emerald-mid);
            box-shadow: 0 4px 12px rgba(20, 53, 40, 0.18);
        }

        .cat-pill.active {
            font-weight: 600;
        }

        /* ─── LISTINGS SECTION ────────────────────────── */
        .listings-container {
            max-width: 1320px;
            margin: 20px auto 48px auto;
            padding: 0 20px;
            width: 100%;
        }

        .section-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-dark);
            letter-spacing: -0.3px;
        }

        .section-count {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        /* ─── LUXURY CARD GRID ────────────────────────── */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 28px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .card-item {
            background: var(--surface-card);
            border-radius: 20px;
            border: 1px solid var(--border-light);
            box-shadow: 0 4px 16px rgba(18, 43, 32, 0.04);
            padding: 14px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease;
        }

        .card-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 36px -10px rgba(18, 43, 32, 0.14), 0 0 0 1px rgba(212, 175, 106, 0.35);
        }

        /* Image Box */
        .image-box {
            position: relative;
            width: 100%;
            height: 200px;
            border-radius: 14px;
            overflow: hidden;
            background: #EFE9DC;
            margin-bottom: 14px;
        }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .card-item:hover .image-box img {
            transform: scale(1.05);
        }

        .rating-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(18, 43, 32, 0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            color: #FFFFFF;
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 11.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .star-icon {
            color: var(--gold-accent);
        }

        /* Details */
        .card-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .title-text {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 4px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.3;
        }

        .location-text {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0 0 14px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .loc-icon {
            color: var(--emerald-mid);
            flex-shrink: 0;
        }

        /* Price & Action Area */
        .card-footer {
            border-top: 1px solid var(--border-light);
            padding-top: 12px;
            margin-top: 6px;
        }

        .price-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .price-tag {
            font-size: 17px;
            font-weight: 800;
            color: var(--emerald-dark);
            letter-spacing: -0.3px;
        }

        .night-tag {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 400;
        }

        .action-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-view-details {
            flex: 1;
            height: 38px;
            background: var(--emerald-mid);
            color: #FFFFFF;
            text-decoration: none;
            border-radius: 9999px;
            font-size: 13.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
            box-shadow: 0 4px 12px rgba(20, 53, 40, 0.22);
        }

        .btn-view-details:hover {
            background: #0B1C14;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(20, 53, 40, 0.32);
        }

        /* Empty State */
        .empty-listings-box {
            text-align: center;
            padding: 60px 20px;
            background: var(--surface-card);
            border-radius: 20px;
            border: 1px solid var(--border-light);
        }

        .empty-title {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .empty-desc {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        /* Mobile */
        @media (max-width: 768px) {
            .hero-banner {
                padding: 32px 24px;
                border-radius: 20px;
            }

            .hero-headline {
                font-size: 30px;
            }

            .cards-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <!-- 1. StayNest Global Header -->
    <%- include("../partials/01_header.ejs") %>

    <!-- 2. Hero Banner (Deep Forest Emerald Gradient with Playfair Golden Heading) -->
    <section class="hero-banner-wrap">
        <div class="hero-banner">
            <p class="hero-eyebrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                <span>Curated Escapes &bull; StayNest</span>
            </p>
            <h1 class="hero-headline">
                Find your next <em>sanctuary.</em>
            </h1>
            <p class="hero-sub">
                Handpicked boutique villas, mountain hideaways, and architectural spaces curated for peaceful, unforgettable living.
            </p>

            <!-- Search Bar -->
            <div class="search-filter-box">
                <span class="search-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input 
                    type="text" 
                    id="filter-input" 
                    class="search-input" 
                    placeholder="Search by city, property name, or destination..." 
                    oninput="filterListings(this.value)"
                />
            </div>
        </div>
    </section>

    <!-- 3. Category Filter Chips -->
    <div class="category-bar-wrap">
        <div class="category-pills" role="tablist">
            <button type="button" class="cat-pill active" onclick="filterCategory('all', this)">All Stays</button>
            <button type="button" class="cat-pill" onclick="filterCategory('Villa', this)">Luxury Villas</button>
            <button type="button" class="cat-pill" onclick="filterCategory('Cabin', this)">Mountain Cabins</button>
            <button type="button" class="cat-pill" onclick="filterCategory('Beach', this)">Beachfront</button>
            <button type="button" class="cat-pill" onclick="filterCategory('Apartment', this)">Boutique Apartments</button>
            <button type="button" class="cat-pill" onclick="filterCategory('Mansion', this)">Heritage Stays</button>
        </div>
    </div>

    <!-- 4. Listings Grid -->
    <main class="listings-container">
        <div class="section-header-row">
            <h2 class="section-title">Explore Verified Accommodations</h2>
            <span class="section-count" id="listings-count"><%= registeredHome.length %> stays available</span>
        </div>

        <% if (registeredHome && registeredHome.length > 0) { %>
            <ul class="cards-grid" id="cards-grid">
                <% registeredHome.forEach((home) => { %>
                    <li class="card-item listing-card" data-title="<%= (home.houseName || '').toLowerCase() %>" data-loc="<%= (home.houseAddress || '').toLowerCase() %>">
                        <div class="card-content">
                            <!-- Image Box with Rating Badge -->
                            <div class="image-box">
                                <img 
                                    src="<%= home.housePhoto %>" 
                                    alt="<%= home.houseName %>"
                                    loading="lazy"
                                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1580587771525-78b9dba3b914?w=600&auto=format&fit=crop&q=80';" 
                                />
                                <span class="rating-badge">
                                    <svg class="star-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                    <span>4.95</span>
                                </span>
                            </div>

                            <!-- Details -->
                            <h3 class="title-text" title="<%= home.houseName %>"><%= home.houseName %></h3>
                            <p class="location-text">
                                <svg class="loc-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span><%= home.houseAddress %></span>
                            </p>
                        </div>

                        <!-- Price & Action Area -->
                        <div class="card-footer">
                            <div class="price-row">
                                <span class="price-tag">₹<%= Number(home.housePrice).toLocaleString('en-IN') %> <span class="night-tag">/ night</span></span>
                            </div>
                            <div class="action-row">
                                <a href="/homes/<%= home.id %>" class="btn-view-details">
                                    View Details
                                </a>
                                <%- include("../partials/02_favourite", { home: home }) %>
                            </div>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <div class="empty-listings-box">
                <h3 class="empty-title">No Stays Listed Yet</h3>
                <p class="empty-desc">Check back soon or be the first to list your own place on StayNest.</p>
                <a href="/host/add-home" class="btn-view-details" style="display: inline-flex; width: auto; padding: 0 24px;">Host Your Home</a>
            </div>
        <% } %>
    </main>

    <!-- Client Filter Logic -->
    <script>
        function filterListings(query) {
            const q = query.toLowerCase().trim();
            const cards = document.querySelectorAll('.listing-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const title = card.getAttribute('data-title') || '';
                const loc = card.getAttribute('data-loc') || '';
                if (!q || title.includes(q) || loc.includes(q)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const countEl = document.getElementById('listings-count');
            if (countEl) countEl.textContent = visibleCount + ' stays found';
        }

        function filterCategory(category, btn) {
            document.querySelectorAll('.cat-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');

            if (category === 'all') {
                filterListings('');
            } else {
                filterListings(category);
            }
        }
    </script>
</body>
</html>