<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirm and Pay | StayNest</title>
    <meta name="description" content="Complete your reservation for <%= home.houseName %> on StayNest." />
    
    <!-- Razorpay Checkout SDK -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg-beige: #FAF7F0;
            --surface-card: #FFFFFF;
            --surface-subtle: #F7F5EE;
            --emerald-dark: #0B1C14;
            --emerald-mid: #143528;
            --emerald-accent: #1D4333;
            --emerald-light: #EBF2ED;
            --gold-accent: #D4AF6A;
            --gold-deep: #B88E3E;
            --coral-brand: #E00B41;
            --text-dark: #222222;
            --text-muted: #717171;
            --border-light: #DDDDDD;
            --border-subtle: #EBEBEB;
            --radius-xl: 16px;
            --radius-lg: 12px;
            --radius-sm: 8px;
            --shadow-card: 0 6px 24px rgba(0,0,0,0.06);
            --shadow-float: 0 12px 36px rgba(18, 43, 32, 0.12);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-beige);
            background-image: 
                radial-gradient(ellipse 90% 40% at 50% -10%, rgba(212, 175, 106, 0.07), transparent 70%),
                radial-gradient(circle at 95% 85%, rgba(20, 53, 40, 0.035), transparent 45%),
                radial-gradient(rgba(180, 160, 135, 0.16) 0.75px, transparent 0.75px);
            background-size: 100% 100%, 100% 100%, 22px 22px;
            background-attachment: fixed;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-dark);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Simple Top Header ── */
        .checkout-top-nav {
            padding: 20px 40px;
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-link {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--emerald-dark);
        }

        .brand-name {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-name span {
            color: var(--gold-accent);
        }

        .checkout-secure-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 600;
            color: var(--emerald-mid);
        }

        /* ── Layout Container ── */
        .checkout-main-container {
            max-width: 1140px;
            margin: 32px auto 80px auto;
            padding: 0 24px;
        }

        .back-nav-bar {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 28px;
        }

        .btn-back-circle {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
            text-decoration: none;
            transition: all 0.15s ease;
        }

        .btn-back-circle:hover {
            background: #F7F7F7;
            transform: scale(1.04);
        }

        .checkout-page-title {
            font-size: 32px;
            font-weight: 700;
            color: #222222;
            letter-spacing: -0.5px;
        }

        /* Two-Column Split */
        .checkout-grid {
            display: grid;
            grid-template-columns: 1fr 440px;
            gap: 64px;
            align-items: start;
        }

        /* ── Left Column: Form & Trip Info ── */
        .checkout-left-pane {
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        .section-separator {
            height: 1px;
            background: var(--border-subtle);
            width: 100%;
        }

        .pane-section-title {
            font-size: 22px;
            font-weight: 600;
            color: #222222;
            margin-bottom: 20px;
        }

        /* Trip Review Box */
        .trip-item-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 18px;
        }

        .trip-item-label {
            font-size: 16px;
            font-weight: 600;
            color: #222222;
            margin-bottom: 4px;
        }

        .trip-item-sub {
            font-size: 14.5px;
            color: var(--text-muted);
        }

        .btn-edit-trip {
            background: none;
            border: none;
            font-size: 14px;
            font-weight: 600;
            text-decoration: underline;
            color: #222222;
            cursor: pointer;
            font-family: inherit;
        }

        /* User / Guest Account Box */
        .guest-auth-card {
            background: var(--surface-subtle);
            border: 1px solid var(--border-light);
            border-radius: var(--radius-lg);
            padding: 18px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .guest-auth-info {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .guest-avatar-small {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--emerald-mid);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
        }

        .guest-info-name {
            font-size: 15px;
            font-weight: 600;
            color: #222222;
        }

        .guest-info-email {
            font-size: 13.5px;
            color: var(--text-muted);
        }

        /* ═══════════════════════════════════════════════════════════
           LUXURY REDESIGNED "PAY WITH" PAYMENT STACK
        ═══════════════════════════════════════════════════════════ */
        .pay-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .pay-secure-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            background: #EBF2ED;
            color: #143528;
            border-radius: 9999px;
            font-size: 12.5px;
            font-weight: 600;
        }

        .payment-methods-stack {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .payment-option-card {
            border: 1.5px solid #E5E7EB;
            border-radius: 14px;
            padding: 18px 22px;
            cursor: pointer;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            background: #FFFFFF;
            position: relative;
        }

        .payment-option-card:hover {
            border-color: #CBD5E1;
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
        }

        .payment-option-card.selected {
            border-color: #143528;
            background: #FAFCFA;
            box-shadow: 0 0 0 1px #143528, 0 8px 22px rgba(20, 53, 40, 0.08);
        }

        .payment-option-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            user-select: none;
        }

        .option-main-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        /* Hidden Real Radio for Form Submission */
        .real-payment-radio {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        /* Custom Modern Radio Indicator */
        .custom-radio-circle {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 2px solid #CBD5E1;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s ease;
            background: #FFFFFF;
        }

        .custom-radio-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #143528;
            transform: scale(0);
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .payment-option-card.selected .custom-radio-circle {
            border-color: #143528;
        }

        .payment-option-card.selected .custom-radio-dot {
            transform: scale(1);
        }

        .option-titles-wrap {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .option-primary-title {
            font-size: 15.5px;
            font-weight: 700;
            color: #1F2937;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .option-sub-desc {
            font-size: 12.5px;
            color: #6B7280;
            font-weight: 400;
        }

        /* Brand Badges on Right of Header */
        .brand-badges-cluster {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .brand-pill-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.3px;
            border: 1px solid #E5E7EB;
            background: #F9FAFB;
            color: #374151;
        }

        .brand-pill-badge.upi-brand {
            background: #002970;
            color: #FFFFFF;
            border-color: #002970;
            font-size: 10.5px;
        }

        .brand-pill-badge.phonepe-brand {
            background: #5f259f;
            color: #FFFFFF;
            border-color: #5f259f;
            font-size: 10.5px;
        }

        .brand-pill-badge.paytm-brand {
            background: #00b9f5;
            color: #FFFFFF;
            border-color: #00b9f5;
            font-size: 10.5px;
        }

        .brand-pill-badge.highlight-green {
            background: #EBF7EE;
            color: #008A05;
            border-color: #A6E3B8;
            font-weight: 600;
        }

        /* Card Expandable Body */
        .payment-details-body {
            display: none;
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid #EAEAEA;
            animation: fadeInBody 0.22s ease-out;
        }

        @keyframes fadeInBody {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .payment-option-card.selected .payment-details-body {
            display: block;
        }

        /* UPI Input with embedded icon and quick chips */
        .upi-input-container {
            position: relative;
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .upi-prefix-icon {
            position: absolute;
            left: 14px;
            color: #143528;
            display: flex;
            align-items: center;
            pointer-events: none;
        }

        .upi-form-input {
            width: 100%;
            height: 48px;
            padding: 0 14px 0 44px;
            border: 1.5px solid #D1D5DB;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14.5px;
            font-weight: 500;
            color: #1F2937;
            outline: none;
            background: #FFFFFF;
            transition: all 0.15s ease;
        }

        .upi-form-input:focus {
            border-color: #143528;
            box-shadow: 0 0 0 3.5px rgba(20, 53, 40, 0.12);
        }

        .vpa-chips-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 12px;
        }

        .vpa-chip {
            padding: 4px 10px;
            border-radius: 9999px;
            border: 1px solid #D1D5DB;
            background: #FFFFFF;
            font-size: 12px;
            font-weight: 500;
            color: #4B5563;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .vpa-chip:hover {
            border-color: #143528;
            color: #143528;
            background: #F3F4F6;
        }

        .upi-info-note {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            color: #6B7280;
            line-height: 1.4;
        }

        /* Card Inputs */
        .card-row-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .card-input-box {
            height: 46px;
            border: 1.5px solid #D1D5DB;
            border-radius: 10px;
            padding: 0 14px;
            font-family: inherit;
            font-size: 14px;
            color: #1F2937;
            outline: none;
            background: #FFFFFF;
            width: 100%;
            transition: all 0.15s ease;
        }

        .card-input-box:focus {
            border-color: #143528;
            box-shadow: 0 0 0 3.5px rgba(20, 53, 40, 0.12);
        }

        /* Net Banking Bank Selector Grid */
        .bank-fast-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }

        .bank-chip-btn {
            padding: 10px 8px;
            border-radius: 8px;
            border: 1.5px solid #E5E7EB;
            background: #FFFFFF;
            text-align: center;
            font-size: 12.5px;
            font-weight: 600;
            color: #374151;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .bank-chip-btn:hover {
            border-color: #143528;
            background: #F9FAFB;
        }

        .bank-chip-btn.active {
            border-color: #143528;
            background: #EBF2ED;
            color: #143528;
            box-shadow: 0 0 0 1px #143528;
        }

        /* Pay at Property Callout */
        .arrival-perks-box {
            background: #F4F8F5;
            border: 1px solid #C8E1CE;
            border-radius: 10px;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .arrival-perk-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #143528;
            font-weight: 500;
        }

        /* Special Requests Box Redesign */
        .special-note-card {
            background: #FFFFFF;
            border: 1.5px solid #E5E7EB;
            border-radius: 14px;
            padding: 20px;
            margin-top: 24px;
            transition: all 0.2s ease;
        }

        .special-note-card:focus-within {
            border-color: #143528;
            box-shadow: 0 0 0 3.5px rgba(20, 53, 40, 0.1);
        }

        .special-note-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .special-note-title {
            font-size: 14.5px;
            font-weight: 700;
            color: #1F2937;
        }

        .special-note-sub {
            font-size: 12.5px;
            color: #6B7280;
            margin-bottom: 12px;
        }

        .special-note-textarea {
            width: 100%;
            height: 68px;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            padding: 10px 12px;
            outline: none;
            font-family: inherit;
            font-size: 14px;
            line-height: 1.5;
            color: #222222;
            resize: vertical;
            background: #FAFBF9;
            transition: all 0.15s ease;
        }

        .special-note-textarea:focus {
            background: #FFFFFF;
            border-color: #143528;
        }

        .special-suggestion-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #F3F4F6;
        }

        .quick-suggest-pill {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 9999px;
            background: #F3F4F6;
            color: #4B5563;
            cursor: pointer;
            transition: all 0.15s ease;
            user-select: none;
        }

        .quick-suggest-pill:hover {
            background: #E5E7EB;
            color: #111827;
        }

        /* Policy & Ground Rules */
        .policy-item {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            margin-bottom: 14px;
        }

        .policy-icon {
            color: var(--emerald-mid);
            margin-top: 2px;
            flex-shrink: 0;
        }

        .policy-text-wrap h5 {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .policy-text-wrap p {
            font-size: 13.5px;
            color: var(--text-muted);
            line-height: 1.45;
        }

        /* Submit Action */
        .btn-confirm-pay {
            width: 100%;
            height: 52px;
            background: radial-gradient(circle, rgba(235,87,87,1) 0%, rgba(224,11,65,1) 100%);
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-size: 16.5px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(224, 11, 65, 0.35);
            transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-confirm-pay:hover {
            background: #D90038;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(224, 11, 65, 0.45);
        }

        .terms-subtext {
            font-size: 12px;
            color: var(--text-muted);
            line-height: 1.5;
            margin-top: 14px;
        }

        /* ── Right Column: Sticky Summary ── */
        .checkout-right-pane {
            position: sticky;
            top: 40px;
        }

        .summary-card {
            border: 1px solid var(--border-light);
            border-radius: var(--radius-xl);
            padding: 24px;
            background: #FFFFFF;
            box-shadow: var(--shadow-card);
        }

        .property-summary-header {
            display: flex;
            gap: 16px;
            margin-bottom: 22px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .summary-thumb {
            width: 108px;
            height: 108px;
            border-radius: var(--radius-lg);
            overflow: hidden;
            flex-shrink: 0;
            background: #F2F2F2;
        }

        .summary-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .summary-property-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .summary-property-type {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .summary-property-name {
            font-size: 16px;
            font-weight: 600;
            color: #222222;
            line-height: 1.3;
            margin-bottom: 6px;
        }

        .summary-property-rating {
            font-size: 13.5px;
            font-weight: 600;
            color: #222222;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Price Breakdown List */
        .summary-breakdown-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-subtle);
            margin-bottom: 20px;
        }

        .summary-breakdown-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14.5px;
            color: #222222;
        }

        .summary-breakdown-row.total-row {
            font-size: 17px;
            font-weight: 700;
            color: #222222;
            padding-top: 4px;
        }

        .trust-badge-footer {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12.5px;
            color: var(--text-muted);
            line-height: 1.4;
        }

        @media (max-width: 900px) {
            .checkout-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .checkout-right-pane {
                position: static;
                order: -1;
            }
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

    <!-- Simple Secure Header -->
    <header class="checkout-top-nav">
        <a href="/" class="brand-link" aria-label="StayNest Home">
            <svg class="brand-logo-icon" width="30" height="30" viewBox="0 0 34 34" fill="none">
                <rect width="34" height="34" rx="10" fill="#122B20"/>
                <path d="M17 7L8 14.5V25C8 25.5523 8.44772 26 9 26H14V19H20V26H25C25.5523 26 26 25.5523 26 25V14.5L17 7Z" fill="#FAF7F0"/>
                <circle cx="17" cy="14" r="2.2" fill="#D4AF6A"/>
            </svg>
            <span class="brand-name">Stay<span class="brand-name-accent">Nest</span></span>
        </a>

        <div class="checkout-secure-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>256-Bit SSL Encrypted Checkout</span>
        </div>
    </header>

    <%
        // Formatting & Calculations with robust fallbacks
        const homeId = home.id || home._id || '';
        const houseTitle = home.houseName || 'StayNest Luxury Accommodation';
        const rawPrice = home.housePrice !== undefined ? String(home.housePrice).replace(/[^0-9.]/g, '') : '2620';
        const pricePerNight = Number(rawPrice) || 2620;
        const totalNights = Math.max(1, Number(nights) || 1);
        const subtotal = pricePerNight * totalNights;
        const serviceFee = 450;
        const totalAmount = subtotal + serviceFee;

        const dIn = checkIn ? new Date(checkIn) : new Date();
        const dOut = checkOut ? new Date(checkOut) : new Date(Date.now() + 86400000);
        const dateOptions = { day: 'numeric', month: 'short', year: 'numeric' };
        const checkInFormatted = !isNaN(dIn.getTime()) ? dIn.toLocaleDateString('en-GB', dateOptions) : 'Check-in date';
        const checkOutFormatted = !isNaN(dOut.getTime()) ? dOut.toLocaleDateString('en-GB', dateOptions) : 'Check-out date';

        const propertyThumb = home.housePhoto || (home.photos && home.photos[0]) || 'https://images.unsplash.com/photo-1580587771525-78b9dba3b914?w=800&auto=format&fit=crop&q=80';
        const guestName = (user && user.name) ? user.name : 'StayNest Guest';
        const guestEmail = (user && user.email) ? user.email : 'guest@staynest.com';
        const guestPhone = (user && (user.phone || (user.customerProfile && user.customerProfile.phone))) ? (user.phone || user.customerProfile.phone) : '9876543210';
        const rzpKey = typeof razorpayKeyId !== 'undefined' ? razorpayKeyId : 'rzp_test_SdWJYLLkVxRcTI';
    %>

    <main class="checkout-main-container">
        
        <div class="back-nav-bar">
            <a href="/homes/<%= home.id %>" class="btn-back-circle" title="Back to listing">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </a>
            <h1 class="checkout-page-title">Confirm and pay</h1>
        </div>

        <div class="checkout-grid">
            
            <!-- LEFT COLUMN -->
            <div class="checkout-left-pane">
                
                <!-- Trip Summary Section -->
                <div>
                    <h2 class="pane-section-title">Your trip</h2>
                    
                    <div class="trip-item-row">
                        <div>
                            <div class="trip-item-label">Dates</div>
                            <div class="trip-item-sub"><%= checkInFormatted %> &ndash; <%= checkOutFormatted %> (<%= totalNights %> <%= totalNights === 1 ? 'night' : 'nights' %>)</div>
                        </div>
                        <a href="/homes/<%= home.id %>" class="btn-edit-trip">Edit</a>
                    </div>

                    <div class="trip-item-row">
                        <div>
                            <div class="trip-item-label">Guests</div>
                            <div class="trip-item-sub"><%= guests %> <%= guests === 1 ? 'guest' : 'guests' %></div>
                        </div>
                        <a href="/homes/<%= home.id %>" class="btn-edit-trip">Edit</a>
                    </div>
                </div>

                <div class="section-separator"></div>

                <!-- Guest Profile Verification -->
                <div>
                    <h2 class="pane-section-title">Logged-in guest</h2>
                    <div class="guest-auth-card">
                        <div class="guest-auth-info">
                            <div class="guest-avatar-small">
                                <%= (user && user.name) ? user.name.substring(0, 2).toUpperCase() : 'G' %>
                            </div>
                            <div>
                                <div class="guest-info-name"><%= (user && user.name) ? user.name : 'StayNest Guest' %></div>
                                <div class="guest-info-email"><%= (user && user.email) ? user.email : '' %> &bull; Authenticated Account</div>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <span style="display: block; font-size: 13px; font-weight: 600; color: #008A05; margin-bottom: 2px;">✓ Verified Account</span>
                            <a href="/auth/login?returnUrl=/book/<%= home.id %>" style="font-size: 12px; color: var(--text-muted); text-decoration: underline;">Switch account</a>
                        </div>
                    </div>
                </div>

                <div class="section-separator"></div>

                <!-- Payment Form -->
                <form id="booking-payment-form" action="/book/<%= home.id %>" method="POST">
                    <input type="hidden" name="checkIn" value="<%= checkIn %>" />
                    <input type="hidden" name="checkOut" value="<%= checkOut %>" />
                    <input type="hidden" name="guests" value="<%= guests %>" />
                    <input type="hidden" name="totalNights" value="<%= totalNights %>" />
                    <input type="hidden" name="pricePerNight" value="<%= pricePerNight %>" />
                    <input type="hidden" name="totalAmount" value="<%= totalAmount %>" />

                    <!-- Luxury Redesigned Payment Methods -->
                    <div class="pay-header-row">
                        <h2 class="pane-section-title" style="margin-bottom: 0;">Pay with</h2>
                        <span class="pay-secure-tag">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span>100% Encrypted & Secure</span>
                        </span>
                    </div>

                    <div class="payment-methods-stack">
                        
                        <!-- 1. Razorpay Secure Online (Default Selected) -->
                        <div class="payment-option-card selected" onclick="selectPaymentMethod('razorpay', this)">
                            <input type="radio" name="paymentMethod" value="razorpay" class="real-payment-radio" checked />
                            <div class="payment-option-header">
                                <div class="option-main-left">
                                    <div class="custom-radio-circle">
                                        <div class="custom-radio-dot"></div>
                                    </div>
                                    <div class="option-titles-wrap">
                                        <span class="option-primary-title">Razorpay Secure Online</span>
                                        <span class="option-sub-desc">UPI, Cards, Net Banking, Wallets &amp; EMI</span>
                                    </div>
                                </div>
                                <div class="brand-badges-cluster">
                                    <span class="brand-pill-badge" style="background: #0C2340; color: #FFFFFF; font-weight: 700;">Razorpay</span>
                                    <span class="brand-pill-badge upi-brand">UPI</span>
                                    <span class="brand-pill-badge" style="font-weight: 800; color: #1A1F71;">Cards</span>
                                </div>
                            </div>
                            <div class="payment-details-body">
                                <div class="arrival-perks-box" style="margin-top: 2px;">
                                    <div class="arrival-perk-item">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#008A05" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span><strong>Instant Automated Confirmation:</strong> Verified directly via Razorpay Gateway.</span>
                                    </div>
                                    <div class="arrival-perk-item">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#008A05" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span><strong>All Modes Included:</strong> Google Pay, PhonePe, Paytm, RuPay, Visa, Mastercard, and Net Banking.</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. UPI Option -->
                        <div class="payment-option-card" onclick="selectPaymentMethod('upi', this)">
                            <input type="radio" name="paymentMethod" value="upi" class="real-payment-radio" />
                            <div class="payment-option-header">
                                <div class="option-main-left">
                                    <div class="custom-radio-circle">
                                        <div class="custom-radio-dot"></div>
                                    </div>
                                    <div class="option-titles-wrap">
                                        <span class="option-primary-title">UPI (Instant & Free)</span>
                                        <span class="option-sub-desc">Google Pay, PhonePe, Paytm, BHIM & all apps</span>
                                    </div>
                                </div>
                                <div class="brand-badges-cluster">
                                    <span class="brand-pill-badge gpay-brand">GPay</span>
                                    <span class="brand-pill-badge phonepe-brand">PhonePe</span>
                                    <span class="brand-pill-badge paytm-brand">Paytm</span>
                                    <span class="brand-pill-badge upi-brand">UPI</span>
                                </div>
                            </div>
                            <div class="payment-details-body">
                                <label class="form-label" for="upi-id" style="display: block; margin-bottom: 6px;">Enter UPI ID / VPA</label>
                                <div class="upi-input-container">
                                    <span class="upi-prefix-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                        </svg>
                                    </span>
                                    <input type="text" id="upi-id" class="upi-form-input" placeholder="e.g. yourname@okhdfcbank" value="guest@upi" />
                                </div>
                                
                                <!-- Fast VPA Extension Selector Chips -->
                                <div class="vpa-chips-row">
                                    <span style="font-size: 11.5px; color: var(--text-muted); margin-right: 4px;">Quick handle:</span>
                                    <span class="vpa-chip" onclick="appendVpa('@okhdfcbank', event)">@okhdfcbank</span>
                                    <span class="vpa-chip" onclick="appendVpa('@okaxis', event)">@okaxis</span>
                                    <span class="vpa-chip" onclick="appendVpa('@paytm', event)">@paytm</span>
                                    <span class="vpa-chip" onclick="appendVpa('@ybl', event)">@ybl</span>
                                </div>

                                <div class="upi-info-note">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="16" x2="12" y2="12"></line>
                                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                    </svg>
                                    <span>A payment notification request will be sent directly to your registered UPI application.</span>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Credit or Debit Card -->
                        <div class="payment-option-card" onclick="selectPaymentMethod('card', this)">
                            <input type="radio" name="paymentMethod" value="card" class="real-payment-radio" />
                            <div class="payment-option-header">
                                <div class="option-main-left">
                                    <div class="custom-radio-circle">
                                        <div class="custom-radio-dot"></div>
                                    </div>
                                    <div class="option-titles-wrap">
                                        <span class="option-primary-title">Credit or Debit Card</span>
                                        <span class="option-sub-desc">Visa, Mastercard, RuPay & Diners Club</span>
                                    </div>
                                </div>
                                <div class="brand-badges-cluster">
                                    <span class="brand-pill-badge" style="font-weight: 800; color: #1A1F71;">VISA</span>
                                    <span class="brand-pill-badge" style="font-weight: 800; color: #EB001B;">MC</span>
                                    <span class="brand-pill-badge" style="font-weight: 800; color: #005697;">RuPay</span>
                                </div>
                            </div>
                            <div class="payment-details-body">
                                <div class="form-control-wrap" style="margin-bottom: 12px;">
                                    <label class="form-label" style="font-size: 12.5px;">Card Number</label>
                                    <input type="text" class="card-input-box" placeholder="4111 2222 3333 4444" maxlength="19" />
                                </div>
                                <div class="card-row-grid">
                                    <div class="form-control-wrap" style="margin-bottom: 12px;">
                                        <label class="form-label" style="font-size: 12.5px;">Expiration (MM/YY)</label>
                                        <input type="text" class="card-input-box" placeholder="12/28" maxlength="5" />
                                    </div>
                                    <div class="form-control-wrap" style="margin-bottom: 12px;">
                                        <label class="form-label" style="font-size: 12.5px;">CVV / Security Code</label>
                                        <input type="password" class="card-input-box" placeholder="123" maxlength="4" />
                                    </div>
                                </div>
                                <div class="form-control-wrap" style="margin-bottom: 4px;">
                                    <label class="form-label" style="font-size: 12.5px;">Name on Card</label>
                                    <input type="text" class="card-input-box" placeholder="<%= (user && user.name) ? user.name : 'Full Name' %>" />
                                </div>
                            </div>
                        </div>

                        <!-- 3. Net Banking -->
                        <div class="payment-option-card" onclick="selectPaymentMethod('netbanking', this)">
                            <input type="radio" name="paymentMethod" value="netbanking" class="real-payment-radio" />
                            <div class="payment-option-header">
                                <div class="option-main-left">
                                    <div class="custom-radio-circle">
                                        <div class="custom-radio-dot"></div>
                                    </div>
                                    <div class="option-titles-wrap">
                                        <span class="option-primary-title">Net Banking</span>
                                        <span class="option-sub-desc">Direct debit from 50+ trusted Indian banks</span>
                                    </div>
                                </div>
                                <div class="brand-badges-cluster">
                                    <span class="brand-pill-badge">All Indian Banks</span>
                                </div>
                            </div>
                            <div class="payment-details-body">
                                <label class="form-label" style="font-size: 12.5px; display: block; margin-bottom: 8px;">Popular Banks</label>
                                <div class="bank-fast-grid">
                                    <div class="bank-chip-btn active" onclick="selectBankChip('HDFC Bank', this)">HDFC</div>
                                    <div class="bank-chip-btn" onclick="selectBankChip('State Bank of India', this)">SBI</div>
                                    <div class="bank-chip-btn" onclick="selectBankChip('ICICI Bank', this)">ICICI</div>
                                    <div class="bank-chip-btn" onclick="selectBankChip('Axis Bank', this)">Axis</div>
                                </div>
                                <div class="form-control-wrap" style="margin-bottom: 4px;">
                                    <label class="form-label" style="font-size: 12.5px;">Or Choose Another Bank</label>
                                    <select class="card-input-box" id="bank-select-dropdown">
                                        <option value="HDFC Bank">HDFC Bank</option>
                                        <option value="State Bank of India">State Bank of India</option>
                                        <option value="ICICI Bank">ICICI Bank</option>
                                        <option value="Axis Bank">Axis Bank</option>
                                        <option value="Kotak Mahindra Bank">Kotak Mahindra Bank</option>
                                        <option value="Punjab National Bank">Punjab National Bank</option>
                                        <option value="Bank of Baroda">Bank of Baroda</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Pay on Arrival -->
                        <div class="payment-option-card" onclick="selectPaymentMethod('pay_on_arrival', this)">
                            <input type="radio" name="paymentMethod" value="pay_on_arrival" class="real-payment-radio" />
                            <div class="payment-option-header">
                                <div class="option-main-left">
                                    <div class="custom-radio-circle">
                                        <div class="custom-radio-dot"></div>
                                    </div>
                                    <div class="option-titles-wrap">
                                        <span class="option-primary-title">Pay at Property</span>
                                        <span class="option-sub-desc">Zero advance &bull; Pay cash, UPI or card at check-in</span>
                                    </div>
                                </div>
                                <div class="brand-badges-cluster">
                                    <span class="brand-pill-badge highlight-green">Pay on Check-in</span>
                                </div>
                            </div>
                            <div class="payment-details-body">
                                <div class="arrival-perks-box">
                                    <div class="arrival-perk-item">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#008A05" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span><strong>Instant Confirmation:</strong> Reservation is locked immediately without any payment today.</span>
                                    </div>
                                    <div class="arrival-perk-item">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#008A05" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span><strong>Flexible Settlement:</strong> Hand over cash or scan host's QR code during key handover.</span>
                                    </div>
                                    <div class="arrival-perk-item">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#008A05" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span><strong>Zero Cancellation Penalties:</strong> Free cancellation up to 48 hours before arrival.</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Redesigned Special Requests Box -->
                    <div class="special-note-card">
                        <div class="special-note-header">
                            <span class="special-note-title">Special requests or note to host</span>
                            <span style="font-size: 12px; color: var(--text-muted);">Optional</span>
                        </div>
                        <p class="special-note-sub">Let your host know about estimated arrival time, extra bedding, or travel questions.</p>
                        <textarea id="special-requests" name="specialRequests" class="special-note-textarea" placeholder="e.g. Arriving around 4:30 PM by cab, would appreciate parking assistance and quiet room..."></textarea>
                        
                        <!-- Tap-to-add Quick Suggestion Pills -->
                        <div class="special-suggestion-chips">
                            <span class="quick-suggest-pill" onclick="appendQuickNote('Early check-in around 1 PM requested')">Early Check-in</span>
                            <span class="quick-suggest-pill" onclick="appendQuickNote('Parking space needed for 1 vehicle')">Parking Needed</span>
                            <span class="quick-suggest-pill" onclick="appendQuickNote('Late arrival after 8 PM expected')">Late Arrival</span>
                            <span class="quick-suggest-pill" onclick="appendQuickNote('Extra pillows and linen please')">Extra Pillows</span>
                        </div>
                    </div>

                    <div class="section-separator" style="margin: 32px 0;"></div>

                    <!-- Cancellation & Ground Rules -->
                    <div>
                        <h2 class="pane-section-title">Cancellation policy</h2>
                        <div class="policy-item">
                            <div class="policy-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 14 14"></polyline>
                                </svg>
                            </div>
                            <div class="policy-text-wrap">
                                <h5>Free cancellation for 48 hours</h5>
                                <p>Cancel before <%= checkInFormatted %> for a full refund. After that, cancel before check-in and get a 50% refund, minus service fee.</p>
                            </div>
                        </div>
                    </div>

                    <div class="section-separator" style="margin: 32px 0;"></div>

                    <!-- Ground Rules -->
                    <div>
                        <h2 class="pane-section-title">Ground rules</h2>
                        <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 14px;">We ask every guest to remember a few simple things about what makes a great guest:</p>
                        <ul style="padding-left: 20px; font-size: 14px; color: #444444; line-height: 1.6;">
                            <li>Follow the house rules set by <%= home.hostName || 'the host' %></li>
                            <li>Treat the property as you would your own home</li>
                            <li>Observe quiet hours after 10:00 PM</li>
                        </ul>
                    </div>

                    <div class="section-separator" style="margin: 32px 0;"></div>

                    <!-- Submit Button -->
                    <button type="button" class="btn-confirm-pay" id="btn-submit-booking">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span id="btn-submit-booking-text">Confirm and Pay ₹<%= totalAmount.toLocaleString('en-IN') %></span>
                    </button>
                    <div id="payment-status-msg" style="display: none; margin-top: 10px; padding: 10px 14px; background: #FFF4E5; border: 1px solid #FFE2B8; border-radius: 8px; font-size: 13.5px; color: #9A5B00;"></div>

                    <p class="terms-subtext">
                        By selecting the button above, I agree to the Host's House Rules, Ground Rules for Guests, StayNest Rebooking and Refund Policy, and that StayNest can charge my payment method if I'm responsible for damage.
                    </p>
                </form>

            </div>

            <!-- RIGHT COLUMN: Sticky Property & Price Card -->
            <aside class="checkout-right-pane">
                <div class="summary-card">
                    
                    <div class="property-summary-header">
                        <div class="summary-thumb">
                            <img src="<%= propertyThumb %>" alt="<%= home.houseName %>" />
                        </div>
                        <div class="summary-property-info">
                            <span class="summary-property-type"><%= home.placeType || 'Entire accommodation' %> in <%= home.city || 'India' %></span>
                            <h3 class="summary-property-name"><%= home.houseName %></h3>
                            <div class="summary-property-rating">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="#222222">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                </svg>
                                <span>5.0</span>
                                <span style="color: var(--text-muted); font-weight: 400;">(19 reviews) &bull; Guest favourite</span>
                            </div>
                        </div>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #008A05;">
                            ✓ Protected by StayNest Host Guarantee
                        </span>
                    </div>

                    <!-- Price Details -->
                    <h4 style="font-size: 18px; font-weight: 600; margin-bottom: 16px;">Price details</h4>
                    
                    <div class="summary-breakdown-list">
                        <div class="summary-breakdown-row">
                            <span>₹<%= pricePerNight.toLocaleString('en-IN') %> x <%= totalNights %> <%= totalNights === 1 ? 'night' : 'nights' %></span>
                            <span>₹<%= subtotal.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="summary-breakdown-row">
                            <span>StayNest service fee</span>
                            <span>₹<%= serviceFee.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="summary-breakdown-row">
                            <span>Taxes & fees</span>
                            <span style="color: #008A05;">Included</span>
                        </div>
                        <div class="summary-breakdown-row total-row">
                            <span>Total (INR)</span>
                            <span>₹<%= totalAmount.toLocaleString('en-IN') %></span>
                        </div>
                    </div>

                    <div class="trust-badge-footer">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--emerald-mid); flex-shrink: 0;">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        <span>Your payment is secured with industry standard encryption. You will receive an instant booking voucher and invoice via email.</span>
                    </div>

                </div>
            </aside>

        </div>
    </main>

    <script>
        function selectPaymentMethod(method, element) {
            document.querySelectorAll('.payment-option-card').forEach(card => card.classList.remove('selected'));
            element.classList.add('selected');
            const radio = element.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
        }

        function appendVpa(suffix, event) {
            if (event) event.stopPropagation();
            const input = document.getElementById('upi-id');
            if (!input) return;
            const currentVal = input.value.trim();
            const atIndex = currentVal.indexOf('@');
            if (atIndex !== -1) {
                input.value = currentVal.substring(0, atIndex) + suffix;
            } else if (currentVal.length > 0) {
                input.value = currentVal + suffix;
            } else {
                input.value = 'guest' + suffix;
            }
            input.focus();
        }

        function selectBankChip(bankName, btn) {
            document.querySelectorAll('.bank-chip-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const dropdown = document.getElementById('bank-select-dropdown');
            if (dropdown) dropdown.value = bankName;
        }

        function appendQuickNote(noteText) {
            const textarea = document.getElementById('special-requests');
            if (!textarea) return;
            if (textarea.value.trim().length === 0) {
                textarea.value = noteText;
            } else {
                textarea.value = textarea.value.trim() + '. ' + noteText;
            }
            textarea.focus();
        }

        function setPaymentStatus(msg, isError = false) {
            const statusEl = document.getElementById('payment-status-msg');
            if (!statusEl) return;
            statusEl.style.display = 'block';
            statusEl.textContent = msg;
            if (isError) {
                statusEl.style.background = '#FFEEEE';
                statusEl.style.borderColor = '#FFCCCC';
                statusEl.style.color = '#C9002E';
            } else {
                statusEl.style.background = '#EBF2ED';
                statusEl.style.borderColor = '#C4D7CB';
                statusEl.style.color = '#143528';
            }
        }

        // Global Checkout Context Data (injected safely as JSON)
        let checkoutContext = {};
        try {
            const contextEl = document.getElementById('checkout-context-data');
            if (contextEl && contextEl.textContent) {
                checkoutContext = JSON.parse(contextEl.textContent);
            }
        } catch (e) {
            console.error("Failed to parse checkout context data", e);
        }

        let isPaymentProcessing = false;

        async function handlePayClick(e) {
            console.log("==> handlePayClick triggered");
            if (e) {
                if (typeof e.preventDefault === 'function') e.preventDefault();
                if (typeof e.stopPropagation === 'function') e.stopPropagation();
            }

            if (isPaymentProcessing) {
                console.warn("Payment already in progress, ignoring duplicate trigger.");
                return;
            }

            const selectedMethodRadio = document.querySelector('input[name="paymentMethod"]:checked');
            const selectedMethod = selectedMethodRadio ? selectedMethodRadio.value : 'razorpay';
            const btn = document.getElementById('btn-submit-booking');
            const bookingForm = document.getElementById('booking-payment-form');

            // If user selected "Pay at Property" (pay_on_arrival), submit standard form
            if (selectedMethod === 'pay_on_arrival') {
                isPaymentProcessing = true;
                if (btn) {
                    btn.innerHTML = '<span>Confirming reservation...</span>';
                    btn.style.opacity = '0.75';
                    btn.style.pointerEvents = 'none';
                }
                if (bookingForm) {
                    bookingForm.submit();
                }
                return;
            }

            // For all online payments (Razorpay, UPI, Card, Netbanking): process via Razorpay!
            isPaymentProcessing = true;
            setPaymentStatus("Connecting to Razorpay Secure Gateway...");
            if (btn) {
                btn.innerHTML = `
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="animation: spin 1s linear infinite;">
                        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                        <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
                    </svg>
                    <span>Opening Razorpay Secure Gateway...</span>
                `;
                btn.style.opacity = '0.85';
                btn.style.pointerEvents = 'none';
            }

            const restoreBtn = () => {
                isPaymentProcessing = false;
                if (btn) {
                    const formattedTotal = Number(checkoutContext.totalAmount || 0).toLocaleString('en-IN');
                    btn.innerHTML = `
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        <span>Confirm and Pay ₹${formattedTotal}</span>
                    `;
                    btn.style.opacity = '1';
                    btn.style.pointerEvents = 'auto';
                }
            };

            // Ensure Razorpay SDK is loaded
            if (typeof window.Razorpay === 'undefined') {
                try {
                    setPaymentStatus("Loading Razorpay SDK...");
                    await new Promise((resolve, reject) => {
                        const script = document.createElement('script');
                        script.src = 'https://checkout.razorpay.com/v1/checkout.js';
                        script.onload = resolve;
                        script.onerror = reject;
                        document.head.appendChild(script);
                    });
                } catch (loadErr) {
                    setPaymentStatus("Could not load Razorpay SDK. Please check your internet connection.", true);
                    restoreBtn();
                    return;
                }
            }

            try {
                setPaymentStatus("Creating payment order...");
                // 1. Create order on server
                const orderRes = await fetch('/api/payment/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        homeId: checkoutContext.homeId,
                        totalAmount: checkoutContext.totalAmount,
                        checkIn: checkoutContext.checkIn,
                        checkOut: checkoutContext.checkOut,
                        guests: checkoutContext.guests,
                        totalNights: checkoutContext.totalNights,
                        pricePerNight: checkoutContext.pricePerNight,
                        specialRequests: document.getElementById('special-requests') ? document.getElementById('special-requests').value : '',
                    })
                });

                const orderData = await orderRes.json();
                if (!orderData.success) {
                    throw new Error(orderData.message || "Failed to create Razorpay order");
                }

                setPaymentStatus("Order created (" + orderData.orderId + "). Opening checkout...");

                // 2. Open Razorpay Checkout modal
                const rzpOptions = {
                    key: orderData.keyId,
                    amount: orderData.amount,
                    currency: orderData.currency || "INR",
                    name: "StayNest",
                    description: "Reservation for " + (checkoutContext.houseName || 'Accommodation'),
                    order_id: orderData.orderId,
                    prefill: {
                        name: checkoutContext.userName || 'StayNest Guest',
                        email: checkoutContext.userEmail || 'guest@staynest.com',
                        contact: checkoutContext.userPhone || '9876543210'
                    },
                    notes: {
                        property: checkoutContext.houseName || 'StayNest Property',
                        checkIn: checkoutContext.checkIn || '',
                        checkOut: checkoutContext.checkOut || ''
                    },
                    theme: {
                        color: "#E8234A"
                    },
                    modal: {
                        ondismiss: function () {
                            setPaymentStatus("Payment window closed.");
                            restoreBtn();
                        }
                    },
                    handler: async function (response) {
                        setPaymentStatus("Verifying payment with StayNest...");
                        if (btn) {
                            btn.innerHTML = '<span>Verifying payment with StayNest...</span>';
                        }
                        try {
                            const verifyRes = await fetch('/api/payment/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    homeId: checkoutContext.homeId,
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,
                                    checkIn: checkoutContext.checkIn,
                                    checkOut: checkoutContext.checkOut,
                                    guests: checkoutContext.guests,
                                    totalNights: checkoutContext.totalNights,
                                    pricePerNight: checkoutContext.pricePerNight,
                                    totalAmount: checkoutContext.totalAmount,
                                    paymentMethod: selectedMethod || "razorpay",
                                    specialRequests: document.getElementById('special-requests') ? document.getElementById('special-requests').value : ''
                                })
                            });

                            const verifyData = await verifyRes.json();
                            if (verifyData.success) {
                                setPaymentStatus("Payment confirmed! Redirecting to bookings...");
                                window.location.href = verifyData.redirectUrl || '/bookings?booked=true';
                            } else {
                                setPaymentStatus("Payment verification failed: " + (verifyData.message || "Invalid signature"), true);
                                alert(verifyData.message || "Payment verification failed.");
                                restoreBtn();
                            }
                        } catch (err) {
                            console.error("Verification error:", err);
                            setPaymentStatus("Payment recorded! Redirecting to bookings...");
                            window.location.href = '/bookings?booked=true';
                        }
                    }
                };

                const rzp = new window.Razorpay(rzpOptions);
                rzp.on('payment.failed', function (response) {
                    const failMsg = response.error ? (response.error.description || response.error.reason) : "Payment was cancelled or failed.";
                    setPaymentStatus("Payment failed: " + failMsg, true);
                    alert("Payment could not be completed: " + failMsg);
                    restoreBtn();
                });
                rzp.open();
            } catch (err) {
                console.error("Payment initialization error:", err);
                setPaymentStatus("Could not initialize gateway: " + err.message, true);
                alert("Could not initialize Razorpay gateway: " + err.message);
                restoreBtn();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('btn-submit-booking');
            if (btn) {
                btn.addEventListener('click', handlePayClick);
            }
            const form = document.getElementById('booking-payment-form');
            if (form) {
                form.addEventListener('submit', handlePayClick);
            }
        });
    </script>

    <!-- Global Checkout JSON Context -->
    <script id="checkout-context-data" type="application/json">
        <%- JSON.stringify({
            homeId: String(homeId),
            houseName: houseTitle,
            totalAmount: totalAmount,
            pricePerNight: pricePerNight,
            totalNights: totalNights,
            checkIn: checkIn || '',
            checkOut: checkOut || '',
            guests: guests || 1,
            userName: guestName,
            userEmail: guestEmail,
            userPhone: guestPhone,
            razorpayKeyId: rzpKey
        }) %>
    </script>

    <!-- Global Luxury Footer -->
    <%- include("../partials/03_footer.ejs") %>
</body>
</html>
  