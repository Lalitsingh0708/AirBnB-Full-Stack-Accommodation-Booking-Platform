<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Bookings &bull; StayNest</title>
    <meta name="description" content="View and manage your upcoming reservations and booked stays on StayNest." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,400;1,500;1,600&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg-beige: #FAF7F0;
            --surface-card: #FFFFFF;
            --emerald-dark: #0f261b;
            --emerald-mid: #143528;
            --gold-accent: #D4AF6A;
            --text-dark: #121A16;
            --text-muted: #6B7770;
            --border-light: #E8E2D5;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-beige);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .hero-banner-wrap {
            max-width: 1320px;
            margin: 24px auto 0 auto;
            padding: 0 20px;
            width: 100%;
        }

        .hero-banner {
            background: radial-gradient(ellipse 110% 100% at 75% 20%, #1D4333 0%, #132E22 55%, #0B1C14 100%);
            border-radius: 28px;
            padding: 44px 44px;
            color: #FFFFFF;
            box-shadow: 0 20px 50px -15px rgba(11, 28, 20, 0.45);
        }

        .hero-eyebrow {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--gold-accent);
            margin-bottom: 10px;
        }

        .hero-headline {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 38px;
            font-weight: 500;
            line-height: 1.18;
            margin-bottom: 10px;
        }

        .hero-headline em {
            font-style: italic;
            color: var(--gold-accent);
        }

        .hero-sub {
            font-size: 14.5px;
            color: rgba(255, 255, 255, 0.72);
            max-width: 520px;
            line-height: 1.6;
        }

        .bookings-container {
            max-width: 1320px;
            margin: 28px auto 48px auto;
            padding: 0 20px;
            width: 100%;
        }

        .empty-bookings-box {
            text-align: center;
            padding: 80px 24px;
            background: var(--surface-card);
            border-radius: 24px;
            border: 1px solid var(--border-light);
            max-width: 580px;
            margin: 40px auto;
        }

        .empty-icon-circle {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #EBF2ED;
            color: var(--emerald-mid);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
        }

        .empty-title {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .empty-desc {
            font-size: 14.5px;
            color: var(--text-muted);
            margin-bottom: 24px;
            line-height: 1.6;
        }

        .btn-action-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 28px;
            background: var(--emerald-mid);
            color: #FFFFFF;
            text-decoration: none;
            border-radius: 9999px;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(20, 53, 40, 0.25);
            transition: all 0.2s ease;
        }

        .btn-action-primary:hover {
            background: #0B1C14;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <%- include("../partials/01_header.ejs") %>

    <section class="hero-banner-wrap">
        <div class="hero-banner">
            <p class="hero-eyebrow">Trip Management &bull; StayNest</p>
            <h1 class="hero-headline">My <em>bookings.</em></h1>
            <p class="hero-sub">Keep track of your confirmed check-ins, reservations, and upcoming journeys.</p>
        </div>
    </section>

    <main class="bookings-container">
        <div class="empty-bookings-box">
            <div class="empty-icon-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h2 class="empty-title">No upcoming trips booked</h2>
            <p class="empty-desc">Time to dust off your bags and plan your next peaceful retreat or weekend getaway.</p>
            <a href="/" class="btn-action-primary">Explore Stays</a>
        </div>
    </main>
</body>
</html>