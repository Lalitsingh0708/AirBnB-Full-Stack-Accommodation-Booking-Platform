<form action="/favourite" method="POST" class="fav-action-form" style="margin: 0;">
    <button type="submit" class="btn-fav-toggle" title="Save to Favourites" aria-label="Save to Favourites">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
    </button>
    <input type="hidden" name="id" value="<%= home.id %>" />
</form>

<style>
    .btn-fav-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #FAF7F0;
        border: 1.5px solid #D8D2C4;
        color: #122B20;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
        padding: 0;
    }

    .btn-fav-toggle:hover {
        background: #143528;
        border-color: #143528;
        color: #D4AF6A;
        transform: scale(1.08);
        box-shadow: 0 4px 12px rgba(20, 53, 40, 0.25);
    }

    .btn-fav-toggle:active {
        transform: scale(0.95);
    }
</style>