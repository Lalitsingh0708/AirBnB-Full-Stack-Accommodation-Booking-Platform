        .mode-tab-item {
            font-size: 13.5px;
        }

        .floating-search-pill {
            max-width: 100%;
        }
    }

    @media (max-width: 768px) {
        .header-main-row {
            padding: 10px 16px;
        }

        .center-mode-nav {
            display: none;
        }

        .host-cta-pill {
            display: none;
        }

        .header-search-bar-row {
            padding: 0 16px 12px 16px;
        }

        .floating-search-pill {
            padding: 6px 8px 6px 14px;
        }

        .search-segment-divider {
            display: none;
        }

        .destination-suggestions-popup {
            position: fixed;
            top: 130px;
            left: 12px;
            right: 12px;
            width: auto;
            max-width: none;
            border-radius: 24px;
            padding: 18px 14px;
        }

        .when-datepicker-popup {
            position: fixed;
            top: 130px;
            left: 8px;
            right: 8px;
            width: auto;
            max-width: none;
            transform: none;
            border-radius: 24px;
            padding: 20px 14px;
            max-height: 80vh;
            overflow-y: auto;
        }

        .dual-calendars-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .cal-month-title#month-title-2 {
            display: none;
        }

        .single-month-cal:nth-child(2) {
            display: none;
        }

        .calendars-nav-row {
            grid-template-columns: 40px 1fr 40px;
        }

        .btn-search-text {
            display: none;
        }

        .btn-search-pill {
            padding: 12px 14px;
            border-radius: 50%;
        }

        .who-guests-popup {
            position: fixed;
            top: 130px;
            left: 10px;
            right: 10px;
            width: auto;
            max-width: none;
            border-radius: 24px;
            padding: 20px 18px;
        }
    }
</style>

<!-- ═══════════════════════════════════════════════════════════
     INTERACTIVE JAVASCRIPT FOR NAVBAR & SEARCH
═══════════════════════════════════════════════════════════ -->
<script>
    (function () {
        // Dropdown toggle
        const trigger = document.getElementById('profile-pill-trigger');
        const dropdown = document.getElementById('profile-dropdown-menu');
        const container = document.getElementById('profile-menu-container');

        if (trigger && dropdown && container) {
            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                const isOpen = dropdown.classList.toggle('is-open');
                trigger.setAttribute('aria-expanded', isOpen);
            });

            document.addEventListener('click', function (e) {
                if (!container.contains(e.target)) {
                    dropdown.classList.remove('is-open');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    dropdown.classList.remove('is-open');
                    trigger.setAttribute('aria-expanded', 'false');
                }
            });
        }

        // Close popups when clicking outside
        document.addEventListener('click', function (e) {
            const segWhere = document.getElementById('segment-where');
            const wherePopup = document.getElementById('where-suggestions-popup');
            if (segWhere && wherePopup && !segWhere.contains(e.target)) {
                closeWhereSuggestions();
            }

            const segWhen = document.getElementById('segment-when');
            const whenPopup = document.getElementById('when-datepicker-popup');
            if (segWhen && whenPopup && !segWhen.contains(e.target) && !whenPopup.contains(e.target)) {
                closeWhenDatepicker();
            }

            const segWho = document.getElementById('segment-who');
            const whoPopup = document.getElementById('who-guests-popup');
            if (segWho && whoPopup && !segWho.contains(e.target) && !whoPopup.contains(e.target)) {
                closeWhoPopup();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeWhereSuggestions();
                closeWhenDatepicker();
                closeWhoPopup();
            }
        });
    })();

    function focusSearchField(id) {
        const el = document.getElementById(id);
        if (el) el.focus();
    }

    /* ── Where Destination Suggestions Popover Logic ── */
    function handleWhereBoxClick(e) {
        closeWhenDatepicker();
        openWhereSuggestions(e);
        const input = document.getElementById('input-dest');
        if (input && document.activeElement !== input) {
            input.focus();
        }
    }

    function openWhereSuggestions(e) {
        if (e) e.stopPropagation();
        closeWhenDatepicker();
        closeWhoPopup();
        const popup = document.getElementById('where-suggestions-popup');
        const segWhere = document.getElementById('segment-where');
        if (popup) popup.classList.add('is-open');
        if (segWhere) segWhere.classList.add('is-active');
    }

    function closeWhereSuggestions() {
        const popup = document.getElementById('where-suggestions-popup');
        const segWhere = document.getElementById('segment-where');
        if (popup) popup.classList.remove('is-open');
        if (segWhere) segWhere.classList.remove('is-active');
    }

    function handleWhereInput(val) {
        openWhereSuggestions();
        if (typeof filterListings === 'function') {
            filterListings(val);
        }
        const q = (val || '').toLowerCase().trim();
        const items = document.querySelectorAll('.suggestion-item:not(.suggestion-item--nearby)');
        items.forEach(item => {
            const text = item.textContent.toLowerCase();
            if (!q || text.includes(q)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function selectDestinationOption(destName, e) {
        if (e) e.stopPropagation();
        const input = document.getElementById('input-dest');
        if (input) {
            input.value = destName;
        }
        closeWhereSuggestions();
        if (typeof filterListings === 'function') {
            filterListings(destName);
        } else {
            const form = document.getElementById('global-search-form');
            if (form) form.submit();
        }
    }

    /* ── Live Geolocation / Nearby Detection ── */
    async function detectLiveUserLocation(e) {
        if (e) e.stopPropagation();
        const sub = document.getElementById('nearby-subtitle');
        const iconWrap = document.getElementById('nearby-icon-wrap');

        if (sub) sub.innerHTML = '<span style="color: #1E6BE6; font-weight: 600;">⟳ Detecting live GPS location...</span>';
        if (iconWrap) iconWrap.classList.add('pulse-loc');

        if ('geolocation' in navigator) {
            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    const { latitude, longitude } = position.coords;
                    try {
                        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`, {
                            headers: { 'Accept-Language': 'en' }
                        });
                        const data = await res.json();
                        const addr = data.address || {};
                        const detectedCity = addr.city || addr.town || addr.village || addr.suburb || addr.state_district || addr.state || 'Nearby';
                        
                        if (sub) sub.innerHTML = `<span style="color: #166534; font-weight: 600;">✓ Live: ${detectedCity}</span>`;
                        setTimeout(() => {
                            selectDestinationOption(detectedCity);
                        }, 400);
                    } catch (err) {
                        console.warn("Reverse geocode failed, using IP fallback:", err);
                        await fallbackIpLocation(sub, iconWrap);
                    } finally {
                        if (iconWrap) iconWrap.classList.remove('pulse-loc');
                    }
                },
                async (err) => {
                    console.warn("Geolocation permission or timeout, trying IP fallback:", err.message);
                    await fallbackIpLocation(sub, iconWrap);
                },
                { timeout: 7000, enableHighAccuracy: true }
            );
        } else {
            await fallbackIpLocation(sub, iconWrap);
        }
    }

    async function fallbackIpLocation(sub, iconWrap) {
        try {
            const res = await fetch('https://ipapi.co/json/');
            const data = await res.json();
            if (data && (data.city || data.region)) {
                const locName = data.city || data.region;
                if (sub) sub.innerHTML = `<span style="color: #166534; font-weight: 600;">✓ Live: ${locName}</span>`;
                setTimeout(() => {
                    selectDestinationOption(locName);
                }, 400);
                return;
            }
        } catch (e) {
            console.warn("IP fallback failed:", e);
        }
        if (iconWrap) iconWrap.classList.remove('pulse-loc');
        if (sub) sub.textContent = "Location unavailable • Showing top sanctuaries";
        setTimeout(() => {
            selectDestinationOption('Manali');
        }, 500);
    }

    /* ═══════════════════════════════════════════════════════════
       WHEN DATEPICKER & FLEXIBLE MODAL LOGIC (Airbnb Match)
    ═══════════════════════════════════════════════════════════ */
    let currentViewDate = new Date(2026, 9, 1); // Current environment date: October 2026
    let selectedCheckIn = null;
    let selectedCheckOut = null;
    let flexDuration = 'Weekend';
    let selectedFlexMonths = ['October 2026'];
    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    const shortMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    function handleWhenBoxClick(e) {
        if (e) e.stopPropagation();
        closeWhereSuggestions();
        closeWhoPopup();
        const popup = document.getElementById('when-datepicker-popup');
        const segWhen = document.getElementById('segment-when');
        if (popup) popup.classList.add('is-open');
        if (segWhen) segWhen.classList.add('is-active');
        renderDualCalendars();
    }

    function closeWhenDatepicker() {
        const popup = document.getElementById('when-datepicker-popup');
        const segWhen = document.getElementById('segment-when');
        if (popup) popup.classList.remove('is-open');
        if (segWhen) segWhen.classList.remove('is-active');
    }

    function switchWhenTab(tabName, e) {
        if (e) e.stopPropagation();
        const btnDates = document.getElementById('tab-btn-dates');
        const btnFlex = document.getElementById('tab-btn-flexible');
        const viewDates = document.getElementById('view-dates-content');
        const viewFlex = document.getElementById('view-flexible-content');

        if (tabName === 'dates') {
            btnDates.classList.add('active');
            btnFlex.classList.remove('active');
            viewDates.style.display = 'block';
            viewFlex.style.display = 'none';
            renderDualCalendars();
        } else {
            btnFlex.classList.add('active');
            btnDates.classList.remove('active');
            viewFlex.style.display = 'block';
            viewDates.style.display = 'none';
        }
    }

    function renderDualCalendars() {
        const month1 = new Date(currentViewDate.getFullYear(), currentViewDate.getMonth(), 1);
        const month2 = new Date(currentViewDate.getFullYear(), currentViewDate.getMonth() + 1, 1);

        const title1 = document.getElementById('month-title-1');
        const title2 = document.getElementById('month-title-2');
        if (title1) title1.textContent = `${monthNames[month1.getMonth()]} ${month1.getFullYear()}`;
        if (title2) title2.textContent = `${monthNames[month2.getMonth()]} ${month2.getFullYear()}`;

        renderSingleMonthGrid(month1, 'days-grid-1');
        renderSingleMonthGrid(month2, 'days-grid-2');
    }

    function renderSingleMonthGrid(monthDate, containerId) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.innerHTML = '';

        const year = monthDate.getFullYear();
        const month = monthDate.getMonth();
        const firstDayIndex = new Date(year, month, 1).getDay();
        const totalDays = new Date(year, month + 1, 0).getDate();

        const today = new Date(2026, 9, 17);
        today.setHours(0, 0, 0, 0);

        for (let i = 0; i < firstDayIndex; i++) {
            const emptyCell = document.createElement('div');
            emptyCell.className = 'cal-day-cell is-empty';
            container.appendChild(emptyCell);
        }

        for (let day = 1; day <= totalDays; day++) {
            const cellDate = new Date(year, month, day);
            cellDate.setHours(0, 0, 0, 0);

            const dayBtn = document.createElement('button');
            dayBtn.type = 'button';
            dayBtn.className = 'cal-day-cell cal-day-btn';
            dayBtn.textContent = day;

            const isPast = cellDate < today;
            if (isPast) {
                dayBtn.classList.add('is-disabled');
                dayBtn.disabled = true;
            } else {
                if (selectedCheckIn && isSameDate(cellDate, selectedCheckIn)) {
                    dayBtn.classList.add('is-checkin');
                    if (selectedCheckOut) dayBtn.classList.add('has-range');
                }
                if (selectedCheckOut && isSameDate(cellDate, selectedCheckOut)) {
                    dayBtn.classList.add('is-checkout');
                    dayBtn.classList.add('has-range');
                }
                if (selectedCheckIn && selectedCheckOut && cellDate > selectedCheckIn && cellDate < selectedCheckOut) {
                    dayBtn.classList.add('in-range');
                }

                dayBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    handleDateClick(cellDate);
                });
            }

            container.appendChild(dayBtn);
        }
    }

    function isSameDate(d1, d2) {
        return d1.getFullYear() === d2.getFullYear() &&
               d1.getMonth() === d2.getMonth() &&
               d1.getDate() === d2.getDate();
    }

    function handleDateClick(date) {
        if (!selectedCheckIn || (selectedCheckIn && selectedCheckOut)) {
            selectedCheckIn = date;
            selectedCheckOut = null;
        } else if (selectedCheckIn && !selectedCheckOut) {
            if (date < selectedCheckIn) {
                selectedCheckIn = date;
            } else {
                selectedCheckOut = date;
            }
        }
        updateExactBoxes();
        updateWhenInput();
        renderDualCalendars();
    }

    function updateExactBoxes() {
        const checkinBox = document.getElementById('exact-checkin-val');
        const checkoutBox = document.getElementById('exact-checkout-val');
        if (checkinBox) {
            checkinBox.textContent = selectedCheckIn ? `${selectedCheckIn.getDate()} ${shortMonths[selectedCheckIn.getMonth()]} ${selectedCheckIn.getFullYear()}` : 'Exact date';
        }
        if (checkoutBox) {
            checkoutBox.textContent = selectedCheckOut ? `${selectedCheckOut.getDate()} ${shortMonths[selectedCheckOut.getMonth()]} ${selectedCheckOut.getFullYear()}` : 'Exact date';
        }
    }

    function updateWhenInput() {
        const input = document.getElementById('input-checkin');
        const hiddenIn = document.getElementById('hidden-checkin');
        const hiddenOut = document.getElementById('hidden-checkout');
        if (!input) return;

        if (selectedCheckIn && selectedCheckOut) {
            input.value = `${selectedCheckIn.getDate()} ${shortMonths[selectedCheckIn.getMonth()]} – ${selectedCheckOut.getDate()} ${shortMonths[selectedCheckOut.getMonth()]}`;
            if (hiddenIn) hiddenIn.value = selectedCheckIn.toISOString();
            if (hiddenOut) hiddenOut.value = selectedCheckOut.toISOString();
        } else if (selectedCheckIn) {
            input.value = `${selectedCheckIn.getDate()} ${shortMonths[selectedCheckIn.getMonth()]} – Add checkout`;
            if (hiddenIn) hiddenIn.value = selectedCheckIn.toISOString();
        } else {
            input.value = '';
        }
    }

    function prevMonthNav(e) {
        if (e) e.stopPropagation();
        const minDate = new Date(2026, 9, 1);
        const prev = new Date(currentViewDate.getFullYear(), currentViewDate.getMonth() - 1, 1);
        if (prev >= minDate) {
            currentViewDate = prev;
            renderDualCalendars();
        }
    }

    function nextMonthNav(e) {
        if (e) e.stopPropagation();
        currentViewDate = new Date(currentViewDate.getFullYear(), currentViewDate.getMonth() + 1, 1);
        renderDualCalendars();
    }

    function toggleExactDateOptions(type, e) {
        if (e) e.stopPropagation();
        const box = type === 'checkin' ? document.getElementById('exact-checkin-val') : document.getElementById('exact-checkout-val');
        if (!box) return;
        const options = ['Exact date', '± 1 day', '± 2 days', '± 3 days', '± 7 days'];
        const current = box.textContent;
        const idx = options.indexOf(current);
        const next = (idx + 1) % options.length;
        box.textContent = options[next];
    }

    /* ── Flexible Tab Logic (Screenshot 2) ── */
    function selectFlexDuration(dur, btn, e) {
        if (e) e.stopPropagation();
        document.querySelectorAll('.duration-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        flexDuration = dur;
        updateFlexibleWhenInput();
    }

    function toggleFlexMonth(card, monthYear, e) {
        if (e) e.stopPropagation();
        document.querySelectorAll('.flex-month-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        selectedFlexMonths = [monthYear];
        updateFlexibleWhenInput();
    }

    function updateFlexibleWhenInput() {
        const input = document.getElementById('input-checkin');
        if (!input) return;
        const month = selectedFlexMonths[0] ? selectedFlexMonths[0].split(' ')[0] : 'Anytime';
        input.value = `${flexDuration} in ${month}`;
    }

    function scrollFlexCarousel(dir, e) {
        if (e) e.stopPropagation();
        const track = document.getElementById('flex-months-track');
        if (track) {
            track.scrollBy({ left: dir * 220, behavior: 'smooth' });
        }
    }

    /* ═══════════════════════════════════════════════════════════
       WHO GUESTS POPUP & STEPPER COUNTER LOGIC (Airbnb Match)
    ═══════════════════════════════════════════════════════════ */
    let guestCounts = { adults: 0, children: 0, infants: 0, pets: 0 };

    function handleWhoBoxClick(e) {
        if (e) e.stopPropagation();
        closeWhereSuggestions();
        closeWhenDatepicker();
        const popup = document.getElementById('who-guests-popup');
        if (popup && popup.classList.contains('is-open')) {
            closeWhoPopup();
        } else {
            openWhoPopup(e);
        }
    }

    function openWhoPopup(e) {
        if (e) e.stopPropagation();
        closeWhereSuggestions();
        closeWhenDatepicker();
        const popup = document.getElementById('who-guests-popup');
        const segWho = document.getElementById('segment-who');
        if (popup) popup.classList.add('is-open');
        if (segWho) segWho.classList.add('is-active');
    }

    function closeWhoPopup() {
        const popup = document.getElementById('who-guests-popup');
        const segWho = document.getElementById('segment-who');
        if (popup) popup.classList.remove('is-open');
        if (segWho) segWho.classList.remove('is-active');
    }

    function updateGuestCount(type, delta, e) {
        if (e) e.stopPropagation();

        // If adding children/infants/pets when adults is 0, auto-set adults to 1 (Airbnb behavior)
        if (type !== 'adults' && delta > 0 && guestCounts.adults === 0) {
            guestCounts.adults = 1;
        }

        guestCounts[type] = Math.max(0, guestCounts[type] + delta);

        // If adults becomes 0, reset children to 0 as well
        if (type === 'adults' && guestCounts.adults === 0) {
            guestCounts.children = 0;
        }

        renderGuestCountsUI();
    }

    function renderGuestCountsUI() {
        ['adults', 'children', 'infants', 'pets'].forEach(t => {
            const numEl = document.getElementById('count-' + t);
            const decBtn = document.getElementById('btn-dec-' + t);
            if (numEl) numEl.textContent = guestCounts[t];
            if (decBtn) {
                decBtn.disabled = (guestCounts[t] === 0);
                decBtn.classList.toggle('is-disabled', guestCounts[t] === 0);
            }
        });

        // Update inputs
        const totalGuests = guestCounts.adults + guestCounts.children;
        const displayInput = document.getElementById('who-display-input');
        const hiddenInput = document.getElementById('hidden-guests-val');

        let summary = '';
        if (totalGuests > 0) {
            summary = totalGuests === 1 ? '1 guest' : `${totalGuests} guests`;
            if (guestCounts.infants > 0) {
                summary += `, ${guestCounts.infants} infant${guestCounts.infants > 1 ? 's' : ''}`;
            }
            if (guestCounts.pets > 0) {
                summary += `, ${guestCounts.pets} pet${guestCounts.pets > 1 ? 's' : ''}`;
            }
        }

        if (displayInput) {
            displayInput.value = summary;
        }
        if (hiddenInput) {
            hiddenInput.value = totalGuests > 0 ? totalGuests : '';
        }
    }

    function initGuestCountsFromQuery() {
        const hiddenInput = document.getElementById('hidden-guests-val');
        if (hiddenInput && hiddenInput.value) {
            const count = parseInt(hiddenInput.value, 10);
            if (!isNaN(count) && count > 0) {
                guestCounts.adults = count;
                renderGuestCountsUI();
            }
        }
    }

    function toggleSearchExpansion(e) {
        if (e) e.stopPropagation();
        const row = document.getElementById('header-search-bar-row');
        if (row) {
            if (row.classList.contains('search-bar-row--collapsed')) {
                row.classList.remove('search-bar-row--collapsed');
                row.classList.add('search-bar-row--expanded');
                setTimeout(() => {
                    const inp = document.getElementById('input-dest');
                    if (inp) inp.focus();
                }, 60);
            } else {
                row.classList.add('search-bar-row--collapsed');
                row.classList.remove('search-bar-row--expanded');
            }
        }
    }

    // Initialize calendar and guests on load
    document.addEventListener('DOMContentLoaded', function () {
        renderDualCalendars();
        initGuestCountsFromQuery();
    });
</script>