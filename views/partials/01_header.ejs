    /* ═══════════════════════════════════════════════════════════
       WHEN DATEPICKER POPUP MODAL (Exact Match to Airbnb Screenshots)
    ═══════════════════════════════════════════════════════════ */
    .when-datepicker-popup {
        position: absolute;
        top: calc(100% + 14px);
        left: 50%;
        transform: translate(-50%, 0);
        width: 840px;
        max-width: 96vw;
        background: #FFFFFF;
        border-radius: 32px;
        box-shadow: 0 16px 44px rgba(0, 0, 0, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.06);
        padding: 28px 36px 24px 36px;
        z-index: 9999;
        display: none;
        cursor: default;
        text-align: left;
        box-sizing: border-box;
    }

    .when-datepicker-popup.is-open {
        display: block;
        animation: popupFadeSlideCenter 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes popupFadeSlideCenter {
        from {
            opacity: 0;
            transform: translate(-50%, -8px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translate(-50%, 0) scale(1);
        }
    }

    /* Tab Switcher: [ Dates ] [ Flexible ] */
    .when-tab-pill-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 24px;
    }

    .when-tab-pill {
        display: inline-flex;
        background: #EBEBEB;
        padding: 4px;
        border-radius: 9999px;
    }

    .when-tab-btn {
        border: none;
        background: transparent;
        padding: 8px 24px;
        border-radius: 9999px;
        font-size: 14px;
        font-weight: 600;
        color: #222222;
        cursor: pointer;
        transition: all 0.16s ease;
    }

    .when-tab-btn.active {
        background: #FFFFFF;
        color: #222222;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }

    /* ── Dates View: Dual Calendars ── */
    .calendars-nav-row {
        display: grid;
        grid-template-columns: 40px 1fr 1fr 40px;
        align-items: center;
        margin-bottom: 16px;
    }

    .cal-nav-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #222222;
        transition: background 0.14s ease, border-color 0.14s ease;
    }

    .cal-nav-btn:hover {
        background: #F2F2F2;
        border-color: #E0E0E0;
    }

    .cal-month-title {
        font-size: 16px;
        font-weight: 700;
        color: #222222;
        text-align: center;
        letter-spacing: -0.2px;
    }

    .dual-calendars-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 36px;
    }

    .single-month-cal {
        display: flex;
        flex-direction: column;
    }

    .cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        color: #717171;
        margin-bottom: 12px;
    }

    .cal-days-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        row-gap: 4px;
    }

    .cal-day-cell {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 600;
        color: #222222;
        border: none;
        background: transparent;
        cursor: pointer;
        position: relative;
        border-radius: 50%;
        margin: 2px;
        transition: all 0.14s ease;
    }

    .cal-day-cell.is-empty {
        cursor: default;
    }

    .cal-day-cell.is-disabled {
        color: #DDDDDD;
        cursor: not-allowed;
        text-decoration: none;
    }

    .cal-day-cell:not(.is-disabled):not(.is-empty):hover {
        border: 1.5px solid #222222;
    }

    /* Selected Check-in & Check-out (Screenshot 1) */
    .cal-day-cell.is-checkin,
    .cal-day-cell.is-checkout {
        background: #222222 !important;
        color: #FFFFFF !important;
        border-radius: 50% !important;
        font-weight: 700;
    }

    /* In-range highlight */
    .cal-day-cell.in-range {
        background: #F4F0E8 !important; /* luxury warm cream highlight */
        border-radius: 0 !important;
        color: #143528 !important;
    }

    .cal-day-cell.is-checkin.has-range {
        border-top-right-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
    }

    .cal-day-cell.is-checkout.has-range {
        border-top-left-radius: 0 !important;
        border-bottom-left-radius: 0 !important;
    }

