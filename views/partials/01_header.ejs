    /* ═══════════════════════════════════════════════════════════
       WHO GUESTS POPUP (Exact Match to Airbnb Screenshot)
    ═══════════════════════════════════════════════════════════ */
    .who-guests-popup {
        position: absolute;
        top: calc(100% + 14px);
        right: 0;
        width: 410px;
        max-width: 94vw;
        background: #FFFFFF;
