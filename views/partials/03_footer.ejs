<!-- ═══════════════════════════════════════════════════════════
     FOOTER STYLES (Scoped, Responsive, Ultra-Clean Airbnb Architecture)
═══════════════════════════════════════════════════════════ -->
<style>
    .staynest-global-footer {
        background-color: #F7F7F7;
        border-top: 1px solid #EBEBEB;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #222222;
        width: 100%;
        margin-top: 60px;
        box-sizing: border-box;
    }

    .footer-container {
        max-width: 1360px;
        margin: 0 auto;
        padding: 0 28px;
        box-sizing: border-box;
    }

    /* ── 1. Inspiration Section ── */
    .footer-inspiration-section {
        padding: 44px 0 36px 0;
        border-bottom: 1px solid #EBEBEB;
    }

    .inspiration-main-heading {
        font-size: 20px;
        font-weight: 700;
        color: #111111;
        letter-spacing: -0.4px;
        margin: 0 0 18px 0;
    }

    .inspiration-tabs-scroll {
        display: flex;
        gap: 8px;
        border-bottom: 1px solid #DDDDDD;
        overflow-x: auto;
        padding-bottom: 2px;
        scrollbar-width: none;
    }

    .inspiration-tabs-scroll::-webkit-scrollbar {
        display: none;
    }

    .inspire-tab {
        background: transparent;
        border: none;
        padding: 10px 14px;
        font-size: 14px;
        font-weight: 500;
        color: #6A6A6A;
        cursor: pointer;
        position: relative;
        white-space: nowrap;
        transition: color 0.16s ease;
    }

    .inspire-tab:hover {
        color: #111111;
    }

    .inspire-tab.active {
        color: #111111;
        font-weight: 600;
    }

    .inspire-tab.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2.5px;
        background: #111111;
        border-radius: 2px;
    }

    .destination-links-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px 24px;
        margin-top: 26px;
    }

    .dest-link-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
        text-decoration: none;
        transition: transform 0.14s ease;
    }

    .dest-link-item:hover .dest-link-title {
        color: #0B1C14;
        text-decoration: underline;
    }

    .dest-link-title {
        font-size: 14px;
        font-weight: 600;
        color: #222222;
        letter-spacing: -0.15px;
    }

    .dest-link-subtitle {
        font-size: 13px;
        font-weight: 400;
        color: #717171;
    }

    /* ── 2. Directory Columns ── */
    .footer-directory-section {
        padding: 44px 0;
        border-bottom: 1px solid #EBEBEB;
    }

    .footer-columns-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1.25fr;
        gap: 36px;
    }

    .footer-col {
        display: flex;
        flex-direction: column;
    }

    .footer-col-title {
        font-size: 14.5px;
        font-weight: 700;
        color: #111111;
        letter-spacing: -0.2px;
        margin: 0 0 16px 0;
    }

    .footer-links-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-link {
        text-decoration: none;
        color: #484848;
        font-size: 13.5px;
        font-weight: 400;
        line-height: 1.4;
        transition: color 0.14s ease, text-decoration 0.14s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

