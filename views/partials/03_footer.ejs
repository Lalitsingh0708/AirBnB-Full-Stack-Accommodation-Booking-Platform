<script>
    function switchInspirationTab(tabName, btn) {
        document.querySelectorAll('.inspire-tab').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        document.querySelectorAll('.inspiration-grid-content').forEach(content => {
            content.style.display = 'none';
            content.classList.remove('active');
        });

        const target = document.getElementById('tab-content-' + tabName);
        if (target) {
            target.style.display = 'block';
            target.classList.add('active');
        }
    }

    function scrollToPageTop() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    }
</script>
